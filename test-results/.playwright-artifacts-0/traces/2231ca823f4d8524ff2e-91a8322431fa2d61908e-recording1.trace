d var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.billing-month-registry__archive-card-meta {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.billing-month-registry__archive-card-meta strong {\n  font-size: var(--dl-font-size-section-title);\n  text-transform: capitalize;\n}\n\n.billing-month-registry__archive-card-meta span,\n.billing-month-registry__archive-card-meta small,\n.billing-month-registry__empty-archive {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-month-registry__archive-card-summary {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.billing-archive-page {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.billing-archive-page__detail-shell {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__tab-toolbar.billing-archive-page__header--detail {\n  align-items: start;\n  background: var(--dl-color-surface, #fff);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  padding: var(--dl-space-4);\n}\n\n.billing-archive-page__detail-heading {\n  display: grid;\n  gap: var(--dl-space-2);\n  justify-items: start;\n}\n\n.billing-archive-page__detail-heading h1,\n.billing-archive-page__detail-heading p {\n  margin: 0;\n}\n\n.billing-archive-page__detail-heading .billing-archive-page__eyebrow {\n  color: var(--dl-color-primary, #0f766e);\n  font-size: var(--dl-font-size-caption);\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.billing-archive-page__header {\n  align-items: end;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);\n}\n\n.billing-archive-page__header h1 {\n  font-size: var(--dl-font-size-page-title);\n}\n\n.billing-archive-page__header h2 {\n  font-size: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.billing-archive-page__header p,\n.billing-archive-page__company span,\n.bil