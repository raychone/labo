attachment-title strong {\n  margin: 0;\n}\n\n.billing-print__attachment-title {\n  display: grid;\n  gap: var(--dl-space-1);\n  justify-items: start;\n  text-align: left;\n}\n\n.billing-print__attachment-title strong {\n  font-size: var(--dl-font-size-label);\n  text-transform: none;\n}\n\n.billing-print__attachment-footer {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.billing-print__attachment-footer .billing-print__totals {\n  min-width: 20rem;\n}\n\n.billing-print__eyebrow,\n.billing-print__subtitle,\n.billing-print__compliance {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.billing-print__header-parties,\n.billing-print__party-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.billing-print__party {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.billing-print__party h2 {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n  margin: 0;\n  text-transform: uppercase;\n}\n\n.billing-print__party strong {\n  font-size: var(--dl-font-size-label);\n}\n\n.billing-print__party p {\n  margin: 0;\n}\n\n.billing-print__parties,\n.billing-print__meta,\n.billing-print__totals {\n  grid-template-columns: 1fr;\n}\n\n.billing-print__meta--document {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.billing-print__meta--document div {\n  flex-direction: column;\n  gap: var(--dl-space-1);\n}\n\n.billing-print__meta,\n.billing-print__totals {\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n  padding-top: var(--dl-space-4);\n}\n\n.billing-print__meta div,\n.billing-print__totals div {\n  display: flex;\n  justify-content: space-between;\n}\n\n.billing-print__table {\n  border-collapse: collapse;\n  font-size: var(--dl-font-size-small);\n  width: 100%;\n}\n\n.billing-print__table--invoice,\n.billing-print_