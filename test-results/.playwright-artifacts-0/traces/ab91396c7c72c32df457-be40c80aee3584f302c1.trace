rid > div,\n.works-page__cycle-header > div,\n.works-page__return-summary > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-header,\n.works-page__return-summary {\n  align-items: start;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__cycle-list {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__cycle-item {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.works-page__cycle-item[data-active=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__cycle-title {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__cycle-title > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-title span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__cycle-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__patient-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__tab {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  min-height: 36px;\n  padding: 0 var(--dl-space-3);\n}\n\n.works-page__tab[aria-selected=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__lab-sheet {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.works-page__form-full {\n  grid-column: 1 / -1;\n}\n\n.works-page__timeline > div {\n  border-left: 3px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding-left: var(--dl-space-3);\n}\n\n.works-page__timeline > div span,\n.works-page__timeline > div p {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.works-page__timeline li {\n  border-left: 3px solid var(--dl-color-border);\n  padding-left: var(--dl-space-3);\n}\n\n@media (min-width: 720px) {\n  .works-page__summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__filters,\n  .works-page__form-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__deadline-card {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__responsibility {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-header,\n  .works-page__return-summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__detail-section-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (min-width: 1100px) {\n  .works-page__summary {\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__form .works-page__work-selection-grid {\n    grid-template-columns: minmax(0, 2fr) minmax(5rem, 0.7fr) minmax(6rem, 0.75fr);\n  }\n}\n\n.works-page__probe-history {\n  display: grid;\n  gap: 0.3rem;\n  margin: 0 0 1rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--dl-border, #d5e1df);\n  border-radius: 0.75rem;\n  background: var(--dl-surface-muted, #f