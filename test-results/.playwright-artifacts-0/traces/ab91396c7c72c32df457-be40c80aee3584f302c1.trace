{"type":"frame-snapshot","snapshot":{"callId":"call@65","snapshotName":"after@call@65","pageId":"page@26bcc9fc1fe114290bdb4b9a4346c450","frameId":"frame@9ed35a90f86cd6a5550e6565d35ebe63","frameUrl":"http://127.0.0.1:3138/billing/statements/clinic/print?clinicId=cmtq9i4be002f4287w4uudfap&dateFrom=2026-01-01&dateTo=2026-12-31&documentIds=cmtqave6m000o0u878qzbyk7d","doctype":"html","html":["HTML",{"lang":"ro"},["HEAD",{},[[10,0]],[[10,1]],[[10,2]],[[10,3]],[[10,4]],[[10,5]],[[10,6]],[[10,7]],[[10,9]],[[10,10]],[[10,12]],[[10,14]],[[10,16]],["STYLE",{},".billing-page {\n  display: grid;\n  gap: var(--dl-space-4);\n  padding: var(--dl-layout-page-padding);\n}\n\n.billing-page__header,\n.billing-page__toolbar {\n  align-items: flex-start;\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__header h1 {\n  font-size: var(--dl-font-size-page-title);\n}\n\n.billing-page__eyebrow,\n.billing-page__readonly {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-page__quick-actions,\n.billing-page__toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__period-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.billing-page__period-selector {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: auto minmax(10rem, 1fr) auto;\n  padding: var(--dl-space-1);\n  text-align: center;\n}\n\n.billing-page__period-selector strong {\n  text-transform: capitalize;\n}\n\n.billing-page__archive-indicator {\n  background: color-mix(in srgb, var(--dl-color-success) 12%, var(--dl-color-surface));\n  border: 1px solid color-mix(in srgb, var(--dl-color-success) 35%, var(--dl-color-border));\n  border-radius: 999px;\n  color: var(--dl-color-success);\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.billing-page__actions-menu {\n  position: relative;\n}\n\n.billing-page__actions-trigger {\n  min-height: var(--dl-size-touch-target);\n}\n\n.billing-page__actions-menu > div {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  box-shadow: var(--dl-shadow-lg, 0 0.75rem 2rem rgb(15 23 42 / 14%));\n  display: grid;\n  gap: var(--dl-space-2);\n  min-inline-size: 15rem;\n  padding: var(--dl-space-2);\n  position: absolute;\n  right: 0;\n  top: calc(100% + var(--dl-space-2));\n  z-index: 20;\n}\n\n.billing-page__actions-menu .dl-button {\n  justify-content: flex-start;\n  width: 100%;\n}\n\n.billing-page__filters,\n.billing-page__cards,\n.billing-page__registry-summary,\n.billing-page__month-close {\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: 1fr;\n}\n\n.billing-page__cards > *,\n.billing-month-registry__summary > * {\n  --kpi-accent: var(--app-brand-primary);\n  --kpi-accent-border: color-mix(in srgb, var(--kpi-accent) 28%, var(--dl-color-border));\n  --kpi-accent-surface: color-mix(in srgb, var(--kpi-accent) 8%, var(--dl-color-surface));\n  --kpi-accent-text: color-mix(in srgb, var(--kpi-accent) 82%, var(--dl-color-text));\n}\n\n.billing-page__cards > *:nth-child(6n + 1),\n.billing-month-registry__summary > *:nth-child(6n + 1) {\n  --kpi-accent: var(--app-brand-primary);\n}\n\n.billing-page__cards > *:nth-child(6n + 2),\n.billing-month-registry__summary > *:nth-child(6n + 2) {\n  --kpi-accent: #2563eb;\n}\n\n.billing-page__cards > *:nth-child(6n + 3),\n.billing-month-registry__summary > *:nth-child(6n + 3) {\n  --kpi-accent: #059669;\n}\n\n.billing-page__cards > *:nth-child(6n + 4),\n.billing-month-registry__summary > *:nth-child(6n + 4) {\n  --kpi-accent: #d97706;\n}\n\n.billing-page__cards > *:nth-child(6n + 5),\n.billing-month-registry__summary > *:nth-child(6n + 5) {\n  --kpi-accent: #e11d48;\n}\n\n.billing-page__cards > *:nth-child(6n),\n.billing-month-registry__summary > *:nth-child(6n) {\n  --kpi-accent: #7c3aed;\n}\n\n.billing-page__filters-shell {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.billing-page__quick-filters {\n  align-items: end;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.billing-page__toolbar--filters {\n  align-items: center;\n}\n\n.billing-page__cards strong {\n  font-size: var(--dl-font-size-section-title);\n}\n\n.billing-page__kpi-card {\n  align-content: center;\n  background: var(--kpi-accent-surface);\n  border: var(--dl-border-width) solid var(--kpi-accent-border);\n  border-radius: var(--dl-radius-md);\n  color: inherit;\n  cursor: pointer;\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: center;\n  min-height: 5.5rem;\n  overflow: hidden;\n  padding: calc(var(--dl-space-4) + 0.15rem) var(--dl-space-4) var(--dl-space-4);\n  text-align: center;\n  position: relative;\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list {\n  background: var(--dl-color-background-secondary);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-1);\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list > .dl-tabs__tab {\n  border: 1px solid transparent;\n  border-radius: calc(var(--dl-radius-md) - 0.15rem);\n  flex: 0 0 auto;\n  font-weight: var(--dl-font-weight-semibold);\n  min-height: 2.6rem;\n  padding-inline: var(--dl-space-4);\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list > .dl-tabs__tab[aria-selected=\"true\"] {\n  background: var(--dl-color-surface);\n  border-color: color-mix(in srgb, var(--dl-color-accent) 38%, var(--dl-color-border));\n  box-shadow: var(--dl-shadow-sm);\n  color: var(--dl-color-accent);\n}\n\n.billing-page__kpi-card::before {\n  background: var(--kpi-accent);\n  content: \"\";\n  inset: 0 auto auto 0;\n  height: 0.35rem;\n  position: absolute;\n  width: 100%;\n}\n\n.billing-page__kpi-card:hover {\n  border-color: color-mix(in srgb, var(--app-brand-primary) 28%, var(--dl-color-border));\n  box-shadow: 0 2px 12px color-mix(in srgb, var(--app-brand-primary) 8%, transparent);\n}\n\n.billing-page__kpi-card:focus-visible {\n  outline: 2px solid var(--app-brand-primary);\n  outline-offset: 2px;\n}\n\n.billing-page__kpi-label,\n.billing-page__kpi-meta {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-page__kpi-value {\n  color: var(--kpi-accent-text);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.billing-page__kpi-label {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-page__kpi-value {\n  color: var(--kpi-accent-text);\n  font-size: var(--dl-font-size-section-title);\n  line-height: 1.05;\n}\n\n.billing-page__kpi-meta {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-page__tab {\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: stretch;\n  min-width: 0;\n  padding-block: var(--dl-space-4);\n}\n\n.billing-page__tab-toolbar {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n  min-width: 0;\n  width: 100%;\n}\n\n.billing-page__tab-toolbar-context,\n.billing-page__tab-toolbar-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.billing-page__tab-toolbar-context p {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.billing-page__tab-toolbar-actions {\n  justify-content: flex-end;\n  margin-inline-start: auto;\n}\n\n.billing-page__tab-toolbar-actions .dl-button {\n  flex: 0 0 auto;\n  min-height: var(--dl-size-touch-target);\n  white-space: nowrap;\n}\n\n.billing-page__row-selection-control {\n  align-items: center;\n  display: inline-flex;\n  height: 1.25rem;\n  justify-content: center;\n  vertical-align: middle;\n  width: 1.25rem;\n}\n\n.billing-page__row-selection-checkbox {\n  block-size: 1.125rem;\n  cursor: pointer;\n  flex: 0 0 auto;\n  inline-size: 1.125rem;\n  margin: 0;\n}\n\n.billing-page__row-selection-checkbox:disabled {\n  cursor: not-allowed;\n}\n\n.billing-page__row-selection-checkbox:focus-visible {\n  outline: 2px solid var(--dl-color-focus-ring, var(--dl-color-accent));\n  outline-offset: 2px;\n}\n\n.billing-page__toolbar--wrap {\n  align-items: center;\n  justify-content: flex-start;\n}\n\n.billing-page__toolbar--actions {\n  align-items: center;\n  flex-direction: row;\n  flex-wrap: nowrap;\n  justify-content: flex-start;\n  overflow-x: auto;\n  width: 100%;\n}\n\n.billing-page__toolbar--actions p {\n  margin-inline-end: auto;\n  white-space: nowrap;\n}\n\n.billing-page__review-summary {\n  display: grid;\n  gap: 0.35rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  padding: 0.85rem 1rem;\n  border: 1px solid var(--color-border, #d5dfdb);\n  border-radius: 0.75rem;\n}\n\n@media (max-width: 700px) {\n  .billing-page__review-summary {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n.billing-page__toolbar--tight {\n  align-items: center;\n  justify-content: flex-start;\n  padding-block-start: 0;\n}\n\n.billing-page__print-preview {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-2);\n  padding: var(--dl-space-4);\n}\n\n.billing-page__toolbar--inline {\n  justify-content: flex-start;\n  flex-wrap: nowrap;\n  overflow-x: auto;\n}\n\n.billing-page__payment-form,\n.billing-print-page,\n.billing-print,\n.billing-print__paper,\n.billing-print__paper-content,\n.billing-print__parties,\n.billing-print__meta,\n.billing-print__totals {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.billing-page__payment-form {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  grid-template-columns: 1fr;\n  padding: var(--dl-space-4);\n}\n\n.billing-page__payment-form h3,\n.billing-page__payment-form p,\n.billing-print h1,\n.billing-print h2,\n.billing-print p,\n.billing-print dl {\n  margin: 0;\n}\n\n.billing-print-page {\n  padding: var(--dl-layout-page-padding);\n}\n\n.billing-print-page__actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--dl-space-3);\n}\n\n.billing-print-page__back-link {\n  align-items: center;\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  display: inline-flex;\n  min-height: var(--dl-size-touch-target);\n  padding-inline: var(--dl-space-4);\n  text-decoration: none;\n}\n\n.billing-print-page__format-badge {\n  align-items: center;\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-full);\n  color: var(--dl-color-text-muted);\n  display: inline-flex;\n  min-height: var(--dl-size-touch-target);\n  padding-inline: var(--dl-space-3);\n}\n\n.billing-print {\n  gap: var(--dl-space-4);\n}\n\n.billing-print__paper {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  min-height: 297mm;\n  overflow: hidden;\n  position: relative;\n}\n\n.billing-print__paper--attachment {\n  min-height: 297mm;\n}\n\n.billing-print__paper-art {\n  block-size: 100%;\n  border: 0;\n  display: block;\n  inline-size: 100%;\n  inset: 0;\n  position: absolute;\n  z-index: 0;\n}\n\n.billing-print__paper-content {\n  gap: var(--dl-space-4);\n  position: relative;\n  z-index: 1;\n}\n\n.billing-print__paper-content--attachment {\n  padding: 36mm 12mm 12mm;\n}\n\n.billing-print--invoice {\n  padding: 0;\n}\n\n.billing-print--invoice .billing-print__paper-content {\n  padding: 12mm;\n}\n\n.billing-print__invoice-header {\n  align-items: flex-start;\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--dl-space-6);\n}\n\n.billing-print__invoice-series,\n.billing-print__invoice-number {\n  display: grid;\n  gap: var(--dl-space-1);\n  justify-items: end;\n  text-align: right;\n}\n\n.billing-print__invoice-series span,\n.billing-print__invoice-number span,\n.billing-print__invoice-number small,\n.billing-print__invoice-title-meta span {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-print__invoice-series strong,\n.billing-print__invoice-number strong {\n  font-size: var(--dl-font-size-label);\n  line-height: 1.1;\n}\n\n.billing-print__invoice-title {\n  display: grid;\n  gap: var(--dl-space-2);\n  justify-items: center;\n  margin-block-start: var(--dl-space-4);\n  text-align: center;\n}\n\n.billing-print__invoice-title h1 {\n  font-size: 1.7rem;\n  letter-spacing: 0;\n}\n\n.billing-print__invoice-title-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2) var(--dl-space-4);\n  justify-content: center;\n}\n\n.billing-print__invoice-title-meta strong {\n  font-size: var(--dl-font-size-label);\n}\n\n.billing-print__parties--invoice {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-block-start: var(--dl-space-3);\n}\n\n.billing-print__parties--invoice .billing-print__party {\n  border: 0;\n  padding: 0;\n}\n\n.billing-print__paper-body {\n  display: grid;\n  gap: var(--dl-space-4);\n  margin-block-start: var(--dl-space-4);\n}\n\n.billing-print__attachment-header {\n  align-items: start;\n  display: flex;\n  justify-content: space-between;\n  gap: var(--dl-space-6);\n  margin-block-end: var(--dl-space-4);\n}\n\n.billing-print__attachment-recipient {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.billing-print__attachment-recipient span {\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.billing-print__attachment-recipient p,\n.billing-print__attachment-recipient strong,\n.billing-print__attachment-title span,\n.billing-print__attachment-title strong {\n  margin: 0;\n}\n\n.billing-print__attachment-title {\n  display: grid;\n  gap: var(--dl-space-1);\n  justify-items: start;\n  text-align: left;\n}\n\n.billing-print__attachment-title strong {\n  font-size: var(--dl-font-size-label);\n  text-transform: none;\n}\n\n.billing-print__attachment-footer {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.billing-print__attachment-footer .billing-print__totals {\n  min-width: 20rem;\n}\n\n.billing-print__eyebrow,\n.billing-print__subtitle,\n.billing-print__compliance {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.billing-print__header-parties,\n.billing-print__party-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.billing-print__party {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.billing-print__party h2 {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n  margin: 0;\n  text-transform: uppercase;\n}\n\n.billing-print__party strong {\n  font-size: var(--dl-font-size-label);\n}\n\n.billing-print__party p {\n  margin: 0;\n}\n\n.billing-print__parties,\n.billing-print__meta,\n.billing-print__totals {\n  grid-template-columns: 1fr;\n}\n\n.billing-print__meta--document {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.billing-print__meta--document div {\n  flex-direction: column;\n  gap: var(--dl-space-1);\n}\n\n.billing-print__meta,\n.billing-print__totals {\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n  padding-top: var(--dl-space-4);\n}\n\n.billing-print__meta div,\n.billing-print__totals div {\n  display: flex;\n  justify-content: space-between;\n}\n\n.billing-print__table {\n  border-collapse: collapse;\n  font-size: var(--dl-font-size-small);\n  width: 100%;\n}\n\n.billing-print__table--invoice,\n.billing-print__table--attachment {\n  table-layout: fixed;\n}\n\n.billing-print__table--invoice th:nth-child(1),\n.billing-print__table--invoice td:nth-child(1) {\n  width: 3rem;\n}\n\n.billing-print__table--invoice th:nth-child(3),\n.billing-print__table--invoice td:nth-child(3) {\n  width: 5rem;\n}\n\n.billing-print__table--invoice th:nth-child(4),\n.billing-print__table--invoice td:nth-child(4),\n.billing-print__table--invoice th:nth-child(5),\n.billing-print__table--invoice td:nth-child(5),\n.billing-print__table--invoice th:nth-child(6),\n.billing-print__table--invoice td:nth-child(6) {\n  width: 6rem;\n}\n\n.billing-print__table--attachment th:nth-child(1),\n.billing-print__table--attachment td:nth-child(1) {\n  width: 4.75rem;\n  white-space: nowrap;\n}\n\n.billing-print__table--attachment th:nth-child(2),\n.billing-print__table--attachment td:nth-child(2) {\n  width: 5.25rem;\n  white-space: nowrap;\n}\n\n.billing-print__table--attachment th:nth-child(3),\n.billing-print__table--attachment td:nth-child(3) {\n  width: 7.5rem;\n}\n\n.billing-print__table--attachment th:nth-child(4),\n.billing-print__table--attachment td:nth-child(4) {\n  width: 6.8rem;\n}\n\n.billing-print__table--attachment th:nth-child(5),\n.billing-print__table--attachment td:nth-child(5) {\n  width: 4.5rem;\n}\n\n.billing-print__table--attachment th:nth-child(6),\n.billing-print__table--attachment td:nth-child(6) {\n  width: 3rem;\n  white-space: nowrap;\n}\n\n.billing-print__table--attachment th:nth-child(7),\n.billing-print__table--attachment td:nth-child(7),\n.billing-print__table--attachment th:nth-child(8),\n.billing-print__table--attachment td:nth-child(8) {\n  width: 4.75rem;\n  white-space: nowrap;\n}\n\n.billing-print__table th,\n.billing-print__table td {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  padding: var(--dl-space