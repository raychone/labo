f0fdfa; }\n.app-shell__notification-item > span:last-child { display: grid; gap: .2rem; min-width: 0; }\n.app-shell__notification-item small, .app-shell__notification-item time, .app-shell__notification-item em { color: #64748b; display: block; font-size: .78rem; overflow-wrap: anywhere; }\n.app-shell__notification-item em { color: #15803d; font-style: normal; }\n.app-shell__notification-severity { border-radius: 50%; flex: 0 0 .55rem; height: .55rem; margin-top: .35rem; width: .55rem; background: #0ea5e9; }\n.app-shell__notification-severity--error { background: #dc2626; } .app-shell__notification-severity--warning { background: #d97706; } .app-shell__notification-severity--action { background: #7c3aed; } .app-shell__notification-severity--success { background: #16a34a; }\n\n.app-shell__topbar-title span,\n.app-shell__user strong,\n.app-shell__brand strong {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.app-shell__topbar-title small,\n.app-shell__user small,\n.app-shell__brand small,\n.app-shell__header p {\n  color: var(--dl-color-text-muted);\n}\n\n.app-shell__header {\n  display: grid;\n  gap: var(--dl-space-2);\n  padding: var(--dl-space-4) var(--dl-space-3) 0;\n}\n\n.app-shell__header h1 {\n  font-size: var(--dl-font-size-page-title);\n  margin: 0;\n}\n\n.app-shell__header p {\n  margin: var(--dl-space-1) 0 0;\n}\n\n.app-shell__breadcrumbs ol {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.app-shell__breadcrumbs li + li::before {\n  color: var(--dl-color-text-muted);\n  content: \"/\";\n  margin-right: var(--dl-space-2);\n}\n\n.app-shell__main {\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding-block-end: var(--dl-space-5);\n  scrollbar-gutter: stable;\n}\n\n.app-shell__main > [class$=\"-page\"] {\n  min-height: auto;\n}\n\n.app-shell__main .dl-container {\n  max-width: none;\n  padding-inline: var(--dl-space-3);\n}\n\n.app-shell__notice