olute;\n  width: 1px;\n}\n\n.dl-file-upload--disabled {\n  cursor: not-allowed;\n  opacity: 0.62;\n}\n\n.dl-file-upload__list {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.dl-file-upload__list li {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: flex;\n  justify-content: space-between;\n  padding: var(--dl-space-2);\n}\n\n.dl-signature-pad,\n.dl-signature-display {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n}\n\n.dl-signature-pad {\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.dl-signature-pad__canvas,\n.dl-signature-display {\n  background:\n    linear-gradient(var(--dl-color-border) 1px, transparent 1px),\n    linear-gradient(90deg, var(--dl-color-border) 1px, transparent 1px),\n    var(--dl-color-surface);\n  background-size: 32px 32px;\n  display: block;\n  touch-action: none;\n  width: 100%;\n}\n\n.dl-signature-pad__canvas {\n  border: 1px dashed var(--dl-color-border-strong);\n  border-radius: var(--dl-radius-sm);\n  cursor: crosshair;\n}\n\n.dl-signature-pad__canvas:focus-visible {\n  outline: 3px solid var(--dl-color-accent);\n  outline-offset: 2px;\n}\n\n.dl-signature-pad__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.dl-signature-display {\n  min-height: 10rem;\n}\n\n.dl-signature-display--empty {\n  align-items: center;\n  color: var(--dl-color-text-secondary);\n  display: flex;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  padding: var(--dl-space-5);\n}\n\n.dl-data-table {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.dl-data-table__clickable-row {\n  cursor: pointer;\n}\n\n.dl-data-table__clickable-row:hover {\n  background: color-mix(in srgb, var(--dl-color-