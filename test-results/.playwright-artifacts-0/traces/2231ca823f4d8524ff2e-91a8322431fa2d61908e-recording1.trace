;\n}\n\n.auth-page__demo {\n  align-self: start;\n}\n\n.auth-page__demo-badge {\n  background: var(--dl-color-accent-subtle);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-accent-active);\n  display: inline-flex;\n  font-size: var(--dl-font-size-caption);\n  font-weight: var(--dl-font-weight-bold);\n  margin-right: var(--dl-space-2);\n  padding: 0.125rem var(--dl-space-2);\n}\n\n.auth-page__demo-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.auth-page__demo-button {\n  align-items: center;\n  border-color: color-mix(in srgb, var(--dl-color-primary) 28%, var(--dl-color-border));\n  min-height: 3rem;\n  padding-inline: var(--dl-space-3);\n  text-align: center;\n  white-space: nowrap;\n}\n\n.auth-page__demo-button:hover:not(:disabled) {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n  transform: translateY(-1px);\n}\n\n.auth-page__demo-button .dl-button__content,\n.auth-page__demo-button .dl-button__content > span {\n  align-items: center;\n  display: flex;\n  justify-content: center;\n  min-width: 0;\n  width: 100%;\n}\n\n.auth-page__demo-button span {\n  overflow-wrap: anywhere;\n}\n\n.auth-page__form,\n.auth-page__session {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.auth-page__user {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.auth-page__user span:last-child {\n  color: var(--dl-color-text-secondary);\n}\n\n.auth-page__permissions {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  overflow: hidden;\n}\n\n.auth-page__permissions-header {\n  align-items: center;\n  background: var(--dl-color-surface-secondary);\n  display: flex;\n  justify-content: space-between;\n  padding: var(--dl-space-3);\n}\n\n.auth-page__permissions ul {\n  display: grid;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.auth-page__permissions li {\n  align-items: start;\n  border-top: var(--d