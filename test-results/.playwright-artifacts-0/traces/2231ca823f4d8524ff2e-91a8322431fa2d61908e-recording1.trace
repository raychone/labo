play: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.dl-timeline,\n.dl-stepper {\n  display: grid;\n  gap: var(--dl-space-4);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.dl-timeline__item,\n.dl-stepper__item {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: auto 1fr;\n}\n\n.dl-timeline__marker,\n.dl-stepper__marker {\n  align-items: center;\n  background: var(--dl-color-accent-subtle);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-full);\n  color: var(--dl-color-accent);\n  display: inline-flex;\n  font-weight: var(--dl-font-weight-semibold);\n  height: 2rem;\n  justify-content: center;\n  width: 2rem;\n}\n\n.dl-timeline__content,\n.dl-stepper__text {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-stepper--horizontal {\n  grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));\n}\n\n.dl-stepper__item--completed .dl-stepper__marker {\n  background: var(--dl-color-success-background);\n  color: var(--dl-color-success-foreground);\n}\n\n.dl-stepper__item--current .dl-stepper__marker {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dl-stepper__item--error .dl-stepper__marker {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dl-file-upload {\n  align-items: center;\n  background: var(--dl-color-background-secondary);\n  border: 1px dashed var(--dl-color-border-strong);\n  border-radius: var(--dl-radius-lg);\n  cursor: pointer;\n  display: flex;\n  justify-content: center;\n  min-height: 7rem;\n  padding: var(--dl-space-4);\n  text-align: center;\n}\n\n.dl-file-upload input {\n  height: 1px;\n  opacity: 0;\n  position: absolute;\n  width: 1px;\n}\n\n.dl-file-upload--disabled {\n  cursor: not-allowed;\n  opacity: 0.62;\n}\n\n.dl-file-upload__list {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.dl-file-upload__list li {\n  align-items: 