ackground: var(--kpi-accent);\n  content: \"\";\n  inset: 0 auto auto 0;\n  height: 0.35rem;\n  position: absolute;\n  width: 100%;\n}\n\n.billing-month-registry__summary-card span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-month-registry__summary-card strong {\n  color: var(--kpi-accent-text);\n  font-size: 1rem;\n  line-height: 1.1;\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n\n.billing-month-registry__section {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.billing-month-registry__section > header {\n  break-after: avoid;\n  page-break-after: avoid;\n}\n\n.billing-month-registry__section h2 {\n  font-size: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.billing-month-registry__table {\n  border-collapse: collapse;\n  table-layout: fixed;\n  font-size: var(--dl-font-size-small);\n  width: 100%;\n}\n\n.billing-month-registry__table th,\n.billing-month-registry__table td {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  font-size: 0.72rem;\n  line-height: 1.2;\n  padding: 0.3rem 0.35rem;\n  text-align: left;\n  vertical-align: top;\n  word-break: normal;\n  overflow-wrap: normal;\n}\n\n.billing-month-registry__table th {\n  color: var(--dl-color-text-muted);\n  white-space: nowrap;\n}\n\n.billing-month-registry__table td {\n  overflow-wrap: normal;\n}\n\n.billing-month-registry__table tr {\n  break-inside: avoid;\n  page-break-inside: avoid;\n}\n\n.billing-month-registry__cell--nowrap {\n  white-space: nowrap;\n}\n\n.billing-month-registry__cell--right {\n  text-align: right;\n}\n\n.billing-month-registry__client-cell {\n  display: grid;\n  gap: 0.12rem;\n}\n\n.billing-month-registry__client-cell strong,\n.billing-month-registry__client-cell small {\n  display: block;\n}\n\n.billing-month-registry__client-cell strong {\n  white-space: nowrap;\n}\n\n.billing-month-registry__client-cell small {\n  color: var(--dl-color-text-muted);\n  font-size: 0.68rem;\