{
  "name": "dental-lab-management",
  "version": "0.0.0",
  "private": true,
  "description": "Custom dental laboratory management application monorepo.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --filter @dental-lab/api --filter @dental-lab/web dev",
    "smoke:test": "playwright test",
    "smoke:test:headed": "playwright test --headed",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @dental-lab/web dev",
    "dev:web:demo": "pnpm --filter @dental-lab/web dev",
    "dev:api": "pnpm --filter @dental-lab/api dev",
    "dev:api:demo": "pnpm --filter @dental-lab/api dev",
    "seed:demo": "pnpm --filter @dental-lab/api seed:demo",
    "db:migrate:deploy": "pnpm --filter @dental-lab/api prisma:migrate:deploy",
    "seed:demo:deploy": "pnpm --filter @dental-lab/api prisma:seed:deploy && pnpm --filter @dental-lab/api prisma:seed:demo:deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.2"
  }
}
