;\n  gap: var(--dl-space-4);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n/* The returned-probe flow is a two-pane workspace on desktop. Reserve the\n * available viewport height so both panels keep the stable proportions of the\n * operational flow; narrow screens retain the modal's internal scrolling. */\n.dashboard-page__returned-probe-modal {\n  height: min(64rem, calc(100dvh - 2rem));\n}\n\n.dashboard-page__returned-probe-modal .dl-overlay__content {\n  display: flex;\n}\n\n.dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n  flex: 1;\n  min-height: 100%;\n}\n\n@media (min-width: 56.01rem) {\n  .dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n    grid-template-rows: auto minmax(0, 1fr);\n  }\n}\n\n/* Open clinic and doctor lists remain part of the dialog layout, so the\n * dialog grows above its fixed footer instead of clipping their options. */\n.dashboard-page__returned-probe-modal .dashboard-page__return-fields .dl-select--open .dl-select__menu {\n  margin-top: var(--dl-space-2);\n  max-height: min(18rem, 35dvh);\n  position: static;\n}\n\n.dashboard-page__return-progress {\n  color: var(--dl-color-text-muted);\n  display: flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n  gap: var(--dl-space-4);\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.dashboard-page__return-progress span:first-child {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress span:not(.is-active):not(.is-complete) {\n  color: var(--dl-color-text-muted);\n}\n\n.dashboard-page__return-progress .is-active {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress .is-complete {\n  color: var(--dl-color-success-foreground, var(--dl-color-accent));\n}\n\n.dashboard-page__return-panel {\n  align-content: start;\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  min-width: 0;\n