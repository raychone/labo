a-table {\n    display: none;\n  }\n\n  .app-shell__main,\n  .billing-page,\n  .billing-print-page {\n    background: #ffffff;\n    padding: 0;\n  }\n\n  .billing-month-registry__paper {\n    min-height: auto;\n    overflow: visible;\n    padding: 10mm 10mm 12mm;\n  }\n\n  .billing-month-registry__header,\n  .billing-month-registry__summary {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-month-registry__section > header {\n    break-after: avoid;\n    page-break-after: avoid;\n  }\n\n  .billing-month-registry__table thead {\n    display: table-header-group;\n  }\n\n  .billing-month-registry__table tbody {\n    display: table-row-group;\n  }\n\n  .billing-month-registry__table tr {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-print-page .dl-tabs {\n    display: block;\n  }\n\n  .billing-print-page .dl-tabs__panel {\n    display: none;\n  }\n\n  .billing-print-page .dl-tabs__panel:not([hidden]) {\n    display: block;\n  }\n\n  .billing-page__print-preview,\n  .billing-print {\n    border: 0;\n    padding: 0;\n  }\n\n  .billing-statement {\n    border: 0;\n    box-shadow: none;\n  }\n\n  .billing-print__parties--invoice {\n    align-items: start;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: var(--dl-space-6);\n  }\n\n  .billing-print__header-parties,\n  .billing-print__party-grid,\n  .billing-print__meta--document {\n    grid-template-columns: 1fr;\n  }\n\n  .billing-print__header-parties,\n  .billing-print__party,\n  .billing-print__meta,\n  .billing-print__meta--document,\n  .billing-print__totals,\n  .billing-print__table,\n  .billing-statement__header,\n  .billing-statement__section,\n  .billing-statement__paper {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-print__party {\n    padding: var(--dl-space-2);\n  }\n\n  .billing-print__invoice-title h1 {\n    font-size: var(--dl-font-size-section-title);\n  }\n\n  .billing-print__eyebrow,\n  .billing-print__subtitle,\n  .billing-print__compliance,\n  .billing-print__party p,\n  .billing-print__party strong,\n  .billing-print__attachment-recipient,\n  .billing-print__attachment-title,\n  .billing-print__meta,\n  .billing-print__totals,\n  .billing-statement__brand,\n  .billing-statement__section-header,\n  .billing-statement__footer-total,\n  .billing-statement__table {\n    font-size: var(--dl-font-size-small);\n  }\n\n  .billing-print__paper-content--attachment {\n    padding: 44mm 20mm 18mm;\n  }\n\n  .billing-print--invoice .billing-print__paper-content {\n    padding: 12mm;\n  }\n\n  .billing-statement__paper {\n    break-after: page;\n    page-break-after: always;\n  }\n\n  .billing-statement__paper:last-child {\n    break-after: auto;\n    page-break-after: auto;\n  }\n\n}\n\n/* Print-safe statement layout: keep the table inside the printable area and\n   reserve the template header/footer instead of letting content overlap them. */\n.billing-statement__paper--a4 .billing-statement__content {\n  padding: 29mm 12mm 12mm;\n}\n\n.billing-statement__paper--a5 .billing-statement__content {\n  padding: 20mm 10mm 8mm;\n}\n\n.billing-statement__sheet {\n  min-height: calc(297mm - 41mm);\n}\n\n.billing-statement__paper--a5 .billing-statement__sheet {\n  min-height: calc(210mm - 30mm);\n}\n\n.billing-statement__frame {\n  margin: 10mm auto 0;\n  width: 100%;\n}\n\n.billing-statement__table--attachment {\n  font-size: 0.62rem;\n  table-layout: fixed;\n}\n\n.billing-statement__table--attachment th,\n.billing-statement__table--attachment td {\n  padding: 0.22rem 0.2rem;\n  white-space: normal;\n}\n\n.billing-statement__table--attachment th:nth-child(1),\n.billing-statement__table--attachment td:nth-child(1) { width: 11%; }\n.billing-statement__table--attachment th:nth-child(2),\n.billing-statement__table--attachment td:nth-child(2) { width: 12%; }\n.billing-statement__table--attachment th:nth-child(3),\n.billing-statement__table--attachment td:nth-child(3) { width: 17%; }\n.billing-statement__table--attachment th:nth-child(4),\n.billing-statement__table--attachment td:nth-child(4) { width: 17%; }\n.billing-statement__table--attachment th:nth-child(5),\n.billing-statement__table--attachment td:nth-child(5) { width: 12%; }\n.billing-statement__table--attachment th:nth-child(6),\n.billing-statement__table--attachment td:nth-child(6) { width: 7%; }\n.billing-statement__table--attachment th:nth-child(7),\n.billing-statement__table--attachment td:nth-child(7),\n.billing-statement__table--attachment th:nth-child(8),\n.billing-statement__table--attachment td:nth-child(8) { width: 12%; }\n\n.billing-statement__table thead {\n  display: table-header-group;\n}\n\n.billing-statement__table tr {\n  break-inside: avoid;\n  page-break-inside: avoid;\n}\n\n.billing-print__table--invoice tfoot th,\n.billing-print__table--invoice tfoot td {\n  border-top: 2px solid var(--dl-color-text);\n  font-weight: 700;\n}\n\n.billing-print__handover {\n  border: 1px solid var(--dl-color-text);\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  margin-top: 12mm;\n  min-height: 32mm;\n}\n\n.billing-print__handover-signature,\n.billing-print__handover-details {\n  padding: 8mm;\n}\n\n.billing-print__handover-signature {\n  align-items: center;\n  border-right: 1px solid var(--dl-color-text);\n  display: flex;\n  justify-content: center;\n  text-align: center;\n}\n\n.billing-print__handover-details {\n  display: grid;\n  gap: 5mm;\n}\n\n.billing-print__legal-note {\n  border-top: 1px solid var(--dl-color-border);\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n  margin-top: auto;\n  padding-top: 5mm;\n  text-align: center;\n}\n\n.billing-statement__paper {\n  box-sizing: border-box;\n  height: 297mm;\n  min-height: 297mm;\n  border: 0;\n  border-radius: 0;\n}\n\n.billing-statement__paper--a5 {\n  height: 210mm;\n  min-height: 210mm;\n}\n\n.billing-statement__content,\n.billing-statement__sheet {\n  box-sizing: border-box;\n  height: 100%;\n  min-height: 0;\n}\n\n.billing-statement__sheet {\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.billing-statement__frame {\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  min-height: 0;\n}\n\n.billing-statement__footer {\n  margin-top: auto;\n}\n\n.billing-statement .billing-print__table--attachment {\n  table-layout: fixed;\n  width: 100%;\n}\n\n.billing-statement .billing-print__table--attachment th:nth-child(1),\n.billing-statement .billing-print__table--attachment td:nth-child(1) { width: 11%; }\n.billing-statement .billing-print__table--attachment th:nth-child(2),\n.billing-statement .billing-print__table--attachment td:nth-child(2) { width: 12%; }\n.billing-statement .billing-print__table--attachment th:nth-child(3),\n.billing-statement .billing-print__table--attachment td:nth-child(3) { width: 17%; }\n.billing-statement .billing-print__table--attachment th:nth-child(4),\n.billing-statement .billing-print__table--attachment td:nth-child(4) { width: 17%; }\n.billing-statement .billing-print__table--attachment th:nth-child(5),\n.billing-statement .billing-print__table--attachment td:nth-child(5) { width: 12%; }\n.billing-statement .billing-print__table--attachment th:nth-child(6),\n.billing-statement .billing-print__table--attachment td:nth-child(6) { width: 7%; }\n.billing-statement .billing-print__table--attachment th:nth-child(7),\n.billing-statement .billing-print__table--attachment td:nth-child(7) { width: 15%; }\n\n.billing-statement .billing-print__table--attachment th,\n.billing-statement .billing-print__table--attachment td {\n  overflow-wrap: anywhere;\n  white-space: normal !important;\n  word-break: break-word;\n}\n\n.billing-statement .billing-print__table--attachment {\n  font-size: 0.55rem;\n  line-height: 1.08;\n}\n\n.billing-statement__section {\n  min-width: 0;\n}\n\n.billing-statement__footer {\n  align-self: end;\n  display: grid;\n  justify-items: end;\n  margin-top: auto;\n  width: 100%;\n}\n\n.billing-statement__footer-total {\n  align-items: baseline;\n  display: flex;\n  gap: 8mm;\n  justify-content: space-between;\n  min-width: 62mm;\n}\n\n.billing-print__handover {\n  grid-template-columns: 1fr 2fr;\n  margin-top: 5mm;\n  min-height: 20mm;\n}\n\n.billing-print__handover-signature,\n.billing-print__handover-details {\n  font-size: 0.72rem;\n  padding: 4mm;\n}\n\n.billing-print__handover-details {\n  gap: 3mm;\n}\n\n.billing-statement__sheet {\n  display: block;\n  min-height: 0;\n}\n\n.billing-statement__frame {\n  border: 0;\n  display: block;\n  min-height: 0;\n  padding: 0;\n}\n\n.billing-statement__frame > .billing-statement__section {\n  display: block;\n  min-height: 0;\n}\n\n.billing-statement__footer {\n  min-height: 0;\n  overflow: hidden;\n}\n\n.billing-statement .billing-print__table--attachment {\n  font-size: 0.6rem;\n  line-height: 1.08;\n  width: 100%;\n  border: 1px solid color-mix(in srgb, var(--dl-color-text) 78%, var(--dl-color-border));\n}\n\n.billing-statement .billing-print__table--attachment tfoot th,\n.billing-statement .billing-print__table--attachment tfoot td {\n  border-top: 1px solid var(--dl-color-text);\n  font-weight: 700;\n  text-align: right;\n}\n\n.billing-statement__paper,\n.billing-statement__content,\n.billing-statement__sheet,\n.billing-statement__frame {\n  break-inside: avoid;\n  page-break-inside: avoid;\n}\n\n@media print {\n  .billing-statement__paper {\n    /* The global A4 @page has 10mm top and 12mm bottom margins. The paper\n       must fit inside that printable box or its lower half starts a new page. */\n    height: calc(297mm - 22mm) !important;\n    max-height: calc(297mm - 22mm);\n    min-height: 0 !important;\n    overflow: visible;\n  }\n\n  .billing-statement__paper--a5 {\n    height: 210mm !important;\n    max-height: 210mm;\n  }\n\n  .billing-statement__content {\n    height: auto;\n    max-height: none;\n    min-height: 0;\n    overflow: visible;\n  }\n\n  .billing-statement__sheet,\n  .billing-statement_