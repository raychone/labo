g: var(--dl-space-2) var(--dl-space-3);\n}\n\n.billing-page__actions-menu {\n  position: relative;\n}\n\n.billing-page__actions-trigger {\n  min-height: var(--dl-size-touch-target);\n}\n\n.billing-page__actions-menu > div {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  box-shadow: var(--dl-shadow-lg, 0 0.75rem 2rem rgb(15 23 42 / 14%));\n  display: grid;\n  gap: var(--dl-space-2);\n  min-inline-size: 15rem;\n  padding: var(--dl-space-2);\n  position: absolute;\n  right: 0;\n  top: calc(100% + var(--dl-space-2));\n  z-index: 20;\n}\n\n.billing-page__actions-menu .dl-button {\n  justify-content: flex-start;\n  width: 100%;\n}\n\n.billing-page__filters,\n.billing-page__cards,\n.billing-page__registry-summary,\n.billing-page__month-close {\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: 1fr;\n}\n\n.billing-page__cards > *,\n.billing-month-registry__summary > * {\n  --kpi-accent: var(--app-brand-primary);\n  --kpi-accent-border: color-mix(in srgb, var(--kpi-accent) 28%, var(--dl-color-border));\n  --kpi-accent-surface: color-mix(in srgb, var(--kpi-accent) 8%, var(--dl-color-surface));\n  --kpi-accent-text: color-mix(in srgb, var(--kpi-accent) 82%, var(--dl-color-text));\n}\n\n.billing-page__cards > *:nth-child(6n + 1),\n.billing-month-registry__summary > *:nth-child(6n + 1) {\n  --kpi-accent: var(--app-brand-primary);\n}\n\n.billing-page__cards > *:nth-child(6n + 2),\n.billing-month-registry__summary > *:nth-child(6n + 2) {\n  --kpi-accent: #2563eb;\n}\n\n.billing-page__cards > *:nth-child(6n + 3),\n.billing-month-registry__summary > *:nth-child(6n + 3) {\n  --kpi-accent: #059669;\n}\n\n.billing-page__cards > *:nth-child(6n + 4),\n.billing-month-registry__summary > *:nth-child(6n + 4) {\n  --kpi-accent: #d97706;\n}\n\n.billing-page__cards > *:nth-child(6n + 5),\n.billing-month-registry__summary > *:nth-child(6n + 5) {\n  --kpi-accent: #e11d48;\n}\n\n