\n  --dl-color-accent-hover: #0b594c;\n  --dl-color-accent-active: #07473e;\n  --dl-color-accent-subtle: #e3f3ee;\n\n  /* Semantic colors */\n  --dl-color-success: #146c43;\n  --dl-color-success-foreground: #0f3d29;\n  --dl-color-success-background: #e7f5ed;\n  --dl-color-success-border: #9bd3b5;\n  --dl-color-success-strong: #0f5a37;\n\n  --dl-color-warning: #946200;\n  --dl-color-warning-foreground: #563800;\n  --dl-color-warning-background: #fff3d6;\n  --dl-color-warning-border: #f0cc73;\n  --dl-color-warning-strong: #7a4f00;\n\n  --dl-color-danger: #b42318;\n  --dl-color-danger-foreground: #6f1710;\n  --dl-color-danger-background: #fde8e6;\n  --dl-color-danger-border: #f2aaa4;\n  --dl-color-danger-strong: #921b12;\n\n  --dl-color-info: #1d5f8f;\n  --dl-color-info-foreground: #123c5a;\n  --dl-color-info-background: #e7f2fb;\n  --dl-color-info-border: #9fcbe8;\n  --dl-color-info-strong: #174d75;\n\n  --dl-color-neutral: #52615a;\n  --dl-color-neutral-foreground: #2f3834;\n  --dl-color-neutral-background: #eef2f0;\n  --dl-color-neutral-border: #c7d0cc;\n  --dl-color-neutral-strong: #3f4a45;\n\n  /* Operational status tokens */\n  --dl-status-draft-background: var(--dl-color-neutral-background);\n  --dl-status-draft-foreground: var(--dl-color-neutral-foreground);\n  --dl-status-draft-border: var(--dl-color-neutral-border);\n\n  --dl-status-registered-background: var(--dl-color-info-background);\n  --dl-status-registered-foreground: var(--dl-color-info-foreground);\n  --dl-status-registered-border: var(--dl-color-info-border);\n\n  --dl-status-awaiting-background: var(--dl-color-warning-background);\n  --dl-status-awaiting-foreground: var(--dl-color-warning-foreground);\n  --dl-status-awaiting-border: var(--dl-color-warning-border);\n\n  --dl-status-planned-background: #e9edf8;\n  --dl-status-planned-foreground: #263b74;\n  --dl-status-planned-border: #b8c4e7;\n\n  --dl-status-production-background: var(--dl-color-accent-subtle);\n  --dl-status-production-foreground: var(--dl-color-accent-active);\n  --dl-status-production-border: #9ed1c5;\n\n  --dl-status-quality-background: #eef0ff;\n  --dl-status-quality-foreground: #35347a;\n  --dl-status-quality-border: #bfc2f2;\n\n  --dl-status-rejected-background: var(--dl-color-danger-background);\n  --dl-status-rejected-foreground: var(--dl-color-danger-foreground);\n  --dl-status-rejected-border: var(--dl-color-danger-border);\n\n  --dl-status-approved-background: var(--dl-color-success-background);\n  --dl-status-approved-foreground: var(--dl-color-success-foreground);\n  --dl-status-approved-border: var(--dl-color-success-border);\n\n  --dl-status-delivery-background: #e9f6f8;\n  --dl-status-delivery-foreground: #164f5a;\n  --dl-status-delivery-border: #a7d9df;\n\n  --dl-status-delivered-background: var(--dl-color-success-background);\n  --dl-status-delivered-foreground: var(--dl-color-success-foreground);\n  --dl-status-delivered-border: var(--dl-color-success-border);\n\n  --dl-status-payment-background: var(--dl-color-warning-background);\n  --dl-status-payment-foreground: var(--dl-color-warning-foreground);\n  --dl-status-payment-border: var(--dl-color-warning-border);\n\n  --dl-status-paid-background: var(--dl-color-success-background);\n  --dl-status-paid-foreground: var(--dl-color-success-foreground);\n  --dl-status-paid-border: var(--dl-color-success-border);\n\n  --dl-status-invoiced-background: #ecf4ff;\n  --dl-status-invoiced-foreground: #173e74;\n  --dl-status-invoiced-border: #acd0f4;\n\n  --dl-status-closed-background: #edf1ef;\n  --dl-status-closed-foreground: #34423c;\n  --dl-status-closed-border: #c4ceca;\n\n  --dl-status-cancelled-background: var(--dl-color-danger-background);\n  --dl-status-cancelled-foreground: var(--dl-color-danger-foreground);\n  --dl-status-cancelled-border: var(--dl-color-danger-border);\n\n  /* Spacing */\n  --dl-space-0: 0;\n  --dl-space-1: 0.25rem;\n  --dl-space-2: 0.5rem;\n  --dl-space-3: 0.75rem;\n  --dl-space-4: 1rem;\n  --dl-space-5: 1.25rem;\n  --dl-space-6: 1.5rem;\n  --dl-space-8: 2rem;\n  --dl-space-10: 2.5rem;\n  --dl-space-12: 3rem;\n  --dl-space-16: 4rem;\n\n  /* Dimensions and layout */\n  --dl-size-touch-target: 2.75rem;\n  --dl-size-control-sm: 2.25rem;\n  --dl-size-control-md: 2.75rem;\n  --dl-size-control-lg: 3.25rem;\n  --dl-size-header-height: 3.75rem;\n  --dl-size-sidebar-collapsed: 4.5rem;\n  --dl-size-sidebar-expanded: 17.5rem;\n  --dl-layout-content-max-width: 76rem;\n  --dl-layout-readable-max-width: 42rem;\n  --dl-layout-page-padding: var(--dl-space-4);\n  --dl-layout-section-spacing: var(--dl-space-8);\n  --dl-layout-grid-gap: var(--dl-space-4);\n\n  /* Radius, borders, shadows */\n  --dl-radius-sm: 0.375rem;\n  --dl-radius-md: 0.5rem;\n  --dl-radius-lg: 0.75rem;\n  --dl-radius-full: 999rem;\n  --dl-border-width: 1px;\n  --dl-shadow-sm: 0 1px 2px rgb(23 32 27 / 6%);\n  --dl-shadow-md: 0 8px 24px rgb(23 32 27 / 8%);\n  --dl-shadow-focus: 0 0 0 3px rgb(17 106 91 / 24%);\n\n  /* Breakpoints */\n  --dl-breakpoint-mobile: 22.5rem;\n  --dl-breakpoint-tablet: 48rem;\n  --dl-breakpoint-desktop: 64rem;\n  --dl-breakpoint-wide: 90rem;\n\n  /* Motion */\n  --dl-duration-fast: 120ms;\n  --dl-duration-normal: 180ms;\n  --dl-easing-standard: cubic-bezier(0.2, 0, 0, 1);\n\n  /* Layering */\n  --dl-z-base: 0;\n  --dl-z-sticky: 100;\n  --dl-z-dropdown: 300;\n  --dl-z-overlay: 600;\n  --dl-z-modal: 700;\n  --dl-z-toast: 800;\n\n  /* Compatibility aliases for legacy feature styles. Keep these mapped to\n     UI-002 tokens while those styles are migrated incrementally. */\n  --color-background: var(--dl-color-background);\n  --color-foreground: var(--dl-color-text);\n  --color-muted-foreground: var(--dl-color-text-muted);\n  --color-primary: var(--dl-color-accent);\n  --color-primary-foreground: #ffffff;\n  --color-primary-soft: var(--dl-color-accent-subtle);\n  --color-primary-strong: var(--dl-color-accent-active);\n  --color-danger: var(--dl-color-danger);\n  --color-surface: var(--dl-color-surface);\n  --color-surface-muted: var(--dl-color-surface-muted);\n  --color-border: var(--dl-color-border);\n  --color-text: var(--dl-color-text);\n  --color-text-muted: var(--dl-color-text-muted);\n  --space-1: var(--dl-space-1);\n  --space-2: var(--dl-space-2);\n  --space-3: var(--dl-space-3);\n  --space-4: var(--dl-space-4);\n  --space-5: var(--dl-space-5);\n  --space-6: var(--dl-space-6);\n  --font-size-xs: var(--dl-font-size-caption);\n  --font-size-sm: var(--dl-font-size-small);\n  --font-size-lg: var(--dl-font-size-card-title);\n  --font-size-2xl: var(--dl-font-size-section-title);\n  --font-size-3xl: var(--dl-font-size-page-title);\n  --radius-sm: var(--dl-radius-sm);\n  --radius-md: var(--dl-radius-md);\n  --shadow-md: var(--dl-shadow-md);\n  --shadow-lg: 0 16px 40px rgb(23 32 27 / 12%);\n}\n\n@media (min-width: 48rem) {\n  :root {\n    --dl-font-size-display: 3rem;\n    --dl-font-size-page-title: 2.125rem;\n    --dl-layout-page-padding: var(--dl-space-8);\n    --dl-layout-section-spacing: var(--dl-space-10);\n    --dl-layout-grid-gap: var(--dl-space-6);\n  }\n}\n\n@media (min-width: 64rem) {\n  :root {\n    --dl-layout-page-padding: var(--dl-space-10);\n    --dl-layout-section-spacing: var(--dl-space-12);\n  }\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  min-width: 20rem;\n  text-size-adjust: 100%;\n  width: 100%;\n}\n\nbody {\n  background: var(--dl-color-background);\n  color: var(--dl-color-text);\n  font-family: var(--dl-font-family-sans);\n  font-size: var(--dl-font-size-body);\n  font-weight: var(--dl-font-weight-regular);\n  line-height: var(--dl-line-height-body);\n  margin: 0;\n  min-height: 100vh;\n  text-rendering: optimizeLegibility;\n  width: 100%;\n}\n\n#root {\n  min-height: 100vh;\n  width: 100%;\n}\n\n.dl-kpi {\n  align-content: center;\n  color: var(--dl-color-text);\n  display: grid;\n  gap: 0.35rem;\n  justify-items: center;\n  min-width: 0;\n  text-align: center;\n}\n\n.dl-kpi__title,\n.dl-kpi__value,\n.dl-kpi__description {\n  color: #111817;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.dl-kpi__title {\n  font-size: clamp(0.82rem, 1vw, 1rem);\n  font-weight: var(--dl-font-weight-bold);\n  line-height: 1.2;\n}\n\n.dl-kpi__value {\n  font-size: clamp(1.35rem, 2.4vw, 2rem);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.05;\n  white-space: nowrap;\n}\n\n.dl-kpi__description {\n  font-size: clamp(0.76rem, 0.95vw, 0.9rem);\n  font-weight: var(--dl-font-weight-medium);\n  line-height: 1.25;\n}\n\n/* Existing app KPI cards opt into the same readable text scale. */\n.dl-kpi span,\n.dl-kpi strong,\n.dl-kpi small {\n  color: #111817 !important;\n}\n\n.dl-kpi span {\n  font-size: clamp(0.82rem, 1vw, 1rem) !important;\n  font-weight: var(--dl-font-weight-bold);\n  line-height: 1.2;\n}\n\n.dl-kpi strong {\n  font-size: clamp(1.35rem, 2.4vw, 2rem) !important;\n  line-height: 1.05;\n}\n\n.dl-kpi small {\n  font-size: clamp(0.76rem, 0.95vw, 0.9rem) !important;\n  font-weight: var(--dl-font-weight-medium);\n  line-height: 1.25;\n}\n\n::selection {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent-active);\n}\n\n:focus-visible {\n  box-shadow: var(--dl-shadow-focus);\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n\nh1,\nh2,\nh3,\nh4,\np {\n  margin-block: 0;\n}\n\nh1,\nh2,\nh3,\nh4 {\n  color: var(--dl-color-text);\n  font-weight: var(--dl-font-weight-bold);\n  letter-spacing: 0;\n  line-height: var(--dl-line-height-title);\n}\n\nh1 {\n  font-size: var(--dl-font-size-page-title);\n}\n\nh2 {\n  font-size: var(--dl-font-size-section-title);\n}\n\nh3 {\n  font-size: var(--dl-font-size-card-title);\n}\n\np {\n  color: var(--dl-color-text-secondary);\n}\n\na {\n  color: var(--dl-color-accent);\n  text-decoration-thickness: 0.08em;\n  text-underline-offset: 0.18em;\n}\n\na:hover {\n  color: var(--dl-color-accent-hover);\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\n\nbutton,\nselect {\n  text-transform: none;\n}\n\nbutton {\n  min-height: var(--dl-size-touch-target);\n}\n\ninput,\ntextarea,\nselect {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  min-height: var(--dl-size-control-md);\n  padding: 0 var(--dl-space-3);\n  width: 100%;\n}\n\nselect {\n  appearance: none;\n  background-image:\n    linear-gradient(45deg, transparent 50%, var(--dl-color-text-secondary) 50%),\n    linear-gradient(135deg, var(--dl-color-text-secondary) 50%, transparent 50%);\n  background-position:\n    calc(100% - 1rem) 50%,\n    calc(100% - 0.6875rem) 50%;\n  background-repeat: no-repeat;\n  background-size:\n    0.375rem 0.375rem,\n    0.375rem 0.375rem;\n  cursor: pointer;\n  padding-right: var(--dl-space-8);\n}\n\ninput:hover:not(:disabled),\ntextarea:hover:not(:disabled),\nselect:hover:not(:disabled) {\n  border-color: var(--dl-color-border-strong);\n}\n\ntextarea {\n  min-height: 5.5rem;\n  padding-block: var(--dl-space-2);\n  resize: vertical;\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: var(--dl-color-text-muted);\n}\n\ninput:disabled,\ntextarea:disabled,\nselect:disabled,\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.62;\n}\n\nselect:disabled {\n  background-image:\n    linear-gradient(45deg, transparent 50%, var(--dl-color-text-muted) 50%),\n    linear-gradient(135deg, var(--dl-color-text-muted) 50%, transparent 50%);\n}\n\n.dl-select-field {\n  position: relative;\n}\n\n.dl-select {\n  position: relative;\n}\n\n.dl-select__search {\n  background: var(--dl-color-surface);\n  padding-right: 3rem;\n}\n\n.dl-select--open .dl-select__search {\n  border-color: var(--dl-color-accent);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--dl-color-accent) 16%, transparent);\n}\n\n.dl-select__chevron {\n  border-bottom: 2px solid var(--dl-color-text-secondary);\n  border-right: 2px solid var(--dl-color-text-secondary);\n  height: 0.55rem;\n  pointer-events: none;\n  position: absolute;\n  right: 1.1rem;\n  top: 1rem;\n  transform: rotate(45deg);\n  width: 0.55rem;\n}\n\n.dl-select__menu {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  box-shadow: var(--dl-shadow-lg);\n  display: grid;\n  gap: var(--dl-space-2);\n  left: 0;\n  max-height: min(24rem, 50vh);\n  overflow-y: auto;\n  padding: var(--dl-space-2);\n  position: absolute;\n  right: 0;\n  top: calc(100% + var(--dl-space-2));\n  z-index: 20;\n}\n\n.dl-select__option {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: grid;\n  gap: 0.2rem;\n  min-height: 4.25rem;\n  padding: var(--dl-space-3);\n  position: relative;\n  text-align: left;\n  width: 100%;\n}\n\n.dl-select__option:hover,\n.dl-select__option:focus-visible,\n.dl-select__option--selected {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n  outline: none;\n}\n\n.dl-select__option--disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.dl-select__option strong {\n  font-size: var(--dl-font-size-body);\n  font-weight: var(--dl-font-weight-bold);\n}\n\n.dl-select__option small {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-label);\n}\n\n.dl-select__check {\n  color: var(--dl-color-accent);\n  font-size: 1.2rem;\n  position: absolute;\n  right: var(--dl-space-3);\n  top: var(--dl-space-3);\n}\n\n.dl-select__empty {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n  padding: var(--dl-space-3);\n}\n\n.dl-select__native {\n  height: 1px;\n  opacity: 0;\n  pointer-events: none;\n  position: absolute;\n  width: 1px;\n}\n\n.dl-select--disabled .dl-select__search {\n  cursor: not-allowed;\n}\n\ninput[aria-invalid=\"true\"],\ntextarea[aria-invalid=\"true\"],\nselect[aria-invalid=\"true\"] {\n  border-color: var(--dl-color-danger-border);\n  box-shadow: 0 0 0 1px var(--dl-color-danger-border);\n}\n\nimg,\nsvg,\nvideo,\ncanvas {\n  display: block;\n  max-width: 100%;\n}\n\ntable {\n  border-collapse: collapse;\n  width: 100%;\n}\n\nth,\ntd {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  padding: var(--dl-space-3);\n  text-align: left;\n}\n\nth {\n  color: var(--dl-color-text-secondary);\n  font-size: var(--dl-font-size-label);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dl-page {\n  min-height: 100vh;\n  padding: var(--dl-layout-page-padding);\n}\n\n.dl-container {\n  margin-inline: auto;\n  max-width: var(--dl-layout-content-max-width);\n  width: 100%;\n}\n\n.dl-section {\n  padding-block: var(--dl-layout-section-spacing);\n}\n\n.dl-stack {\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-stack-gap, var(--dl-space-4));\n}\n\n.dl-grid {\n  display: grid;\n  gap: var(--dl-layout-grid-gap);\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));\n}\n\n.dl-visually-hidden {\n  clip: rect(0 0 0 0);\n  border: 0;\n  height: 1px;\n  margin: -1px;\n  overflow: hidden;\n  padding: 0;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n.dl-button {\n  align-items: center;\n  border: var(--dl-border-width) solid transparent;\n  border-radius: var(--dl-radius-md);\n  position: relative;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: var(--dl-size-touch-target);\n  padding: 0 var(--dl-space-4);\n  transition:\n    background-color var(--dl-duration-fast) var(--dl-easing-standard),\n    border-color var(--dl-duration-fast) var(--dl-easing-standard),\n    color var(--dl-duration-fast) var(--dl-easing-standard);\n}\n\n.dl-button--small {\n  min-height: var(--dl-size-control-sm);\n  padding-inline: var(--dl-space-3);\n}\n\n.dl-button--medium {\n  min-height: var(--d