--dl-color-surface-muted);\n  --color-border: var(--dl-color-border);\n  --color-text: var(--dl-color-text);\n  --color-text-muted: var(--dl-color-text-muted);\n  --space-1: var(--dl-space-1);\n  --space-2: var(--dl-space-2);\n  --space-3: var(--dl-space-3);\n  --space-4: var(--dl-space-4);\n  --space-5: var(--dl-space-5);\n  --space-6: var(--dl-space-6);\n  --font-size-xs: var(--dl-font-size-caption);\n  --font-size-sm: var(--dl-font-size-small);\n  --font-size-lg: var(--dl-font-size-card-title);\n  --font-size-2xl: var(--dl-font-size-section-title);\n  --font-size-3xl: var(--dl-font-size-page-title);\n  --radius-sm: var(--dl-radius-sm);\n  --radius-md: var(--dl-radius-md);\n  --shadow-md: var(--dl-shadow-md);\n  --shadow-lg: 0 16px 40px rgb(23 32 27 / 12%);\n}\n\n@media (min-width: 48rem) {\n  :root {\n    --dl-font-size-display: 3rem;\n    --dl-font-size-page-title: 2.125rem;\n    --dl-layout-page-padding: var(--dl-space-8);\n    --dl-layout-section-spacing: var(--dl-space-10);\n    --dl-layout-grid-gap: var(--dl-space-6);\n  }\n}\n\n@media (min-width: 64rem) {\n  :root {\n    --dl-layout-page-padding: var(--dl-space-10);\n    --dl-layout-section-spacing: var(--dl-space-12);\n  }\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  min-width: 20rem;\n  text-size-adjust: 100%;\n  width: 100%;\n}\n\nbody {\n  background: var(--dl-color-background);\n  color: var(--dl-color-text);\n  font-family: var(--dl-font-family-sans);\n  font-size: var(--dl-font-size-body);\n  font-weight: var(--dl-font-weight-regular);\n  line-height: var(--dl-line-height-body);\n  margin: 0;\n  min-height: 100vh;\n  text-rendering: optimizeLegibility;\n  width: 100%;\n}\n\n#root {\n  min-height: 100vh;\n  width: 100%;\n}\n\n.dl-kpi {\n  align-content: center;\n  color: var(--dl-color-text);\n  display: grid;\n  gap: 0.35rem;\n  justify-items: center;\n  min-width: 0;\n  text-align: center;\n}\n\n.dl-kpi__title,\n.dl-kpi__value,\n.dl-kpi__description {\n  color: #111817;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.dl-kpi__title {\n  font-size: clamp(0.82rem, 1vw, 1rem);\n  font-weight: var(--dl-font-weight-bold);\n  line-height: 1.2;\n}\n\n.dl-kpi__value {\n  font-size: clamp(1.35rem, 2.4vw, 2rem);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.05;\n  white-space: nowrap;\n}\n\n.dl-kpi__description {\n  font-size: clamp(0.76rem, 0.95vw, 0.9rem);\n  font-weight: var(--dl-font-weight-medium);\n  line-height: 1.25;\n}\n\n/* Existing app KPI cards opt into the same readable text scale. */\n.dl-kpi span,\n.dl-kpi strong,\n.dl-kpi small {\n  color: #111817 !important;\n}\n\n.dl-kpi span {\n  font-size: clamp(0.82rem, 1vw, 1rem) !important;\n  font-weight: var(--dl-font-weight-bold);\n  line-height: 1.2;\n}\n\n.dl-kpi strong {\n  font-size: clamp(1.35rem, 2.4vw, 2rem) !important;\n  line-height: 1.05;\n}\n\n.dl-kpi small {\n  font-size: clamp(0.76rem, 0.95vw, 0.9rem) !important;\n  font-weight: var(--dl-font-weight-medium);\n  line-height: 1.25;\n}\n\n::selection {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent-active);\n}\n\n:focus-visible {\n  box-shadow: var(--dl-shadow-focus);\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n\nh1,\nh2,\nh3,\nh4,\np {\n  margin-block: 0;\n}\n\nh1,\nh2,\nh3,\nh4 {\n  color: var(--dl-color-text);\n  font-weight: var(--dl-font-weight-bold);\n  letter-spacing: 0;\n  line-height: var(--dl-line-height-title);\n}\n\nh1 {\n  font-size: var(--dl-font-size-page-title);\n}\n\nh2 {\n  font-size: var(--dl-font-size-section-title);\n}\n\nh3 {\n  font-size: var(--dl-font-size-card-title);\n}\n\np {\n  color: var(--dl-color-text-secondary);\n}\n\na {\n  color: var(--dl-color-accent);\n  text-decoration-thickness: 0.08em;\n  text-underline-offset: 0.18em;\n}\n\na:hover {\n  color: var(--dl-color-accent-hover);\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\n\nbutton,\nselect {\n  text-transform: none;\n}\n\nbutton {\n  min-height: var(--dl-size-touch-target);\n}\n\ninput,\ntextarea,\nselect {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  min-height: var(--dl-size-control-md);\n  padding: 0 var(--dl-space-3);\n  width: 100%;\n}\n\nselect {\n  appearance: none;\n  background-image:\n    linear-gradient(45deg, transparent 50%, var(--dl-color-text-secondary) 50%),\n    linear-gradient(135deg, var(--dl-color-text-secondary) 50%, transparent 50%);\n  background-position:\n    calc(100% - 1rem) 50%,\n    calc(100% - 0.6875rem) 50%;\n  background-repeat: no-repeat;\n  background-size:\n    0.375rem 0.375rem,\n    0.375rem 0.375rem;\n  cursor: pointer;\n  padding-right: var(--dl-space-8);\n}\n\ninput:hover:not(:disabled),\ntextarea:hover:not(:disabled),\nselect:hover:not(:disabled) {\n  border-color: var(--dl-color-border-strong);\n}\n\ntextarea {\n  min-height: 5.5rem;\n  padding-block: var(--dl-space-2);\n  resize: vertical;\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: var(--dl-color-text-muted);\n}\n\ninput:disabled,\ntextarea:disabled,\nselect:disabled,\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.62;\n}\n\nselect:disabled {\n  background-image:\n    linear-gradient(45deg, transparent 50%, var(--dl-color-text-muted) 50%),\n    linear-gradient(135deg, var(--dl-color-text-muted) 50%, transparent 50%);\n}\n\n.dl-select-field {\n  position: relative;\n}\n\n.dl-select {\n  position: relative;\n}\n\n.dl-select__search {\n  background: var(--dl-color-surface);\n  padding-right: 3rem;\n}\n\n.dl-select--open .dl-select__search {\n  border-color: var(--dl-color-accent);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--dl-color-accent) 16%, transparent);\n}\n\n.dl-select__chevron {\n  border-bottom: 2px solid var(--dl-color-text-secondary);\n  border-right: 2px solid var(--dl-color-text-secondary);\n  height: 0.55rem;\n  pointer-events: none;\n  position: absolute;\n  right: 1.1rem;\n  top: 1rem;\n  transform: rotate(45deg);\n  width: 0.55rem;\n}\n\n.dl-select__menu {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  box-shadow: var(--dl-shadow-lg);\n  display: grid;\n  gap: var(--dl-space-2);\n  left: 0;\n  max-height: min(24rem, 50vh);\n  overflow-y: auto;\n  padding: var(--dl-space-2);\n  position: absolute;\n  right: 0;\n  top: calc(100% + var(--dl-space-2));\n  z-index: 20;\n}\n\n.dl-select__option {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: grid;\n  gap: 0.2rem;\n  min-height: 4.25rem;\n  padding: var(--dl-space-3);\n  position: relative;\n  text-align: left;\n  width: 100%;\n}\n\n.dl-select__option:hover,\n.dl-select__option:focus-visible,\n.dl-select__option--selected {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n  outline: none;\n}\n\n.dl-select__option--disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.dl-select__option strong {\n  font-size: var(--dl-font-size-body);\n  font-weight: var(--dl-font-weight-bold);\n}\n\n.dl-select__option small {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-label);\n}\n\n.dl-select__check {\n  color: var(--dl-color-accent);\n  font-size: 1.2rem;\n  position: absolute;\n  right: var(--dl-space-3);\n  top: var(--dl-space-3);\n}\n\n.dl-select__empty {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n  padding: var(--dl-space-3);\n}\n\n.dl-select__native {\n  height: 1px;\n  opacity: 0;\n  pointer-events: none;\n  position: absolute;\n  width: 1px;\n}\n\n.dl-select--disabled .dl-select__search {\n  cursor: not-allowed;\n}\n\ninput[aria-invalid=\"true\"],\ntextarea[aria-invalid=\"true\"],\nselect[aria-invalid=\"true\"] {\n  border-color: var(--dl-color-danger-border);\n  box-shadow: 0 0 0 1px var(--dl-color-danger-border);\n}\n\nimg,\nsvg,\nvideo,\ncanvas {\n  display: block;\n  max-width: 100%;\n}\n\ntable {\n  border-collapse: collapse;\n  width: 100%;\n}\n\nth,\ntd {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  padding: var(--dl-space-3);\n  text-align: left;\n}\n\nth {\n  color: var(--dl-color-text-secondary);\n  font-size: var(--dl-font-size-label);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dl-page {\n  min-height: 100vh;\n  padding: var(--dl-layout-page-padding);\n}\n\n.dl-container {\n  margin-inline: auto;\n  max-width: var(--dl-layout-content-max-width);\n  width: 100%;\n}\n\n.dl-section {\n  padding-block: var(--dl-layout-section-spacing);\n}\n\n.dl-stack {\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-stack-gap, var(--dl-space-4));\n}\n\n.dl-grid {\n  display: grid;\n  gap: var(--dl-layout-grid-gap);\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));\n}\n\n.dl-visually-hidden {\n  clip: rect(0 0 0 0);\n  border: 0;\n  height: 1px;\n  margin: -1px;\n  overflow: hidden;\n  padding: 0;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n.dl-button {\n  align-items: center;\n  border: var(--dl-border-width) solid transparent;\n  border-radius: var(--dl-radius-md);\n  position: relative;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: var(--dl-size-touch-target);\n  padding: 0 var(--dl-space-4);\n  transition:\n    background-color var(--dl-duration-fast) var(--dl-easing-standard),\n    border-color var(--dl-duration-fast) var(--dl-easing-standard),\n    color var(--dl-duration-fast) var(--dl-easing-standard);\n}\n\n.dl-button--small {\n  min-height: var(--dl-size-control-sm);\n  padding-inline: var(--dl-space-3);\n}\n\n.dl-button--medium {\n  min-height: var(--dl-size-touch-target);\n  padding-inline: var(--dl-space-4);\n}\n\n.dl-button--large {\n  min-height: var(--dl-size-control-lg);\n  padding-inline: var(--dl-space-5);\n}\n\n.dl-button--full {\n  width: 100%;\n}\n\n.dl-button__content {\n  align-items: center;\n  display: inline-flex;\n  gap: var(--dl-space-2);\n}\n\n.dl-button__content[data-loading=\"true\"] {\n  visibility: hidden;\n}\n\n.dl-button__icon {\n  display: inline-flex;\n}\n\n.dl-button__spinner,\n.dl-loading-state__spinner {\n  animation: dl-spin var(--dl-duration-normal) linear infinite;\n  box-sizing: border-box;\n  border: 2px solid currentColor;\n  border-right-color: transparent;\n  border-radius: var(--dl-radius-full);\n  display: block;\n  height: 1rem;\n  transform-origin: center;\n  width: 1rem;\n}\n\n.dl-button__spinner {\n  left: 50%;\n  position: absolute;\n  top: 50%;\n  animation-name: dl-spin-button;\n  transform: translate(-50%, -50%) rotate(0deg);\n}\n\n.dl-button--primary {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dl-button--primary:hover:not(:disabled) {\n  background: var(--dl-color-accent-hover);\n}\n\n.dl-button--secondary {\n  background: var(--dl-color-surface);\n  border-color: var(--dl-color-border);\n  color: var(--dl-color-text);\n}\n\n.dl-button--secondary:hover:not(:disabled) {\n  border-color: var(--dl-color-border-strong);\n}\n\n.dl-button--ghost {\n  background: transparent;\n  color: var(--dl-color-accent);\n}\n\n.dl-button--ghost:hover:not(:disabled) {\n  background: var(--dl-color-accent-subtle);\n}\n\n.dl-button--outline {\n  background: transparent;\n  border-color: var(--dl-color-accent);\n  color: var(--dl-color-accent);\n}\n\n.dl-button--outline:hover:not(:disabled) {\n  background: var(--dl-color-accent-subtle);\n}\n\n.dl-button--danger {\n  background: var(--dl-color-danger);\n  color: #ffffff;\n}\n\n.dl-button--danger:hover:not(:disabled) {\n  background: var(--dl-color-danger-strong);\n}\n\n.dl-icon-button {\n  aspect-ratio: 1;\n  padding: 0;\n}\n\n.dl-field,\n.dl-choice-field {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-field__label {\n  color: var(--dl-color-text-secondary);\n  font-size: var(--dl-font-size-label);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dl-field__label-row {\n  align-items: baseline;\n  display: inline-flex;\n  gap: var(--dl-space-1);\n}\n\n.dl-field__required {\n  color: var(--dl-color-danger);\n  font-size: var(--dl-font-size-label);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dl-field__description,\n.dl-choice__description {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.dl-field__error {\n  color: var(--dl-color-danger-foreground);\n  font-size: var(--dl-font-size-small);\n}\n\n.dl-control {\n  width: 100%;\n}\n\n.dl-form {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dl-form-section {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  margin: 0;\n  min-inline-size: 0;\n  padding: var(--dl-space-3);\n}\n\n.dl-form-section__legend {\n  color: var(--dl-color-text);\n  font-size: var(--dl-font-size-card-title);\n  font-weight: var(--dl-font-weight-bold);\n  padding-inline: 0;\n}\n\n.dl-form-section__description {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.dl-form-section__content {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.dl-form-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.dl-form-grid__full {\n  min-width: 0;\n}\n\n.dl-form-error-summary {\n  background: var(--dl-color-danger-background);\n  border: var(--dl-border-width) solid var(--dl-color-danger-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-danger-foreground);\n  display: grid;\n  gap: var(--dl-space-2);\n  padding: var(--dl-space-4);\n}\n\n.dl-form-error-summary__title {\n  color: var(--dl-color-danger-foreground);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dl-form-error-summary ul {\n  margin: 0;\n  padding-inline-start: var(--dl-space-5);\n}\n\n.dl-form-error-summary a {\n  color: var(--dl-color-danger-foreground);\n}\n\n.dl-form-actions,\n.dl-form-confirm-actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-space-3);\n}\n\n@media (min-width: 48rem) {\n  .dl-form-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .dl-form-grid__full {\n    grid-column: 1 / -1;\n  }\n\n  .dl-form-actions,\n  .dl-form-confirm-actions {\n    align-items: center;\n    flex-direction: row;\n    justify-content: flex-end;\n  }\n}\n\n.dl-choice,\n.dl-switch {\n  align-items: flex-start;\n  cursor: pointer;\n  display: inline-flex;\n  gap: var(--dl-space-3);\n  min-height: var(--dl-size-touch-target);\n}\n\n.dl-choice__input,\n.dl-switch__input {\n  height: 1px;\n  opacity: 0;\n  position: absolute;\n  width: 1px;\n}\n\n.dl-choice__box {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border-strong);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  flex: 0 0 auto;\n  height: 1.25rem;\n  justify-content: center;\n  margin-top: 0.125rem;\n  width: 1.25rem;\n}\n\n.dl-choice__box--radio {\n  border-radius: var(--dl-radius-full);\n}\n\n.dl-choice__input:focus-visible + .dl-choice__box,\n.dl-switch__input:focus-visible + .dl-switch__track {\n  box-shadow: var(--dl-shadow-focus);\n}\n\n.dl-choice__input:checked + .dl-choice__box {\n  background: var(--dl-color-accent);\n  border-color: var(--dl-color-accent);\n}\n\n.dl-choice__input:checked + .dl-choice__box::after {\n  background: #ffffff;\n  border-radius: var(--dl-radius-sm);\n  content: \"\";\n  height: 0.5rem;\n  width: 0.5rem;\n}\n\n.dl-choice__label {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-switch__track {\n  align-items: center;\n  background: var(--dl-color-neutral-border);\n  border-radius: 