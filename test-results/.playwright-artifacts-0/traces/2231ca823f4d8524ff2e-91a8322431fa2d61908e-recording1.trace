 {\n  border-top: 1px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-4);\n  padding-top: var(--dl-space-4);\n}\n\n.works-page__workflow h3,\n.works-page__timeline h4 {\n  margin: 0;\n}\n\n.works-page__workflow-header,\n.works-page__workflow-current {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__workflow-current {\n  background: var(--dl-color-background-secondary);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  padding: var(--dl-space-3);\n}\n\n.works-page__workflow-current > div,\n.works-page__assignment {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__assignment {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  padding: var(--dl-space-3);\n}\n\n.works-page__label {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-caption);\n  font-weight: var(--dl-font-weight-semibold);\n  text-transform: uppercase;\n}\n\n.works-page__stage-list,\n.works-page__timeline ol {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.works-page__stage-item {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.works-page__stage-item[data-current=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__stage-item > div:first-child,\n.works-page__timeline li {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  justify-content: space-between;\n}\n\n.works-page__timeline {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__responsibility {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__responsibility > div,\n.works-page__cycle-grid > div,\n.works-page__cycle-header > div,\n.works-page__return-summary > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-header,\n.works-page__return-summary {\n  align-items: start;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__cycle-list {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__cycle-item {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.works-page__cycle-item[data-active=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__cycle-title {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__cycle-title > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-title span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__cycle-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__patient-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__tab {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  min-height: 36px;\n  padding: 0 var(--dl-space-3);\n}\n\n.works-page__tab[aria-selected=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__lab-sheet {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.works-page__form-full {\n  grid-column: 1 / -1;\n}\n\n.works-page__timeline > div {\n  border-left: 3px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding-left: var(--dl-space-3);\n}\n\n.works-page__timeline > div span,\n.works-page__timeline > div p {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.works-page__timeline li {\n  border-left: 3px solid var(--dl-color-border);\n  padding-left: var(--dl-space-3);\n}\n\n@media (min-width: 720px) {\n  .works-page__summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__filters,\n  .works-page__form-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__deadline-card {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__responsibility {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-header,\n  .works-page__return-summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__detail-section-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (min-width: 1100px) {\n  .works-page__summary {\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__form .works-page__work-selection-grid {\n    grid-template-columns: minmax(0, 2fr) minmax(5rem, 0.7fr) minmax(6rem, 0.75fr);\n  }\n}\n\n.works-page__probe-history {\n  display: grid;\n  gap: 0.3rem;\n  margin: 0 0 1rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--dl-border, #d5e1df);\n  border-radius: 0.75rem;\n  background: var(--dl-surface-muted, #f5faf9);\n}\n\n.works-page__probe-history span {\n  color: var(--dl-text-muted, #647774);\n}\n\n.works-page__probe-type-options {\n  border: 0;\n  margin: var(--dl-space-3) 0 0;\n  padding: 0;\n}\n\n.works-page__probe-type-options legend {\n  font-weight: var(--dl-font-weight-semibold);\n  margin-bottom: var(--dl-space-2);\n}\n\n.works-page__probe-type-grid {\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));\n  margin-bottom: var(--dl-space-3);\n}\n\n.works-page__probe-type-card {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  min-height: 2.75rem;\n  padding: var(--dl-space-2) var(--dl-space-3);\n  text-align: left;\n}\n\n.works-page__probe-type-card:hover:not(:disabled),\n.works-page__probe-type-card:focus-visible {\n  border-color: var(--dl-color-accent);\n  outline: 3px solid var(--dl-color-focus-ring, var(--dl-color-accent));\n  outline-offset: 2px;\n}\n\n.works-page__probe-type-card--active {\n  background: var(--dl-color-success, #16803c);\n  border-color: var(--dl-color-success, #16803c);\n  color: #fff;\n}\n\n.works-page__probe-type-card span {\n  display: block;\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-normal);\n  margin-top: var(--dl-space-1);\n  opacity: 0.8;\n}\n"],["STYLE",{},".logistics-page {\n  min-height: 100%;\n  background: var(--color-background);\n}\n\n.logistics-page__layout {\n  display: grid;\n  gap: var(--space-5);\n  padding-block: var(--space-5);\n}\n\n.logistics-page__header {\n  display: grid;\n  gap: var(--space-4);\n}\n\n.logistics-page__header h1 {\n  margin: 0;\n  color: var(--color-foreground);\n  font-size: var(--font-size-3xl);\n}\n\n.logistics-page__header p {\n  margin: var(--space-1) 0 0;\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__route-overview {\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.logistics-page__route-overview > div {\n  align-items: center;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md, 8px);\n  display: flex;\n  gap: var(--space-3);\n  min-height: 64px;\n  padding: var(--space-3) var(--space-4);\n}\n\n.logistics-page__route-overview strong {\n  color: var(--color-primary);\n  font-size: 1.5rem;\n}\n\n.logistics-page__route-overview span {\n  color: var(--color-muted-foreground);\n  font-weight: 700;\n}\n\n.logistics-page__preparation-box {\n  align-items: center;\n  background: color-mix(in srgb, var(--color-primary) 7%, var(--color-surface));\n  border: 2px solid color-mix(in srgb, var(--color-primary) 28%, var(--color-border));\n  border-radius: var(--radius-md, 8px);\n  display: flex;\n  gap: var(--space-4);\n  justify-content: space-between;\n  padding: var(--space-4);\n}\n\n.logistics-page__preparation-box strong {\n  font-size: var(--font-size-lg);\n}\n\n.logistics-page__preparation-box p {\n  color: var(--color-muted-foreground);\n  margin: var(--space-1) 0 0;\n}\n\n.logistics-page__header-actions,\n.logistics-page__row-actions,\n.logistics-page__filters {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-3);\n}\n\n.logistics-page__summary {\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.logistics-page__summary > * {\n  --kpi-accent: var(--color-primary);\n  --kpi-accent-border: color-mix(in srgb, var(--kpi-accent) 28%, var(--color-border));\n  --kpi-accent-surface: color-mix(in srgb, var(--kpi-accent) 8%, var(--color-surface));\n  --kpi-accent-text: color-mix(in srgb, var(--kpi-accent) 78%, var(--color-foreground));\n}\n\n.logistics-page__summary > *:nth-child(6n + 1) {\n  --kpi-accent: var(--color-primary);\n}\n\n.logistics-page__summary > *:nth-child(6n + 2) {\n  --kpi-accent: #2563eb;\n}\n\n.logistics-page__summary > *:nth-child(6n + 3) {\n  --kpi-accent: #059669;\n}\n\n.logistics-page__summary > *:nth-child(6n + 4) {\n  --kpi-accent: #d97706;\n}\n\n.logistics-page__summary > *:nth-child(6n + 5) {\n  --kpi-accent: #e11d48;\n}\n\n.logistics-page__summary > *:nth-child(6n) {\n  --kpi-accent: #7c3aed;\n}\n\n.logistics-page__summary-card {\n  align-items: center;\n  display: grid;\n  justify-items: center;\n  min-height: 112px;\n  border: 1px solid var(--kpi-accent-border, #cbd5e1);\n  border-radius: var(--radius-md, 8px);\n  background: var(--kpi-accent-surface, #ffffff);\n  color: var(--color-foreground);\n  overflow: hidden;\n  padding: calc(var(--space-3) + 0.15rem) var(--space-3) var(--space-3);\n  text-align: center;\n  position: relative;\n}\n\n.logistics-page__summary-card::before {\n  background: var(--kpi-accent);\n  content: \"\";\n  inset: 0 auto auto 0;\n  height: 0.35rem;\n  position: absolute;\n  width: 100%;\n}\n\n.logistics-page__summary-card-main {\n  appearance: none;\n  background: transparent;\n  border: 0;\n  color: inherit;\n  cursor: pointer;\n  display: grid;\n  font: inherit;\n  padding: 0;\n  justify-items: center;\n  text-align: center;\n  width: 100%;\n}\n\n.logistics-page__summary-card-main span {\n  display: block;\n  color: #111827;\n  font-size: var(--font-size-sm);\n  font-weight: 700;\n}\n\n.logistics-page__summary-card-main strong {\n  display: block;\n  color: var(--kpi-accent-text);\n  margin-top: var(--space-2);\n  font-size: clamp(1.45rem, 2vw, 2.1rem);\n  line-height: 1.05;\n}\n\n.logistics-page__summary-card.is-active {\n  border-color: var(--color-primary);\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 22%, transparent);\n}\n\n.logistics-page__summary-window {\n  justify-content: center;\n  display: flex;\n  gap: var(--space-2);\n  margin-top: var(--space-3);\n}\n\n.logistics-page__summary-window button {\n  align-items: center;\n  background: var(--color-surface);\n  border: 1px solid var(--kpi-accent-border);\n  border-radius: var(--radius-sm);\n  color: var(--color-foreground);\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  height: 44px;\n  justify-content: center;\n  min-width: 44px;\n  padding: 0 var(--space-2);\n}\n\n.logistics-page__summary-window button.is-active {\n  background: var(--kpi-accent);\n  border-color: var(--kpi-accent);\n  color: #fff;\n}\n\n.logistics-page__day-filters,\n.logistics-page__bulk-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n}\n\n.logistics-page__day-filters button,\n.logistics-page__action-toggle {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  min-height: 40px;\n  min-width: 40px;\n  padding: 0 var(--space-3);\n}\n\n.logistics-page__day-filters button[aria-pressed=\"true\"],\n.logistics-page__action-toggle.is-active {\n  background: var(--color-primary);\n  color: var(--color-primary-foreground);\n}\n\n.logistics-page__marker {\n  aspect-ratio: 1;\n  background: var(--color-surface, #ffffff);\n  border: 2px solid var(--color-border, #64748b);\n  box-sizing: border-box;\n  border-radius: 50%;\n  height: 24px;\n  max-height: 24px;\n  max-width: 24px;\n  min-height: 24px;\n  min-width: 24px;\n  padding: 0;\n  width: 24px;\n  flex: 0 0 24px;\n}\n\n.logistics-page__marker--MARKER_1 { background: #d94a4a; }\n.logistics-page__marker--MARKER_2 { background: #e6a23c; }\n.logistics-page__marker--MARKER_3 { background: #4cae6b; }\n.logistics-page__marker--MARKER_4 { background: #478bd1; }\n.logistics-page__marker--MARKER_5 { background: #20252b; }\n.logistics-page__marker--none { background: transparent; border-color: var(--color-border, #64748b); }\n.logistics-page__marker--none:hover,\n.logistics-page__marker--none:focus-visible {\n  background: transparent;\n}\n.logistics-page__marker-menu {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  box-shadow: var(--shadow-md);\n  display: flex;\n  gap: var(--space-1);\n  left: 42px;\n  padding: var(--space-2);\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 3;\n}\n\n.logistics-page__select-all {\n  align-items: center;\n  color: var(--color-muted-foreground);\n  display: flex;\n  font-size: var(--font-size-sm);\n  gap: var(--space-2);\n  min-height: 32px;\n}\n\n.logistics-page__select-all input,\n.logistics-page__row > input {\n  accent-color: var(--color-primary);\n  height: 16px;\n  margin: 0;\n  width: 16px;\n}\n\n.logistics-page__card-header-row {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-3);\n  justify-content: space-between;\n}\n\n.logistics-page__content,\n.logistics-page__groups,\n.logistics-page__drawer,\n.logistics-page__attachments {\n  display: grid;\n  gap: var(--space-4);\n}\n\n.logistics-page__route-grid {\n  display: grid;\n  gap: var(--space-4);\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.logistics-page__route-grid > .dl-card {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  height: 360px;\n  min-width: 0;\n  min-height: 0;\n}\n\n.logistics-page__route-candidates,\n.logistics-page__route-stops {\n  align-content: start;\n  display: grid;\n  gap: var(--space-2);\n  min-height: 0;\n  overflow-y: auto;\n}\n\n.logistics-page__route-candidates button {\n  height: 56px;\n  justify-content: flex-start;\n  min-height: 56px;\n  overflow: hidden;\n  white-space: normal;\n}\n\n.logistics-page__candidate-item {\n  display: grid;\n  gap: var(--space-1);\n}\n\n.logistics-page__candidate-alert,\n.logistics-page__route-contact-alert {\n  color: var(--color-danger, #b42318);\n  font-size: var(--text-xs, 0.75rem);\n  font-weight: 600;\n}\n\n.logistics-page__route-contact-input--missing {\n  border-color: var(--color-danger, #b42318);\n  box-shadow: 0 0 0 1px var(--color-danger, #b42318);\n}\n\n.logistics-page__route-contact-alert {\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.logistics-page__preparation-stops {\n  display: grid;\n  gap: var(--space-2);\n  margin-top: var(--space-3);\n}\n\n.logistics-page__preparation-stop {\n  align-items: center;\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: auto minmax(0, 1fr) auto;\n}\n\n.logistics-page__preparation-stop span {\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__route-stop {\n  align-items: center;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: auto auto 1fr auto;\n  padding: var(--space-4);\n}\n\n.logistics-page__route-stop-section {\n  display: grid;\n  gap: var(--space-2);\n}\n\n.logistics-page__route-stop-section h4 {\n  margin: 0;\n  font-size: 0.82rem;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.logistics-page__route-location {\n  display: block;\n  margin: var(--space-2) 0 var(--space-1);\n  color: var(--color-text-muted);\n  font-size: 0.82rem;\n}\n\n.logistics-page__route-stop > span {\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__route-stop p {\n  margin: 0;\n}\n\n.logistics-page__route-stop-contact {\n  align-items: center;\n  display: grid;\n  gap: var(--space-2);\n  grid-column: 1 / -1;\n  grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.7fr);\n}\n\n.logistics-page__group-actions,\n.logistics-page__print-actions {\n  align-items: center;\n  display: flex;\n  gap: var(--space-4);\n}\n\n.logistics-page__assign-controls {\n  align-items: end;\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: minmax(220px, 1fr) auto;\n  flex: 1 1 460px;\n  min-width: min(100%, 420px);\n}\n\n.logistics-page__assign-controls > .dl-field {\n  min-width: 0;\n}\n\n.logistics-page__group-actions > button {\n  white-space: nowrap;\n}\n\n.logistics-page__route-section-title {\n  border-bottom: 1px solid var(--color-border);\n  color: var(--color-foreground);\n  margin: var(--space-3) 0 0;\n  padding-bottom: var(--space-2);\n}\n\n.logistics-page__group-actions .dl-icon-button,\n.logistics-page__print-actions .dl-icon-button {\n  height: 48px;\n  width: 48px;\n}\n\n.logistics-page__route-stop-actions {\n  display: grid;\n  gap: var(--space-2);\n  grid-column: 1 / -1;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n}\n\n.logistics-page__route-execution {\n  display: grid;\n  gap: 12px;\n  margin-top: 12px;\n  padding: 14px;\n  border: 1px solid var(--dl-border, #d8dfdc);\n  border-radius: 10px;\n}\n\n.logistics-page__empty {\n  color: var(--color-muted-foreground);\n  margin: 0;\n}\n\n/* The courier workflow is used primarily on a phone. Keep each stop readable\n   and make the two outcome actions easy to tap without horizontal scrolling. */\n.logistics-page--courier .logistics-page__layout {\n  gap: var(--space-4);\n  padding-block: var(--space-3);\n}\n\n.logistics-page--courier .logistics-page__header h1 {\n  font-size: var(--font-size-2xl);\n}\n\n.logistics-page--courier .logistics-page__header p {\n  font-size: 0.95rem;\n}\n\n.logistics-page--courier .logistics-page__route-stop {\n  align-items: stretch;\n  grid-template-columns: auto 1fr;\n  padding: var(--space-3);\n}\n\n.logistics-page--courier .logistics-page__route-stop p,\n.logistics-page--courier .logistics-page__route-stop .dl-status-badge {\n  grid-column: 1 / -1;\n}\n\n.logistics-page--courier .logistics-page__route-stop-contact-summary {\n  color: var(--color-muted-foreground);\n  display: grid;\n  font-size: .9rem;\n  gap: .2rem;\n  grid-column: 1 / -1;\n}\n\n.logistics-page__route-stop--current { border-color: var(--color-primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 16%, transparent); }\n.logistics-page__route-stop-current { color: var(--color-primary) !important; font-size: .78rem; font-weight: 800; text-transform: uppercase; }\n.logistics-page__route-progress { background: color-mix(in srgb, var(--color-border) 55%, transparent); border-radius: 999px; display: grid; gap: .35rem; grid-column: 1 / -1; height: .45rem; overflow: visible; }\n.logistics-page__route-progress span { background: var(--color-primary); border-radius: inherit; display: block; height: 100%; }\n.logistics-page__route-progress small { color: var(--color-muted-foreground); font-size: .78rem; margin-top: .2rem; }\n\n.logistics-page--courier .logistics-page__route-stop-actions {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.logistics-page--courier .logistics-page__route-stop-actions .dl-field {\n  grid-column: 1 / -1;\n  width: 100%;\n}\n\n.logistics-page--courier .logistics-page__route-stop-actions button {\n  width: 100%;\n}\n\n.logistics-page__route-waiting {\n  color: var(--color-muted-foreground);\n  margin: 0;\n}\n\n.logistics-page__attachments {\n  border-top: 1px solid var(--color-border);\n  margin-top: var(--space-5);\n  padding-top: var(--space-5);\n}\n\n.logistics-page__attachments h3 {\n  margin: 0;\n  color: var(--color-foreground);\n  font-size: var(--font-size-lg);\n}\n\n.logistics-page__attachments p {\n  margin: var(--space-1) 0 0;\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__dropzone {\n  align-items: center;\n  border: 1px dashed var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-3);\n  justify-content: space-between;\n  min-height: 92px;\n  padding: var(--space-4);\n}\n\n.logistics-page__dropzone label {\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-foreground);\n  cursor: pointer;\n  font-weight: 700;\n  padding: var(--space-2) var(--space-3);\n}\n\n.logistics-page__dropzone input {\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  height: 1px;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n.logistics-page__attachment-error {\n  color: var(--dl-color-danger-foreground);\n  font-weight: 700;\n}\n\n.logistics-page__attachment-list {\n  display: grid;\n  gap: var(--space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.logistics-page__attachment-list li {\n  align-items: center;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  padding: var(--space-3);\n}\n\n.logistics-page__attachment-list span {\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__attachment-list small {\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__pickup-form {\n  display: grid;\n  gap: var(--space-4);\n}\n\n@media (min-width: 48rem) {\n  .logistics-page__pickup-form {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .logistics-page__pickup-form > :nth-child(5),\n  .logistics-page__pickup-form > :nth-child(6) {\n    align-self: end;\n  }\n\n  .logistics-page__pickup-form > :nth-child(7) {\n    grid-column: 1 / -1;\n  }\n\n  .logistics-page__pickup-form > .logistics-page__pickup-range {\n    max-width: none;\n  }\n}\n\n.logistics-page__pickup-form > .logistics-page__choice-field,\n.logistics-page__pickup-form > .dl-field,\n.logistics-page__pickup-form > .logistics-page__pickup-range {\n  max-width: 100%;\n}\n\n.logistics-page__pickup-form > .logistics-page__choice-field {\n  max-width: 24rem;\n}\n\n.logistics-page__pickup-contact {\n  max-width: 24rem;\n}\n\n.logistics-page__pickup-range {\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  max-width: 390px;\n}\n\n/* Keep the empty native date control clean while preserving its calendar button. */\n.logistics-page__pickup-date-picker:invalid::-webkit-datetime-edit {\n  color: transparent;\n}\n\n.logistics-page__pickup-date-picker:focus::-webkit-datetime-edit,\n.logistics-page__pickup-date-picker:not(:invalid)::-webkit-datetime-edit {\n  color: inherit;\n}\n\n.logistics-page__pickup-date-picker,\n.logistics-page__pickup-time-picker {\n  min-width: 0;\n  padding-left: 2.25rem;\n  position: relative;\n}\n\n.logistics-page__pickup-date-picker {\n  max-width: 190px;\n}\n\n.logistics-page__pickup-date-picker::-webkit-calendar-picker-indicator,\n.logistics-page__pickup-time-picker::-webkit-calendar-picker-indicator {\n  cursor: pointer;\n  height: 1.1rem;\n  left: 0.75rem;\n  margin: 0;\n  position: absolute;\n  width: 1.1rem;\n}\n\n.logistics-page__pickup-time-picker:invalid::-webkit-datetime-edit {\n  color: transparent;\n}\n\n.logistics-page__pickup-time-picker:focus::-webkit-datetime-edit {\n  color: inherit;\n}\n\n.logistics-page__pickup-time-picker:not(:invalid)::-webkit-datetime-edit {\n  color: inherit;\n}\n\n.logistics-page__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  overflow: visible;\n  padding-bottom: 0;\n}\n\n.logistics-page__tabs button {\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  color: var(--color-muted-foreground);\n  cursor: pointer;\n  font: inherit;\n  flex: 0 1 auto;\n  min-height: 40px;\n  padding: var(--space-2) var(--space-3);\n  white-space: normal;\n}\n\n.logistics-page__tabs button[aria-pressed=\"true\"] {\n  border-color: var(--color-primary);\n  background: var(--color-primary-soft);\n  color: var(--color-primary);\n  font-weight: 700;\n}\n\n.logistics-page__filters > * {\n  min-width: min(100%, 220px);\n  flex: 1;\n}\n\n.logistics-page__filters {\n  align-items: end;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  padding: var(--space-3);\n}\n\n.logistics-page__list {\n  display: grid;\n  gap: var(--space-3);\n}\n\n.logistics-page__table-header {\n  align-items: end;\n  color: var(--color-muted-foreground);\n  display: grid;\n  font-size: var(--font-size-xs);\n  font-weight: 700;\n  gap: var(--space-3);\n  grid-template-columns: 20px repeat(10, minmax(0, 1fr));\n  padding: 0 var(--space-3) var(--space-2);\n}\n\n.logistics-page__row,\n.logistics-page__group {\n  display: grid;\n  gap: var(--space-4);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  padding: var(--space-4);\n}\n\n.logistics-page__row {\n  align-items: center;\n  grid-template-columns: 20px repeat(10, minmax(0, 1fr));\n  padding: var(--space-3);\n  position: relative;\n}\n\n.logistics-page__row.is-selected {\n  background: color-mix(in srgb, var(--color-primary) 5%, var(--color-surface));\n  border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));\n}\n\n.logistics-page__row-main {\n  display: grid;\n  gap: var(--space-1);\n  border: 0;\n  background: transparent;\n  color: inherit;\n  cursor: pointer;\n  font: inherit;\n  padding: 0;\n  text-align: left;\n}\n\n.logistics-page__row-place,\n.logistics-page__row-type,\n.logistics-page__row-value {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__row-place strong,\n.logistics-page__row-type {\n  color: var(--color-foreground);\n  font-size: var(--font-size-sm);\n}\n\n.logistics-page__row-place span {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-xs);\n}\n\n.logistics-page__row-value {\n  color: var(--color-foreground);\n  font-size: var(--font-size-sm);\n}\n\n.logistics-page__row-value--overdue {\n  align-items: center;\n  display: flex;\n  gap: var(--space-2);\n}\n\n.logistics-page__overdue-alert {\n  color: var(--color-danger, #dc2626);\n  font-size: 1.35rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\n.logistics-page__choice-field {\n  display: grid;\n  gap: var(--space-1);\n  position: relative;\n}\n\n.logistics-page__choice-label {\n  color: var(--color-foreground);\n  font-size: var(--font-size-sm);\n  font-weight: 700;\n}\n\n.logistics-page__choice-control {\n  display: grid;\n  gap: var(--space-2);\n  position: relative;\n}\n\n.logistics-page__choice-input {\n  width: 100%;\n}\n\n.logistics-page__choice-menu {\n  background: #fff;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-lg, 0 12px 30px rgb(15 23 42 / 16%));\n  display: grid;\n  gap: 2px;\n  -webkit-overflow-scrolling: touch;\n  max-height: 280px;\n  overflow: auto;\n  padding: var(--space-1);\n  position: relative;\n  width: 100%;\n}\n\n.logistics-page__choice-option {\n  background: transparent;\n  border: 0;\n  border-radius: var(--radius-sm);\n  color: var(--color-foreground);\n  cursor: pointer;\n  display: grid;\n  gap: 2px;\n  line-height: 1.25;\n  min-height: 48px;\n  padding: var(--space-2) var(--space-3);\n  text-align: left;\n  width: 100%;\n}\n\n.logistics-page__choice-option strong,\n.logistics-page__choice-option span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__choice-option:hover,\n.logistics-page__choice-option:focus-visible {\n  background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface));\n  outline: none;\n}\n\n.logistics-page__choice-option span,\n.logistics-page__choice-hint,\n.logistics-page__choice-empty {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-xs);\n}\n\n.logistics-page__choice-hint,\n.logistics-page__choice-error {\n  display: block;\n}\n\n.logistics-page__choice-error {\n  color: var(--color-danger, #dc2626);\n  font-size: var(--font-size-xs);\n}\n\n.logistics-page__choice-empty {\n  padding: var(--space-3);\n}\n\n.logistics-page__row-technician {\n  align-items: center;\n  color: var(--color-foreground);\n  display: flex;\n  font-size: var(--font-size-sm);\n  gap: var(--space-2);\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__technician-dot {\n  border: 1px solid var(--color-border);\n  border-radius: 50%;\n  flex: 0 0 12px;\n  height: 12px;\n  width: 12px;\n}\n\n.logistics-page__row-main:hover .logistics-page__code,\n.logistics-page__row-main:focus-visible .logistics-page__code {\n  color: var(--color-primary);\n}\n\n.logistics-page__row-main strong,\n.logistics-page__code {\n  color: var(--color-foreground);\n  font-weight: 800;\n}\n\n.logistics-page__row-main span,\n.logistics-page__row-meta,\n.logistics-page__group > .logistics-page__print-route-header > span,\n.logistics-page__group > .logistics-page__screen-only,\n.logistics-page__group .logistics-page__print-stops > li > span,\n.logistics-page__drawer p {\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__row-meta {\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  font-size: var(--font-size-sm);\n}\n\n.logistics-page__row-state,\n.logistics-page__row-alerts {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  min-width: 0;\n}\n\n.logistics-page__row-alerts {\n  position: relative;\n}\n\n.logistics-page__row-requirements {\n  align-items: start;\n  display: grid;\n  gap: var(--space-2);\n}\n\n.logistics-page__requirement {\n  align-items: center;\n  display: flex;\n  gap: var(--space-2);\n  white-space: nowrap;\n}\n\n.logistics-page__row-state .dl-field {\n  margin: 0;\n  min-width: 148px;\n}\n\n.logistics-page__row-state .dl-control {\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  min-height: 40px;\n}\n\n.logistics-page__state-picker {\n  min-width: 148px;\n  position: relative;\n}\n\n.logistics-page__state-picker-trigger {\n  align-items: center;\n  background: var(--color-surface, #ffffff);\n  border: 1px solid var(--color-border, #d5dedb);\n  border-radius: var(--radius-sm);\n  color: var(--color-text, #1b2522);\n  display: flex;\n  font-weight: 600;\n  justify-content: space-between;\n  min-height: 40px;\n  padding: 0 var(--space-3);\n  width: 100%;\n}\n\n.logistics-page__state-picker-trigger:hover,\n.logistics-page__state-picker-trigger[aria-expanded=\"true\"] {\n  border-color: var(--color-primary, #0f766e);\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary, #0f766e) 14%, 