generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  displayName       String     @map("display_name")
  isActive          Boolean    @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  version           Int        @default(1)
  sessions          Session[]
  auditLogs         AuditLog[] @relation("AuditActor")
  roles             UserRole[] @relation("UserRoles")
  assignedUserRoles UserRole[] @relation("AssignedUserRoles")
  permissionOverrides UserPermissionOverride[] @relation("UserPermissionOverrides")
  assignedPermissionOverrides UserPermissionOverride[] @relation("AssignedPermissionOverrides")
  updatedLaboratorySettings LaboratorySettings[] @relation("LaboratorySettingsUpdatedBy")
  createdClinics Clinic[] @relation("ClinicCreatedBy")
  updatedClinics Clinic[] @relation("ClinicUpdatedBy")
  archivedClinics Clinic[] @relation("ClinicArchivedBy")
  createdWorkTypes WorkType[] @relation("WorkTypeCreatedBy")
  updatedWorkTypes WorkType[] @relation("WorkTypeUpdatedBy")
  archivedWorkTypes WorkType[] @relation("WorkTypeArchivedBy")
  createdWorkOrders WorkOrder[] @relation("WorkOrderCreatedBy")
  updatedWorkOrders WorkOrder[] @relation("WorkOrderUpdatedBy")
  createdBillingDocuments BillingDocument[] @relation("BillingDocumentCreatedBy")
  updatedBillingDocuments BillingDocument[] @relation("BillingDocumentUpdatedBy")
  issuedBillingDocuments BillingDocument[] @relation("BillingDocumentIssuedBy")
  cancelledBillingDocuments BillingDocument[] @relation("BillingDocumentCancelledBy")
  createdPayments Payment[] @relation("PaymentCreatedBy")
  cancelledPayments Payment[] @relation("PaymentCancelledBy")
  createdWorkFormTemplates WorkFormTemplate[] @relation("WorkFormTemplateCreatedBy")
  updatedWorkFormTemplates WorkFormTemplate[] @relation("WorkFormTemplateUpdatedBy")
  activatedWorkFormTemplates WorkFormTemplate[] @relation("WorkFormTemplateActivatedBy")
  archivedWorkFormTemplates WorkFormTemplate[] @relation("WorkFormTemplateArchivedBy")
  submittedWorkFormSubmissions WorkFormSubmission[] @relation("WorkFormSubmissionSubmittedBy")
  updatedWorkFormSubmissions WorkFormSubmission[] @relation("WorkFormSubmissionUpdatedBy")
  createdWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateCreatedBy")
  updatedWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateUpdatedBy")
  activatedWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateActivatedBy")
  archivedWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateArchivedBy")
  startedWorkStages WorkStageExecution[] @relation("WorkStageStartedBy")
  completedWorkStages WorkStageExecution[] @relation("WorkStageCompletedBy")
  assignedWorkStages WorkStageExecution[] @relation("WorkStageAssignedTo")
  assignedByWorkStages WorkStageExecution[] @relation("WorkStageAssignedBy")
  workflowStageEvents WorkStageEvent[] @relation("WorkStageEventActor")

  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model LaboratorySettings {
  id                        String   @id @default(cuid())
  key                       String   @unique @default("default")
  laboratoryName            String   @map("laboratory_name") @db.VarChar(120)
  legalName                 String?  @map("legal_name") @db.VarChar(160)
  companyRegistrationNumber String?  @map("company_registration_number") @db.VarChar(80)
  taxId                     String?  @map("tax_id") @db.VarChar(80)
  email                     String?  @db.VarChar(254)
  phone                     String?  @db.VarChar(40)
  website                   String?  @db.VarChar(2048)
  addressLine1              String?  @map("address_line_1") @db.VarChar(160)
  addressLine2              String?  @map("address_line_2") @db.VarChar(160)
  city                      String?  @db.VarChar(100)
  countyOrRegion            String?  @map("county_or_region") @db.VarChar(100)
  postalCode                String?  @map("postal_code") @db.VarChar(20)
  countryCode               String   @default("RO") @map("country_code") @db.Char(2)
  timezone                  String   @default("Europe/Bucharest") @db.VarChar(64)
  locale                    String   @default("ro-RO") @db.VarChar(12)
  currency                  String   @default("RON") @db.Char(3)
  logoFileKey               String?  @map("logo_file_key") @db.VarChar(512)
  primaryColor              String   @default("#0f766e") @map("primary_color") @db.Char(7)
  documentFooter            String?  @map("document_footer") @db.VarChar(500)
  updatedByUserId           String?  @map("updated_by_user_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  updatedBy                 User?    @relation("LaboratorySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("laboratory_settings")
}

model Clinic {
  id String @id @default(cuid())
  code String @unique @db.VarChar(20)
  name String @db.VarChar(160)
  legalName String? @map("legal_name") @db.VarChar(160)
  taxId String? @map("tax_id") @db.VarChar(80)
  registrationNumber String? @map("registration_number") @db.VarChar(80)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  website String? @db.VarChar(2048)
  contactPersonName String? @map("contact_person_name") @db.VarChar(120)
  contactPersonRole String? @map("contact_person_role") @db.VarChar(80)
  contactPersonEmail String? @map("contact_person_email") @db.VarChar(254)
  contactPersonPhone String? @map("contact_person_phone") @db.VarChar(40)
  addressLine1 String? @map("address_line_1") @db.VarChar(160)
  addressLine2 String? @map("address_line_2") @db.VarChar(160)
  city String? @db.VarChar(100)
  countyOrRegion String? @map("county_or_region") @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(20)
  countryCode String @default("RO") @map("country_code") @db.Char(2)
  billingName String? @map("billing_name") @db.VarChar(160)
  billingTaxId String? @map("billing_tax_id") @db.VarChar(80)
  billingRegistrationNumber String? @map("billing_registration_number") @db.VarChar(80)
  billingAddressLine1 String? @map("billing_address_line_1") @db.VarChar(160)
  billingAddressLine2 String? @map("billing_address_line_2") @db.VarChar(160)
  billingCity String? @map("billing_city") @db.VarChar(100)
  billingCountyOrRegion String? @map("billing_county_or_region") @db.VarChar(100)
  billingPostalCode String? @map("billing_postal_code") @db.VarChar(20)
  billingCountryCode String @default("RO") @map("billing_country_code") @db.Char(2)
  internalNotes String? @map("internal_notes") @db.VarChar(2000)
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  archivedByUserId String? @map("archived_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  doctors Doctor[]
  workOrders WorkOrder[]
  billingDocuments BillingDocument[]
  payments Payment[]
  createdBy User? @relation("ClinicCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ClinicUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy User? @relation("ClinicArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([city])
  @@index([isActive])
  @@index([createdAt])
  @@index([taxId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("clinics")
}

model Doctor {
  id String @id @default(cuid())
  clinicId String @map("clinic_id")
  firstName String @map("first_name") @db.VarChar(80)
  lastName String @map("last_name") @db.VarChar(80)
  displayName String @map("display_name") @db.VarChar(180)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  professionalCode String? @map("professional_code") @db.VarChar(80)
  internalNotes String? @map("internal_notes") @db.VarChar(2000)
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  workOrders WorkOrder[]
  billingDocuments BillingDocument[]

  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("doctors")
}

model WorkType {
  id String @id @default(cuid())
  code String @unique @db.VarChar(20)
  name String @db.VarChar(160)
  description String? @db.VarChar(1000)
  basePriceMinor Int @map("base_price_minor")
  unit WorkTypeUnit @default(UNIT)
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  archivedByUserId String? @map("archived_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  createdBy User? @relation("WorkTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WorkTypeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy User? @relation("WorkTypeArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  workOrders WorkOrder[]
  formTemplates WorkFormTemplate[]
  workflowTemplates WorkflowTemplate[]

  @@index([name])
  @@index([basePriceMinor])
  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("work_types")
}

enum WorkTypeUnit {
  UNIT
}

model WorkFormTemplate {
  id String @id @default(cuid())
  workTypeId String @map("work_type_id")
  name String @db.VarChar(160)
  description String? @db.VarChar(1000)
  version Int
  status WorkFormTemplateStatus @default(DRAFT)
  activatedAt DateTime? @map("activated_at")
  archivedAt DateTime? @map("archived_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  activatedByUserId String? @map("activated_by_user_id")
  archivedByUserId String? @map("archived_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workType WorkType @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("WorkFormTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WorkFormTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  activatedBy User? @relation("WorkFormTemplateActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  archivedBy User? @relation("WorkFormTemplateArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  fields WorkFormFieldDefinition[]
  submissions WorkFormSubmission[]

  @@unique([workTypeId, version])
  @@index([workTypeId])
  @@index([status])
  @@index([workTypeId, status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([activatedByUserId])
  @@index([archivedByUserId])
  @@map("work_form_templates")
}

model WorkFormFieldDefinition {
  id String @id @default(cuid())
  templateId String @map("template_id")
  key String @db.VarChar(64)
  label String @db.VarChar(160)
  helpText String? @map("help_text") @db.VarChar(500)
  type WorkFormFieldType
  required Boolean @default(false)
  sortOrder Int @map("sort_order")
  placeholder String? @db.VarChar(160)
  defaultValue Json? @map("default_value")
  options Json?
  validation Json?
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  template WorkFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
  @@map("work_form_field_definitions")
}

enum WorkFormTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkFormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  CHECKBOX
  RADIO
  SELECT
  MULTISELECT
  TOOTH
  SHADE
}

model WorkflowTemplate {
  id String @id @default(cuid())
  workTypeId String @map("work_type_id")
  name String @db.VarChar(160)
  description String? @db.VarChar(1000)
  version Int
  status WorkflowTemplateStatus @default(DRAFT)
  activatedAt DateTime? @map("activated_at")
  archivedAt DateTime? @map("archived_at")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  activatedByUserId String? @map("activated_by_user_id")
  archivedByUserId String? @map("archived_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workType WorkType @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("WorkflowTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WorkflowTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  activatedBy User? @relation("WorkflowTemplateActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  archivedBy User? @relation("WorkflowTemplateArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  stages WorkflowStageDefinition[]
  executions WorkWorkflowExecution[]

  @@unique([workTypeId, version])
  @@index([workTypeId])
  @@index([status])
  @@index([workTypeId, status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([activatedByUserId])
  @@index([archivedByUserId])
  @@map("workflow_templates")
}

model WorkflowStageDefinition {
  id String @id @default(cuid())
  workflowTemplateId String @map("workflow_template_id")
  key String @db.VarChar(64)
  name String @db.VarChar(160)
  description String? @db.VarChar(1000)
  sortOrder Int @map("sort_order")
  estimatedDurationMinutes Int? @map("estimated_duration_minutes")
  allowedRoleCodes Json @map("allowed_role_codes")
  isInitial Boolean @default(false) @map("is_initial")
  isFinal Boolean @default(false) @map("is_final")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  executions WorkStageExecution[]

  @@unique([workflowTemplateId, key])
  @@index([workflowTemplateId, sortOrder])
  @@map("workflow_stage_definitions")
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model WorkOrder {
  id String @id @default(cuid())
  code String @unique @db.VarChar(24)
  clinicId String @map("clinic_id")
  doctorId String @map("doctor_id")
  workTypeId String @map("work_type_id")
  patientName String @map("patient_name") @db.VarChar(120)
  patientReference String? @map("patient_reference") @db.VarChar(80)
  qrToken String @unique @map("qr_token") @db.VarChar(64)
  qrCreatedAt DateTime @default(now()) @map("qr_created_at")
  quantity Int @default(1)
  baseUnitPriceMinor Int @map("base_unit_price_minor")
  totalPriceMinor Int @map("total_price_minor")
  currency String @db.Char(3)
  priority WorkPriority @default(NORMAL)
  status WorkStatus @default(REGISTERED)
  requestedDeliveryDate DateTime @map("requested_delivery_date")
  externalReference String? @map("external_reference") @db.VarChar(120)
  internalNotes String? @map("internal_notes") @db.VarChar(2000)
  clinicalNotes String? @map("clinical_notes") @db.VarChar(2000)
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  invoicedDocumentId String? @map("invoiced_document_id")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workType WorkType @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WorkOrderUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  billingLines BillingDocumentLine[]
  invoicedDocument BillingDocument? @relation("WorkOrderInvoicedDocument", fields: [invoicedDocumentId], references: [id], onDelete: SetNull)
  workFormSubmission WorkFormSubmission?
  workflowExecution WorkWorkflowExecution?

  @@index([clinicId])
  @@index([doctorId])
  @@index([workTypeId])
  @@index([qrCreatedAt])
  @@index([status])
  @@index([priority])
  @@index([requestedDeliveryDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([invoicedDocumentId])
  @@map("work_orders")
}

model WorkFormSubmission {
  id String @id @default(cuid())
  workOrderId String @unique @map("work_order_id")
  templateId String? @map("template_id")
  templateVersion Int @map("template_version")
  templateNameSnapshot String @map("template_name_snapshot") @db.VarChar(160)
  schemaSnapshot Json @map("schema_snapshot")
  values Json
  submittedAt DateTime @default(now()) @map("submitted_at")
  submittedByUserId String? @map("submitted_by_user_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedByUserId String? @map("updated_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  template WorkFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  submittedBy User? @relation("WorkFormSubmissionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WorkFormSubmissionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([templateVersion])
  @@index([submittedByUserId])
  @@index([updatedByUserId])
  @@index([createdAt])
  @@map("work_form_submissions")
}

model BillingDocument {
  id String @id @default(cuid())
  type BillingDocumentType
  status BillingDocumentStatus @default(DRAFT)
  series String? @db.VarChar(24)
  number Int? @map("number")
  formattedNumber String? @map("formatted_number") @db.VarChar(40)
  issueDate DateTime @map("issue_date")
  dueDate DateTime? @map("due_date")
  clinicId String @map("clinic_id")
  doctorId String? @map("doctor_id")
  clinicNameSnapshot String @map("clinic_name_snapshot") @db.VarChar(160)
  clinicLegalNameSnapshot String? @map("clinic_legal_name_snapshot") @db.VarChar(160)
  clinicTaxIdSnapshot String? @map("clinic_tax_id_snapshot") @db.VarChar(80)
  clinicRegistrationNumberSnapshot String? @map("clinic_registration_number_snapshot") @db.VarChar(80)
  clinicAddressSnapshot String? @map("clinic_address_snapshot") @db.VarChar(500)
  clinicEmailSnapshot String? @map("clinic_email_snapshot") @db.VarChar(254)
  clinicPhoneSnapshot String? @map("clinic_phone_snapshot") @db.VarChar(40)
  currency String @db.Char(3)
  subtotalMinor Int @default(0) @map("subtotal_minor")
  discountMinor Int @default(0) @map("discount_minor")
  taxMinor Int @default(0) @map("tax_minor")
  totalMinor Int @default(0) @map("total_minor")
  notes String? @db.VarChar(2000)
  cancelledAt DateTime? @map("cancelled_at")
  cancelledByUserId String? @map("cancelled_by_user_id")
  issuedAt DateTime? @map("issued_at")
  issuedByUserId String? @map("issued_by_user_id")
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy User? @relation("BillingDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BillingDocumentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  issuedBy User? @relation("BillingDocumentIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("BillingDocumentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  lines BillingDocumentLine[]
  payments Payment[]
  invoicedWorkOrders WorkOrder[] @relation("WorkOrderInvoicedDocument")

  @@unique([type, series, number])
  @@index([clinicId])
  @@index([doctorId])
  @@index([type])
  @@index([status])
  @@index([issueDate])
  @@index([formattedNumber])
  @@index([createdAt])
  @@index([cancelledAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([issuedByUserId])
  @@index([cancelledByUserId])
  @@map("billing_documents")
}

model BillingDocumentLine {
  id String @id @default(cuid())
  billingDocumentId String @map("billing_document_id")
  workOrderId String @map("work_order_id")
  description String @db.VarChar(500)
  workCode String @map("work_code") @db.VarChar(24)
  patientNameSnapshot String @map("patient_name_snapshot") @db.VarChar(120)
  doctorNameSnapshot String @map("doctor_name_snapshot") @db.VarChar(180)
  workTypeNameSnapshot String @map("work_type_name_snapshot") @db.VarChar(160)
  workCreatedAtSnapshot DateTime @map("work_created_at_snapshot")
  toothPositionSnapshot String? @map("tooth_position_snapshot") @db.VarChar(120)
  quantity Int
  unitPriceMinor Int @map("unit_price_minor")
  lineTotalMinor Int @map("line_total_minor")
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  billingDocument BillingDocument @relation(fields: [billingDocumentId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@unique([billingDocumentId, workOrderId])
  @@index([billingDocumentId, sortOrder])
  @@index([workOrderId])
  @@index([workCode])
  @@index([workCreatedAtSnapshot])
  @@map("billing_document_lines")
}

model Payment {
  id String @id @default(cuid())
  clinicId String @map("clinic_id")
  billingDocumentId String @map("billing_document_id")
  amountMinor Int @map("amount_minor")
  currency String @db.Char(3)
  paymentDate DateTime @map("payment_date")
  method PaymentMethod
  receiptNumber String? @map("receipt_number") @db.VarChar(80)
  receiptDate DateTime? @map("receipt_date")
  reference String? @db.VarChar(160)
  notes String? @db.VarChar(1000)
  createdByUserId String? @map("created_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledByUserId String? @map("cancelled_by_user_id")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  billingDocument BillingDocument @relation(fields: [billingDocumentId], references: [id], onDelete: Restrict)
  createdBy User? @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("PaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([billingDocumentId])
  @@index([paymentDate])
  @@index([method])
  @@index([receiptNumber])
  @@index([cancelledAt])
  @@index([createdByUserId])
  @@index([cancelledByUserId])
  @@map("payments")
}

model BillingSeries {
  id String @id @default(cuid())
  documentType BillingDocumentType @map("document_type")
  prefix String @db.VarChar(16)
  currentNumber Int @default(0) @map("current_number")
  year Int
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentType, prefix, year])
  @@index([documentType, isActive])
  @@index([year])
  @@map("billing_series")
}

enum BillingDocumentType {
  PROFORMA
  INVOICE
}

enum BillingDocumentStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum WorkStatus {
  REGISTERED
}

enum WorkPriority {
  NORMAL
  URGENT
}

model WorkWorkflowExecution {
  id String @id @default(cuid())
  workOrderId String @unique @map("work_order_id")
  workflowTemplateId String? @map("workflow_template_id")
  workflowTemplateVersion Int @map("workflow_template_version")
  workflowNameSnapshot String @map("workflow_name_snapshot") @db.VarChar(160)
  status WorkWorkflowExecutionStatus @default(ACTIVE)
  currentStageExecutionId String? @unique @map("current_stage_execution_id")
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  currentStage WorkStageExecution? @relation("CurrentWorkflowStage", fields: [currentStageExecutionId], references: [id], onDelete: SetNull)
  stages WorkStageExecution[] @relation("WorkflowExecutionStages")
  events WorkStageEvent[]

  @@index([workflowTemplateId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
  @@map("work_workflow_executions")
}

model WorkStageExecution {
  id String @id @default(cuid())
  workflowExecutionId String @map("workflow_execution_id")
  stageDefinitionId String? @map("stage_definition_id")
  stageKeySnapshot String @map("stage_key_snapshot") @db.VarChar(64)
  stageNameSnapshot String @map("stage_name_snapshot") @db.VarChar(160)
  stageDescriptionSnapshot String? @map("stage_description_snapshot") @db.VarChar(1000)
  sortOrder Int @map("sort_order")
  estimatedDurationMinutesSnapshot Int? @map("estimated_duration_minutes_snapshot")
  allowedRoleCodesSnapshot Json @map("allowed_role_codes_snapshot")
  status WorkStageExecutionStatus @default(PENDING)
  startedAt DateTime? @map("started_at")
  startedByUserId String? @map("started_by_user_id")
  completedAt DateTime? @map("completed_at")
  completedByUserId String? @map("completed_by_user_id")
  assignedUserId String? @map("assigned_user_id")
  assignedAt DateTime? @map("assigned_at")
  assignedByUserId String? @map("assigned_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  workflowExecution WorkWorkflowExecution @relation("WorkflowExecutionStages", fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  stageDefinition WorkflowStageDefinition? @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  startedBy User? @relation("WorkStageStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedBy User? @relation("WorkStageCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("WorkStageAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedBy User? @relation("WorkStageAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  currentForExecution WorkWorkflowExecution? @relation("CurrentWorkflowStage")
  events WorkStageEvent[]

  @@unique([workflowExecutionId, sortOrder])
  @@unique([workflowExecutionId, stageKeySnapshot])
  @@index([workflowExecutionId, status])
  @@index([status])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@index([assignedUserId])
  @@index([status, assignedUserId])
  @@index([workflowExecutionId, assignedUserId])
  @@index([assignedUserId, status])
  @@index([stageDefinitionId])
  @@map("work_stage_executions")
}

model WorkStageEvent {
  id String @id @default(cuid())
  workflowExecutionId String @map("workflow_execution_id")
  stageExecutionId String? @map("stage_execution_id")
  type WorkStageEventType
  actorUserId String? @map("actor_user_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  workflowExecution WorkWorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  stageExecution WorkStageExecution? @relation(fields: [stageExecutionId], references: [id], onDelete: SetNull)
  actor User? @relation("WorkStageEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workflowExecutionId, occurredAt])
  @@index([stageExecutionId])
  @@index([type])
  @@index([actorUserId])
  @@map("work_stage_events")
}

enum WorkWorkflowExecutionStatus {
  ACTIVE
  COMPLETED
}

enum WorkStageExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WorkStageEventType {
  WORKFLOW_CREATED
  STAGE_ASSIGNED
  STAGE_REASSIGNED
  STAGE_UNASSIGNED
  STAGE_STARTED
  STAGE_COMPLETED
  WORKFLOW_COMPLETED
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@index([key])
  @@map("roles")
}

model Permission {
  id              String                   @id @default(cuid())
  key             String                   @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  roles           RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([key])
  @@map("permissions")
}

model UserRole {
  userId           String   @map("user_id")
  roleId           String   @map("role_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String?  @map("assigned_by_user_id")
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user             User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope
  createdAt    DateTime        @default(now()) @map("created_at")
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId, scope])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  permissionId     String           @map("permission_id")
  effect           PermissionEffect
  scope            PermissionScope
  reason           String?
  assignedByUserId String?          @map("assigned_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User?            @relation("AssignedPermissionOverrides", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId, effect, scope])
  @@index([userId])
  @@index([permissionId])
  @@index([assignedByUserId])
  @@map("user_permission_overrides")
}

enum PermissionScope {
  ALL
  ASSIGNED
  OWN_CLINIC
  OWN_DELIVERY
  OWN_STAGE
}

enum PermissionEffect {
  ALLOW
  DENY
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
