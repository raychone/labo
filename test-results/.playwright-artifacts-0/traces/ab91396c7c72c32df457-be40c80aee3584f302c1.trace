lor-text-muted);\n  font-size: 0.68rem;\n  line-height: 1.1;\n}\n\n.billing-month-registry__work-code-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.15rem 0.35rem;\n}\n\n.billing-month-registry__work-code {\n  white-space: nowrap;\n}\n\n.billing-month-registry__cell-empty {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-page__month-close-archives {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__month-picker {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.billing-page__month-grid {\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));\n}\n\n.billing-page__month-grid .dl-button {\n  inline-size: 100%;\n  justify-content: center;\n}\n\n.billing-page__guide {\n  max-width: 52rem;\n}\n\n.billing-page__month-close-archive-list {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));\n}\n\n.billing-page__month-close-archive-meta {\n  display: grid;\n  gap: var(--dl-space-1);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-block-end: var(--dl-space-2);\n}\n\n.billing-page__month-close-archive-meta span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-page__month-close-archive-meta span:last-child {\n  grid-column: 1 / -1;\n}\n\n@page {\n  size: A4 portrait;\n  margin: 10mm 12mm 12mm;\n}\n\n@page month-registry {\n  size: A4 landscape;\n  margin: 8mm 10mm 10mm;\n}\n\n@media print {\n  html,\n  body {\n    background: #ffffff;\n    margin: 0;\n    min-height: auto;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  .app-shell__sidebar,\n  .app-shell__topbar,\n  .app-shell__header,\n  .billing-print-page__actions,\n  .billing-print-page .dl-tabs__list,\n  .billing-page__header,\n  .billing-page__filters,\n  .billing-page .dl-tabs__list,\n  .billing-page__toolbar,\n  .billing-page__tab-toolbar,\n  .billing-page__cards,\n  .billing-page .dl-data-table {\n    display: none;\n  }\n\n  .app-shell__main,\n  .billing-page,\n  .billing-print-page {\n    background: #ffffff;\n    padding: 0;\n  }\n\n  .billing-month-registry__paper {\n    min-height: auto;\n    overflow: visible;\n    padding: 10mm 10mm 12mm;\n  }\n\n  .billing-month-registry__header,\n  .billing-month-registry__summary {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-month-registry__section > header {\n    break-after: avoid;\n    page-break-after: avoid;\n  }\n\n  .billing-month-registry__table thead {\n    display: table-header-group;\n  }\n\n  .billing-month-registry__table tbody {\n    display: table-row-group;\n  }\n\n  .billing-month-registry__table tr {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-print-page .dl-tabs {\n    display: block;\n  }\n\n  .billing-print-page .dl-tabs__panel {\n    display: none;\n  }\n\n  .billing-print-page .dl-tabs__panel:not([hidden]) {\n    display: block;\n  }\n\n  .billing-page__print-preview,\n  .billing-print {\n    border: 0;\n    padding: 0;\n  }\n\n  .billing-statement {\n    border: 0;\n    box-shadow: none;\n  }\n\n  .billing-print__parties--invoice {\n    align-items: start;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: var(--dl-space-6);\n  }\n\n  .billing-print__header-parties,\n  .billing-print__party-grid,\n  .billing-print__meta--document {\n    grid-template-columns: 1fr;\n  }\n\n  .billing-print__header-parties,\n  .billing-print__party,\n  .billing-print__meta,\n  .billing-print__meta--document,\n  .billing-print__totals,\n  .billing-print__table,\n  .billing-statement__header,\n  .billing-statement__section,\n  .billing-statement__paper {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n\n  .billing-print__party {\n    padding: var(--dl-space-2);\n  }\n\n  .billing-print__invoice-title h1 {\n    font-size: var(--dl-font-size-section-title);\n  }\n\n  .billing-print__eyebrow