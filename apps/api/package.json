{
  "name": "@dental-lab/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "env -u ELECTRON_RUN_AS_NODE nest build",
    "prisma": "dotenv -e ../../.env -- prisma",
    "prisma:db:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:db:reset-demo": "dotenv -e ../../.env -- env -u ELECTRON_RUN_AS_NODE ALLOW_DEMO_SEED=true tsx prisma/reset-demo.ts",
    "prisma:db:seed:demo": "dotenv -e ../../.env -- env -u ELECTRON_RUN_AS_NODE ALLOW_DEMO_SEED=true tsx prisma/seed-demo.ts",
    "prisma:db:seed:technical": "dotenv -e ../../.env -- env -u ELECTRON_RUN_AS_NODE tsx prisma/seed-technical.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:generate:deploy": "prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:deploy:retry": "for attempt in 1 2 3 4 5; do pnpm run prisma:migrate:deploy && exit 0; sleep 15; done; exit 1",
    "prisma:seed:deploy": "env -u ELECTRON_RUN_AS_NODE tsx prisma/seed.ts",
    "prisma:seed:demo:deploy": "env -u ELECTRON_RUN_AS_NODE ALLOW_DEMO_SEED=true tsx prisma/seed-demo.ts",
    "prisma:seed:technical:deploy": "env -u ELECTRON_RUN_AS_NODE tsx prisma/seed-technical.ts",
    "prisma:seed:once:deploy": "env -u ELECTRON_RUN_AS_NODE ALLOW_DEMO_SEED=true tsx prisma/seed-once.ts",
    "prisma:reset:demo:deploy": "env -u ELECTRON_RUN_AS_NODE ALLOW_DEMO_SEED=true tsx prisma/reset-demo.ts",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "start": "env -u ELECTRON_RUN_AS_NODE node dist/src/main.js",
    "start:dev": "env -u ELECTRON_RUN_AS_NODE nest start --watch",
    "dev": "env -u ELECTRON_RUN_AS_NODE DEMO_MODE=true PORT=3010 WEB_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001 nest start --watch",
    "seed:demo": "pnpm run prisma:db:seed && pnpm run prisma:db:seed:technical && pnpm run prisma:db:seed:demo",
    "test": "env -u ELECTRON_RUN_AS_NODE vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- env -u ELECTRON_RUN_AS_NODE tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dental-lab/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "vitest": "^3.2.4"
  }
}
