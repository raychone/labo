  startedAt                        DateTime?                @map("started_at")
  startedByUserId                  String?                  @map("started_by_user_id")
  completedAt                      DateTime?                @map("completed_at")
  completedByUserId                String?                  @map("completed_by_user_id")
  assignedUserId                   String?                  @map("assigned_user_id")
  assignedAt                       DateTime?                @map("assigned_at")
  assignedByUserId                 String?                  @map("assigned_by_user_id")
  createdAt                        DateTime                 @default(now()) @map("created_at")
  updatedAt                        DateTime                 @updatedAt @map("updated_at")
  version                          Int                      @default(1)
  workflowExecution                WorkWorkflowExecution    @relation("WorkflowExecutionStages", fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  stageDefinition                  WorkflowStageDefinition? @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  startedBy                        User?                    @relation("WorkStageStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedBy                      User?                    @relation("WorkStageCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignedUser                     User?                    @relation("WorkStageAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedBy                       User?                    @relation("WorkStageAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  currentForExecution              WorkWorkflowExecution?   @relation("CurrentWorkflowStage")
  events                           WorkStageEvent[]

  @@unique([workflowExecutionId, sortOrder])
  @@unique([workflowExecutionId, stageKeySnapshot])
  @@index([workflowExecutionId, status])
  @@index([status])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@index([assignedUserId])
  @@index([status, assignedUserId])
  @@index([workflowExecutionId, assignedUserId])
  @@index([assignedUserId, status])
  @@index([stageDefinitionId])
  @@map("work_stage_executions")
}

model WorkStageEvent {
  id                  String                @id @default(cuid())
  workflowExecutionId String                @map("workflow_execution_id")
  stageExecutionId    String?               @map("stage_execution_id")
  type                WorkStageEventType
  actorUserId         String?               @map("actor_user_id")
  occurredAt          DateTime              @default(now()) @map("occurred_at")
  metadata            Json?
  createdAt           DateTime              @default(now()) @map("created_at")
  workflowExecution   WorkWorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  stageExecution      WorkStageExecution?   @relation(fields: [stageExecutionId], references: [id], onDelete: SetNull)
  actor               User?                 @relation("WorkStageEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workflowExecutionId, occurredAt])
  @@index([stageExecutionId])
  @@index([type])
  @@index([actorUserId])
  @@map("work_stage_events")
}

enum WorkWorkflowExecutionStatus {
  ACTIVE
  COMPLETED
}

enum WorkStageExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WorkStageEventType {
  WORKFLOW_CREATED
  STAGE_ASSIGNED
  STAGE_REASSIGNED
  STAGE_UNASSIGNED
  STAGE_STARTED
  STAGE_COMPLETED
  WORKFLOW_COMPLETED
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@index([key])
  @@map("roles")
}

model Permission {
  id            String                   @id @default(cuid())
  key           String                   @unique
  description   String
  resource      String
  action        String
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  roles         RolePermission[]
  userOverrides UserPermissionOverride[]

  @@index([key])
  @@map("permissions")
}

model UserRole {
  userId           String   @map("user_id")
  roleId           String   @map("role_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String?  @map("assigned_by_user_id")
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user             User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope
  createdAt    DateTime        @default(now()) @map("created_at")
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId, scope])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  permissionId     String           @map("permission_id")
  effect           PermissionEffect
  scope            PermissionScope
  reason           String?
  assignedByUserId String?          @map("assigned_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User?            @relation("AssignedPermissionOverrides", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId, effect, scope])
  @@index([userId])
  @@index([permissionId])
  @@index([assignedByUserId])
  @@map("user_permission_overrides")
}

enum PermissionScope {
  ALL
  ASSIGNED
  OWN_CLINIC
  OWN_DELIVERY
  OWN_STAGE
}

enum PermissionEffect {
  ALLOW
  DENY
}

model Session {
  id                  String       @id @default(cuid())
  userId              String       @map("user_id")
  tokenHash           String       @unique @map("token_hash")
  activeLegalEntityId String?      @map("active_legal_entity_id")
  expiresAt           DateTime     @map("expires_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  lastSeenAt          DateTime     @default(now()) @map("last_seen_at")
  revokedAt           DateTime?    @map("revoked_at")
  ipAddress           String?      @map("ip_address")
  userAgent           String?      @map("user_agent")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeLegalEntity   LegalEntity? @relation("SessionActiveLegalEntity", fields: [activeLegalEntityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeLegalEntityId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
