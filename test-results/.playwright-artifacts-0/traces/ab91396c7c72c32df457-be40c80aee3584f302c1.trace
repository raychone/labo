e: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.dashboard-page__manager-context p,\n.dashboard-page__manager-context time {\n  color: var(--dl-color-text-muted);\n  margin: var(--dl-space-1) 0 0;\n}\n\n.dashboard-page__manager-context time {\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dashboard-page__manager-kpis .dashboard-page__metric {\n  justify-items: start;\n  min-height: 6.25rem;\n  padding-inline: var(--dl-space-4);\n  text-align: left;\n}\n\n.dashboard-page__manager-kpis .dashboard-page__metric-label {\n  color: var(--dl-color-text);\n  font-size: calc(var(--dl-font-size-body) * 1.2);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dashboard-page__metric-label,\n.dashboard-page__finance-metric > span {\n  align-items: center;\n  display: flex;\n  gap: var(--dl-space-2);\n}\n\n.dashboard-page__metric-icon {\n  align-items: center;\n  background: var(--kpi-accent-surface);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  height: 2.52rem;\n  justify-content: center;\n  width: 2.52rem;\n}\n\n.dashboard-page__metric-icon .dashboard-page__icon-svg { height: 1.44rem; width: 1.44rem; }\n.dashboard-page__icon-svg { height: 1.05rem; width: 1.05rem; }\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--danger {\n  --kpi-accent: var(--dl-color-danger);\n}\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--warning {\n  --kpi-accent: var(--dl-color-warning);\n}\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--success {\n  --kpi-accent: var(--dl-color-success);\n}\n\n.dashboard-page__manager-layout {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dashboard-page__manager-scope-note {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n  margin: 0 0 var(--dl-space-3);\n}\n\n.dashboard-page__quick-actions {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-temp