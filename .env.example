PORT=3010
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=55439
POSTGRES_DB=dental_lab_dev
POSTGRES_USER=dental_lab_app
POSTGRES_PASSWORD=change_me_for_local_development

DATABASE_URL=postgresql://dental_lab_app:change_me_for_local_development@localhost:55439/dental_lab_dev
DATABASE_URL_LOCAL=postgresql://dental_lab_app:change_me_for_local_development@localhost:55439/dental_lab_dev
# Production/Render provides DATABASE_URL and DIRECT_URL as service secrets.
DATABASE_URL_NEON=
DIRECT_URL_NEON=

SESSION_COOKIE_NAME=dl_session
SESSION_TTL_SECONDS=28800
CSRF_COOKIE_NAME=dl_csrf
CSRF_HEADER_NAME=x-csrf-token
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
DEMO_MODE=true

AUTH_SEED_EMAIL=manager.dev@example.test
AUTH_SEED_PASSWORD=ChangeMe-Dev-Only-12345
AUTH_SEED_DISPLAY_NAME=Development Manager

# Optional local-only legal settings overrides for company-aware development settings.
# Keep real client fiscal/bank data out of Git and do not copy values from assets/.
