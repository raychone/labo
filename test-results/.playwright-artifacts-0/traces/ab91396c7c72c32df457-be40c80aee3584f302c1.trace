  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__metrics > * {\n  --kpi-accent: var(--app-brand-primary);\n  --kpi-accent-border: color-mix(in srgb, var(--kpi-accent) 26%, var(--dl-color-border));\n  --kpi-accent-surface: color-mix(in srgb, var(--kpi-accent) 8%, var(--dl-color-surface));\n  --kpi-accent-text: color-mix(in srgb, var(--kpi-accent) 78%, var(--dl-color-text));\n}\n\n.dashboard-page__metrics > *:nth-child(6n + 1),\n.dashboard-page__metrics--compact > *:nth-child(6n + 1) {\n  --kpi-accent: var(--app-brand-primary);\n}\n\n.dashboard-page__metrics > *:nth-child(6n + 2),\n.dashboard-page__metrics--compact > *:nth-child(6n + 2) {\n  --kpi-accent: #2563eb;\n}\n\n.dashboard-page__metrics > *:nth-child(6n + 3),\n.dashboard-page__metrics--compact > *:nth-child(6n + 3) {\n  --kpi-accent: #059669;\n}\n\n.dashboard-page__metrics > *:nth-child(6n + 4),\n.dashboard-page__metrics--compact > *:nth-child(6n + 4) {\n  --kpi-accent: #d97706;\n}\n\n.dashboard-page__metrics > *:nth-child(6n + 5),\n.dashboard-page__metrics--compact > *:nth-child(6n + 5) {\n  --kpi-accent: #e11d48;\n}\n\n.dashboard-page__metrics > *:nth-child(6n),\n.dashboard-page__metrics--compact > *:nth-child(6n) {\n  --kpi-accent: #7c3aed;\n}\n\n.dashboard-page__metric {\n  background: var(--kpi-accent-surface);\n  border: var(--dl-border-width) solid var(--kpi-accent-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  align-content: center;\n  justify-items: center;\n  min-height: 5.25rem;\n  min-width: 0;\n  overflow: hidden;\n  padding: calc(var(--dl-space-3) + 0.15rem) var(--dl-space-3) var(--dl-space-3);\n  position: relative;\n  text-align: center;\n}\n\n.dashboard-page__metric::before {\n  background: var(--kpi-accent);\n  content: \"\";\n  inset: 0 auto auto 0;\n  height: 0.35rem;\n  position: absolute;\n  width: 100%;\n}\n\n.dashboard-page__metric span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.dashboard-page__metric strong {\n  color: var(--kpi-accent-text);\n  font-size: var(--dl-font-size-page-title);\n  line-height: 1.05;\n  overflow-wrap: anywhere;\n  white-space: nowrap;\n}\n\n.dashboard-page__metrics--compact {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__metrics--compact .dashboard-page__metric {\n  min-height: 4.75rem;\n}\n\n.dashboard-page__links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.dashboard-page__links a {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--app-brand-primary);\n  font-weight: var(--dl-font-weight-bold);\n  min-height: 2.25rem;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__card-link {\n  color: var(--app-brand-primary);\n  font-weight: var(--dl-font-weight-bold);\n}\n\n.dashboard-page__workspace,\n.dashboard-page__section-content,\n.dashboard-page__attention-list {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dashboard-page__workspace-header,\n.dashboard-page__section-header,\n.dashboard-page__work-main,\n.dashboard-page__work-actions,\n.dashboard-page__finance-row {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.dashboard-page__workspace-header h2 {\n  font-size: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.dashboard-page__workspace-header p,\n.dashboard-page__note,\n.dashboard-page__empty p,\n.dashboard-page__field span,\n.dashboard-page__attention-item span,\n.dashboard-page__work-main span {\n  color: var(--dl-color-text-muted);\n}\n\n.dashboard-page__columns {\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: 1fr;\n  align-items: start;\n}\n\n.dashboard-page__manager {\n  gap: var(--dl-space-5);\n}\n\n.dashboard-page__manager-page-title h1 {\n  margin: 0;\n}\n\n.dashboard-page__manager-context {\n  align-items: end;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.dashboard-page__manager-context h2 {\n  font-size: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.dashboard-page__manager-context p,\n.dashboard-page__manager-context time {\n  color: var(--dl-color-text-muted);\n  margin: var(--dl-space-1) 0 0;\n}\n\n.dashboard-page__manager-context time {\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dashboard-page__manager-kpis .dashboard-page__metric {\n  justify-items: start;\n  min-height: 6.25rem;\n  padding-inline: var(--dl-space-4);\n  text-align: left;\n}\n\n.dashboard-page__manager-kpis .dashboard-page__metric-label {\n  color: var(--dl-color-text);\n  font-size: calc(var(--dl-font-size-body) * 1.2);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.dashboard-page__metric-label,\n.dashboard-page__finance-metric > span {\n  align-items: center;\n  display: flex;\n  gap: var(--dl-space-2);\n}\n\n.dashboard-page__metric-icon {\n  align-items: center;\n  background: var(--kpi-accent-surface);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  height: 2.52rem;\n  justify-content: center;\n  width: 2.52rem;\n}\n\n.dashboard-page__metric-icon .dashboard-page__icon-svg { height: 1.44rem; width: 1.44rem; }\n.dashboard-page__icon-svg { height: 1.05rem; width: 1.05rem; }\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--danger {\n  --kpi-accent: var(--dl-color-danger);\n}\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--warning {\n  --kpi-accent: var(--dl-color-warning);\n}\n\n.dashboard-page__metrics.dashboard-page__manager-kpis .dashboard-page__metric--success {\n  --kpi-accent: var(--dl-color-success);\n}\n\n.dashboard-page__manager-layout {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dashboard-page__manager-scope-note {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n  margin: 0 0 var(--dl-space-3);\n}\n\n.dashboard-page__quick-actions {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.dashboard-page__quick-action {\n  align-items: center;\n  border: var(--dl-border-width) solid var(--dl-color-accent);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-accent);\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-space-3);\n  justify-content: center;\n  min-height: 6.5rem;\n  padding: var(--dl-space-3);\n  text-align: center;\n}\n\n.dashboard-page__quick-action:hover {\n  background: var(--dl-color-accent-subtle);\n}\n\n.dashboard-page__quick-action:active { transform: translateY(1px); }\n.dashboard-page__quick-action:focus-visible { outline: 3px solid color-mix(in srgb, var(--dl-color-accent) 42%, transparent); outline-offset: 2px; }\n\n.dashboard-page__quick-action--primary {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dashboard-page__quick-action--primary:hover {\n  background: var(--dl-color-accent-hover);\n  color: #ffffff;\n}\n\n.dashboard-page__quick-action-icon {\n  align-items: center;\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  font-size: 1.15rem;\n  font-weight: var(--dl-font-weight-bold);\n  height: 2.25rem;\n  justify-content: center;\n  width: 2.25rem;\n}\n\n.dashboard-page__quick-action-icon .dashboard-page__icon-svg { height: 1.3rem; width: 1.3rem; }\n\n.dashboard-page__quick-action:not(.dashboard-page__quick-action--primary) .dashboard-page__quick-action-icon {\n  background: var(--dl-color-accent-subtle);\n}\n\n.dashboard-page__quick-action strong {\n  font-size: var(--dl-font-size-body);\n  font-weight: var(--dl-font-weight-bold);\n}\n\n.dashboard-page__quick-actions .dashboard-page__quick-action {\n  width: 100%;\n}\n\n.dashboard-page__manager-attention-list {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.dashboard-page__manager-attention {\n  align-items: center;\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  color: inherit;\n  display: flex;\n  gap: var(--dl-space-3);\n  justify-content: flex-start;\n  padding: var(--dl-space-3) 0;\n}\n\n.dashboard-page__manager-attention:first-child {\n  padding-top: 0;\n}\n\n.dashboard-page__manager-attention:last-child {\n  border-bottom: 0;\n  padding-bottom: 0;\n}\n\n.dashboard-page__manager-attention > div {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.dashboard-page__manager-attention small {\n  color: var(--dl-color-text-muted);\n  flex-basis: 100%;\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__manager-attention-chevron {\n  color: var(--dl-color-text-muted);\n  font-size: 1.5rem;\n  line-height: 1;\n  margin-left: auto;\n}\n\n.dashboard-page__attention-kind {\n  border-radius: 999px;\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  padding: .3rem .5rem;\n}\n\n.dashboard-page__attention-kind--late {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__attention-kind--returned {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__finance-summary {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__finance-metric {\n  background: var(--dl-color-background-secondary);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.dashboard-page__finance-metric span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.dashboard-page__finance-metric span i { align-items: center; color: var(--dl-color-text-muted); display: inline-flex; }\n.dashboard-page__finance-metric span i .dashboard-page__icon-svg { height: .9rem; width: .9rem; }\n\n.dashboard-page__finance-metric strong {\n  font-size: var(--dl-font-size-card-title);\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__finance-metric--danger {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__metric--link {\n  color: inherit;\n}\n\n.dashboard-page__metric--link:hover {\n  border-color: var(--app-brand-primary);\n  box-shadow: 0 0 0 1px var(--app-brand-primary);\n}\n\n.dashboard-page__action-link > span { align-items: center; display: inline-flex; margin-left: var(--dl-space-1); }\n.dashboard-page__action-link > span .dashboard-page__icon-svg { height: 1rem; width: 1rem; }\n\n.dashboard-page__metrics--five,\n.dashboard-page__metrics--six,\n.dashboard-page__metrics--seven {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__work-card,\n.dashboard-page__attention-item,\n.dashboard-page__empty {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-4);\n}\n\n.dashboard-page__work-main > div,\n.dashboard-page__field,\n.dashboard-page__attention-item > div:first-child {\n  display: grid;\n  gap: var(--dl-space-1);\n  min-width: 0;\n}\n\n.dashboard-page__work-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__field strong,\n.dashboard-page__work-main strong,\n.dashboard-page__attention-item strong {\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__field span {\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__field strong {\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__pill {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text-muted);\n  display: inline-flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__pill--late,\n.dashboard-page__pill--red {\n  background: var(--dl-color-danger-background);\n  border-color: var(--dl-color-danger-border);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__pill--due_today,\n.dashboard-page__pill--due_tomorrow,\n.dashboard-page__pill--warning,\n.dashboard-page__pill--yellow {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning-border);\n  color: var(--dl-color-warning-foreground);\n}\n\n.dashboard-page__pill--on_time,\n.dashboard-page__pill--green {\n  background: var(--dl-color-success-background);\n  border-color: var(--dl-color-success-border);\n  color: var(--dl-color-success-foreground);\n}\n\n.dashboard-page__finance-row {\n  justify-content: flex-start;\n  align-items: stretch;\n}\n\n.dashboard-page__finance-row span {\n  background: var(--dl-color-background-secondary);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  align-items: center;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__action-link {\n  align-items: center;\n  border: var(--dl-border-width) solid transparent;\n  border-radius: var(--dl-radius-md);\n  display: inline-flex;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: var(--dl-size-touch-target);\n  padding: 0 var(--dl-space-4);\n  text-decoration: none;\n}\n\n.dashboard-page__action-link--primary {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dashboard-page__action-link--primary:hover {\n  background: var(--dl-color-accent-hover);\n  color: #ffffff;\n}\n\n.dashboard-page__action-link--outline {\n  background: transparent;\n  border-color: var(--dl-color-accent);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__action-link--outline:hover {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-modal {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dashboard-page__unified-return-modal {\n  align-content: start;\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n/* The returned-probe flow is a two-pane workspace on desktop. Reserve the\n * available viewport height so both panels keep the stable proportions of the\n * operational flow; narrow screens retain the modal's internal scrolling. */\n.dashboard-page__returned-probe-modal {\n  height: min(64rem, calc(100dvh - 2rem));\n}\n\n.dashboard-page__returned-probe-modal .dl-overlay__content {\n  display: flex;\n}\n\n.dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n  flex: 1;\n  min-height: 100%;\n}\n\n@media (min-width: 56.01rem) {\n  .dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n    grid-template-rows: auto minmax(0, 1fr);\n  }\n}\n\n/* Open clinic and doctor lists remain part of the dialog layout, so the\n * dialog grows above its fixed footer instead of clipping their options. */\n.dashboard-page__returned-probe-modal .dashboard-page__return-fields .dl-select--open .dl-select__menu {\n  margin-top: var(--dl-space-2);\n  max-height: min(18rem, 35dvh);\n  position: static;\n}\n\n.dashboard-page__return-progress {\n  color: var(--dl-color-text-muted);\n  display: flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n  gap: var(--dl-space-4);\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.dashboard-page__return-progress span:first-child {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress span:not(.is-active):not(.is-complete) {\n  color: var(--dl-color-text-muted);\n}\n\n.dashboard-page__return-progress .is-active {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress .is-complete {\n  color: var(--dl-color-success-foreground, var(--dl-color-accent));\n}\n\n.dashboard-page__return-panel {\n  