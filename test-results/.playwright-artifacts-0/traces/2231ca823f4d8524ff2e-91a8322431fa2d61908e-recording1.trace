fy-items: end;\n  text-align: right;\n}\n\n.billing-statement__recipient span,\n.billing-statement__recipient small,\n.billing-statement__section-header span {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-statement__frame {\n  border: 1.5px solid color-mix(in srgb, var(--dl-color-text) 78%, var(--dl-color-border));\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-2);\n  position: relative;\n  align-content: start;\n}\n\n.billing-statement__frame::before {\n  display: none;\n}\n\n.billing-statement__section {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.billing-statement__section-header {\n  grid-template-columns: 1fr auto;\n  align-items: center;\n}\n\n.billing-statement__footer {\n  display: flex;\n  justify-content: flex-end;\n  padding-top: var(--dl-space-1);\n}\n\n.billing-statement__footer-total {\n  align-items: baseline;\n  display: flex;\n  gap: var(--dl-space-1);\n  justify-content: flex-end;\n  min-width: 14rem;\n}\n\n.billing-statement__footer-total span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-statement__footer-total strong {\n  font-size: var(--dl-font-size-title);\n}\n\n.billing-statement__table {\n  border-collapse: collapse;\n  font-size: var(--dl-font-size-small);\n  width: 100%;\n}\n\n.billing-statement__table th,\n.billing-statement__table td {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  padding: var(--dl-space-2);\n  text-align: left;\n  vertical-align: top;\n}\n\n.billing-statement__table th {\n  font-size: var(--dl-font-size-small);\n  color: var(--dl-color-text-muted);\n}\n\n.billing-statement__table--attachment {\n  font-size: 0.7rem;\n  line-height: 1.15;\n  margin-block-end: var(--dl-space-1);\n}\n\n.billing-statement__table--attachment th,\n.billing-statement__table--attachment td {\n  padding: 0.3rem 0.35rem;\n  word-break: normal;\n  overflow-wrap: break-word;\n}\n\n.billing-statement__table--attachment td:nth-child(