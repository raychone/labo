NC_TAX_ID=RO10000001
NC_COMPANY_REGISTRATION_NUMBER=J40/000001/2026
NC_EMAIL=nc.dev@example.test
NC_ADDRESS_LINE_1=Adresă NC de validat
NC_CITY=București
NC_IBAN=
NC_BANK_NAME=

