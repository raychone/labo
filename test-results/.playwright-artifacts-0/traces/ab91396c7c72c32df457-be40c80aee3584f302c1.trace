ions {\n  align-items: center;\n  justify-content: flex-end;\n}\n\n.logistics-page__note-editor {\n  display: grid;\n  gap: var(--space-4);\n}\n\n.logistics-page__note-actions {\n  display: flex;\n  gap: var(--space-2);\n  justify-content: flex-end;\n}\n\n.logistics-page__drawer section {\n  display: grid;\n  gap: var(--space-2);\n  border-bottom: 1px solid var(--color-border);\n  padding-bottom: var(--space-4);\n}\n\n.logistics-page__drawer h3 {\n  margin: 0;\n  color: var(--color-foreground);\n  font-size: var(--font-size-lg);\n}\n\n@media (min-width: 760px) {\n  .logistics-page__header {\n    grid-template-columns: 1fr auto;\n    align-items: end;\n  }\n\n  .logistics-page__summary {\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 759px) {\n  .logistics-page__layout {\n    gap: var(--space-4);\n    padding-inline: var(--space-3);\n    padding-block: var(--space-3);\n  }\n\n  .logistics-page .dl-card {\n    border-radius: var(--radius-md, 8px);\n  }\n\n  .logistics-page .dl-card--standard {\n    padding: var(--space-3);\n  }\n\n  .logistics-page__route-stop {\n    align-items: start;\n    grid-template-columns: auto auto minmax(0, 1fr);\n    padding: var(--space-3);\n  }\n\n  .logistics-page__route-location {\n    min-width: 0;\n    overflow-wrap: anywhere;\n  }\n\n  .logistics-page__route-stop p {\n    grid-column: 1 / -1;\n    overflow-wrap: anywhere;\n  }\n\n  .logistics-page__route-stop-contact {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .logistics-page__group {\n    gap: var(--space-3);\n    padding: var(--space-3);\n  }\n\n  .logistics-page__group-actions {\n    align-items: stretch;\n    display: grid;\n    gap: var(--space-2);\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .logistics-page__group-actions > .dl-button,\n  .logistics-page__group-actions > .dl-icon-button,\n  .logistics-page__assign-controls,\n  .logistics-page__assign-controls > .dl-button {\n    min-width: 0;\n    width: 100%