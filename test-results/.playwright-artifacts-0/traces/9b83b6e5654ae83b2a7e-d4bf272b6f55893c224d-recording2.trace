dashboard-page__manager-attention:first-child {\n  padding-top: 0;\n}\n\n.dashboard-page__manager-attention:last-child {\n  border-bottom: 0;\n  padding-bottom: 0;\n}\n\n.dashboard-page__manager-attention > div {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.dashboard-page__manager-attention small {\n  color: var(--dl-color-text-muted);\n  flex-basis: 100%;\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__manager-attention-chevron {\n  color: var(--dl-color-text-muted);\n  font-size: 1.5rem;\n  line-height: 1;\n  margin-left: auto;\n}\n\n.dashboard-page__attention-kind {\n  border-radius: 999px;\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  padding: .3rem .5rem;\n}\n\n.dashboard-page__attention-kind--late {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__attention-kind--returned {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__finance-summary {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__finance-metric {\n  background: var(--dl-color-background-secondary);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.dashboard-page__finance-metric span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.dashboard-page__finance-metric span i { align-items: center; color: var(--dl-color-text-muted); display: inline-flex; }\n.dashboard-page__finance-metric span i .dashboard-page__icon-svg { height: .9rem; width: .9rem; }\n\n.dashboard-page__finance-metric strong {\n  font-size: var(--dl-font-size-card-title);\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__finance-metric--danger {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__metric--link {\n  color: inherit;\n}\n\n.dashboard-page__metric--link:hover {\n  border-color: var(--app-brand-primary);\n  box-shadow: 0 0 0 1px var(--app-brand-primary);\n}\n\n.dashboard-page__action-link > span { align-items: center; display: inline-flex; margin-left: var(--dl-space-1); }\n.dashboard-page__action-link > span .dashboard-page__icon-svg { height: 1rem; width: 1rem; }\n\n.dashboard-page__metrics--five,\n.dashboard-page__metrics--six,\n.dashboard-page__metrics--seven {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__work-card,\n.dashboard-page__attention-item,\n.dashboard-page__empty {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-4);\n}\n\n.dashboard-page__work-main > div,\n.dashboard-page__field,\n.dashboard-page__attention-item > div:first-child {\n  display: grid;\n  gap: var(--dl-space-1);\n  min-width: 0;\n}\n\n.dashboard-page__work-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__field strong,\n.dashboard-page__work-main strong,\n.dashboard-page__attention-item strong {\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__field span {\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__field strong {\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__pill {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text-muted);\n  display: inline-flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__pill--late,\n.dashboard-page__pill--red {\n  background: var(--dl-color-danger-background);\n  border-color: var(--dl-color-danger-border);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dashboard-page__pill--due_today,\n.dashboard-page__pill--due_tomorrow,\n.dashboard-page__pill--warning,\n.dashboard-page__pill--yellow {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning-border);\n  color: var(--dl-color-warning-foreground);\n}\n\n.dashboard-page__pill--on_time,\n.dashboard-page__pill--green {\n  background: var(--dl-color-success-background);\n  border-color: var(--dl-color-success-border);\n  color: var(--dl-color-success-foreground);\n}\n\n.dashboard-page__finance-row {\n  justify-content: flex-start;\n  align-items: stretch;\n}\n\n.dashboard-page__finance-row span {\n  background: var(--dl-color-background-secondary);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  align-items: center;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__action-link {\n  align-items: center;\n  border: var(--dl-border-width) solid transparent;\n  border-radius: var(--dl-radius-md);\n  display: inline-flex;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: var(--dl-size-touch-target);\n  padding: 0 var(--dl-space-4);\n  text-decoration: none;\n}\n\n.dashboard-page__action-link--primary {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dashboard-page__action-link--primary:hover {\n  background: var(--dl-color-accent-hover);\n  color: #ffffff;\n}\n\n.dashboard-page__action-link--outline {\n  background: transparent;\n  border-color: var(--dl-color-accent);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__action-link--outline:hover {\n  background: var(--dl-color-accent-subtle);\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-modal {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dashboard-page__unified-return-modal {\n  align-content: start;\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n/* The returned-probe flow is a two-pane workspace on desktop. Reserve the\n * available viewport height so both panels keep the stable proportions of the\n * operational flow; narrow screens retain the modal's internal scrolling. */\n.dashboard-page__returned-probe-modal {\n  height: min(64rem, calc(100dvh - 2rem));\n}\n\n.dashboard-page__returned-probe-modal .dl-overlay__content {\n  display: flex;\n}\n\n.dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n  flex: 1;\n  min-height: 100%;\n}\n\n@media (min-width: 56.01rem) {\n  .dashboard-page__returned-probe-modal .dashboard-page__unified-return-modal {\n    grid-template-rows: auto minmax(0, 1fr);\n  }\n}\n\n/* Open clinic and doctor lists remain part of the dialog layout, so the\n * dialog grows above its fixed footer instead of clipping their options. */\n.dashboard-page__returned-probe-modal .dashboard-page__return-fields .dl-select--open .dl-select__menu {\n  margin-top: var(--dl-space-2);\n  max-height: min(18rem, 35dvh);\n  position: static;\n}\n\n.dashboard-page__return-progress {\n  color: var(--dl-color-text-muted);\n  display: flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n  gap: var(--dl-space-4);\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.dashboard-page__return-progress span:first-child {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress span:not(.is-active):not(.is-complete) {\n  color: var(--dl-color-text-muted);\n}\n\n.dashboard-page__return-progress .is-active {\n  color: var(--dl-color-accent);\n}\n\n.dashboard-page__return-progress .is-complete {\n  color: var(--dl-color-success-foreground, var(--dl-color-accent));\n}\n\n.dashboard-page__return-panel {\n  align-content: start;\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  min-width: 0;\n  padding: var(--dl-space-4);\n}\n\n.dashboard-page__return-panel h3,\n.dashboard-page__return-panel h4 {\n  margin: 0;\n}\n\n.dashboard-page__return-panel h3 {\n  font-size: var(--dl-font-size-card-title);\n}\n\n.dashboard-page__return-item--selected {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n  box-shadow: 0 0 0 1px var(--dl-color-accent);\n}\n\n.dashboard-page__selected-patient,\n.dashboard-page__selected-probe {\n  background: var(--dl-color-accent-subtle);\n  border: var(--dl-border-width) solid var(--dl-color-accent);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.dashboard-page__selected-patient span,\n.dashboard-page__selected-probe > span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__selected-probe dl {\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin: var(--dl-space-2) 0 0;\n}\n\n.dashboard-page__selected-probe dl div {\n  min-width: 0;\n}\n\n.dashboard-page__selected-probe dt {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.dashboard-page__selected-probe dd {\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__return-placeholder {\n  background: var(--dl-color-surface-muted, #f5faf9);\n  border: var(--dl-border-width) dashed var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text-muted);\n  margin: 0;\n  padding: var(--dl-space-4);\n}\n\n.dashboard-page__return-actions {\n  display: flex;\n  gap: var(--dl-space-2);\n  justify-content: space-between;\n  width: 100%;\n}\n\n.dashboard-page__return-fields {\n  align-items: start;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.dashboard-page__return-matches {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.dashboard-page__return-list {\n  display: grid;\n  gap: var(--dl-space-2);\n  max-height: 24rem;\n  overflow: auto;\n}\n\n.dashboard-page__return-candidate-list {\n  max-height: 29rem;\n}\n\n.dashboard-page__patient-list {\n  /* Five concise patient rows remain visible; the full clinic/doctor result\n   * set is available through this local scroll area. */\n  max-height: 16rem;\n  overflow-y: auto;\n}\n\n.dashboard-page__patient-list .dashboard-page__return-item {\n  min-height: 3rem;\n  overflow: hidden;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.dashboard-page__return-candidate-list .dashboard-page__return-item {\n  gap: 0.25rem;\n  min-height: 0;\n}\n\n.dashboard-page__return-item {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n  text-align: left;\n}\n\n.dashboard-page__return-item > span,\n.dashboard-page__return-item > strong {\n  display: block;\n  line-height: 1.3;\n  overflow-wrap: anywhere;\n}\n\n.dashboard-page__return-patient {\n  font-size: clamp(0.875rem, 3.6vw, 1rem);\n  line-height: 1.25 !important;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.dashboard-page__probe-form {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.dashboard-page__probe-form label {\n  display: grid;\n  gap: var(--dl-space-1);\n  font-weight: 700;\n}\n\n.dashboard-page__probe-history {\n  background: var(--dl-color-surface-muted, #f5faf9);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-2);\n  padding: var(--dl-space-3);\n}\n\n.dashboard-page__probe-history > div {\n  align-items: baseline;\n  display: flex;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.dashboard-page__probe-history > div span {\n  color: var(--dl-color-text-muted);\n}\n\n.dashboard-page__probe-sc