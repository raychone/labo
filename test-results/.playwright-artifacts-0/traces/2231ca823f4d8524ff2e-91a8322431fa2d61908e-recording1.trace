icing-page__audience-filters {\n  align-items: end;\n  background: var(--dl-color-background-secondary);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.pricing-page__audience-filters > * {\n  flex: 0 1 18rem;\n}\n\n.pricing-page__table-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.pricing-page__editor-section {\n  background: var(--dl-color-background-secondary);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-4);\n}\n\n.pricing-page__editor-section h3 {\n  font-size: var(--dl-font-size-section-title);\n  margin: 0;\n}\n\n.pricing-page__choice-group { display: grid; gap: var(--dl-space-2); }\n.pricing-page__choice-group h4 { margin: var(--dl-space-2) 0 0; }\n.pricing-page__choice-grid { display: grid; gap: var(--dl-space-2); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }\n.pricing-page__probe-type-modal .pricing-page__choice-grid { grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }\n.pricing-page__choice-grid > button { background: var(--dl-color-surface); border: 1px solid var(--dl-color-border); border-radius: var(--dl-radius-sm); color: var(--dl-color-text); cursor: pointer; display: grid; gap: 0.2rem; min-height: 3.5rem; padding: var(--dl-space-3); text-align: left; }\n.pricing-page__choice-grid > button:hover, .pricing-page__choice-grid > button:focus-visible { border-color: var(--dl-color-accent); }\n.pricing-page__choice-grid > button.is-selected { background: color-mix(in srgb, var(--dl-color-accent) 12%, var(--dl-color-surface)); border-color: var(--dl-color-accent); box-shadow: inset 3px 0 0 var(--dl-color-accent); }\n.pricing-page__choice-grid > button:disabled { cursor: not-allowed; opa