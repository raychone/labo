generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                     @id @default(cuid())
  email                               String                     @unique
  passwordHash                        String                     @map("password_hash")
  displayName                         String                     @map("display_name")
  preferredColor                      String?                    @map("preferred_color") @db.Char(7)
  isActive                            Boolean                    @default(true) @map("is_active")
  mustChangePassword                  Boolean                    @default(false) @map("must_change_password")
  passwordChangedAt                   DateTime                   @default(now()) @map("password_changed_at")
  createdAt                           DateTime                   @default(now()) @map("created_at")
  updatedAt                           DateTime                   @updatedAt @map("updated_at")
  version                             Int                        @default(1)
  sessions                            Session[]
  auditLogs                           AuditLog[]                 @relation("AuditActor")
  roles                               UserRole[]                 @relation("UserRoles")
  assignedUserRoles                   UserRole[]                 @relation("AssignedUserRoles")
  permissionOverrides                 UserPermissionOverride[]   @relation("UserPermissionOverrides")
  assignedPermissionOverrides         UserPermissionOverride[]   @relation("AssignedPermissionOverrides")
  updatedLaboratorySettings           LaboratorySettings[]       @relation("LaboratorySettingsUpdatedBy")
  updatedLegalEntitySettings          LegalEntitySettings[]      @relation("LegalEntitySettingsUpdatedBy")
  createdPatients                     Patient[]                  @relation("PatientCreatedBy")
  updatedPatients                     Patient[]                  @relation("PatientUpdatedBy")
  archivedPatients                    Patient[]                  @relation("PatientArchivedBy")
  createdClinics                      Clinic[]                   @relation("ClinicCreatedBy")
  updatedClinics                      Clinic[]                   @relation("ClinicUpdatedBy")
  archivedClinics                     Clinic[]                   @relation("ClinicArchivedBy")
  createdWorkTypes                    WorkType[]                 @relation("WorkTypeCreatedBy")
  updatedWorkTypes                    WorkType[]                 @relation("WorkTypeUpdatedBy")
  archivedWorkTypes                   WorkType[]                 @relation("WorkTypeArchivedBy")
  createdWorkOrders                   WorkOrder[]                @relation("WorkOrderCreatedBy")
  updatedWorkOrders                   WorkOrder[]                @relation("WorkOrderUpdatedBy")
  createdWorkCycles                   WorkCycle[]                @relation("WorkCycleCreatedBy")
  assignedClaimedWorkOrders           WorkOrder[]                @relation("WorkOrderAssignedTechnician")
  claimedWorkOrders                   WorkOrder[]                @relation("WorkOrderClaimedBy")
  releasedWorkOrders                  WorkOrder[]                @relation("WorkOrderReleasedBy")
  originalExecutionSnapshots          WorkExecutionSnapshot[]    @relation("WorkExecutionSnapshotOriginalTechnician")
  createdExecutionSnapshots           WorkExecutionSnapshot[]    @relation("WorkExecutionSnapshotCreatedBy")
  actorWorkAssignmentEvents           WorkAssignmentEvent[]      @relation("WorkAssignmentEventActor")
  previousWorkAssignmentEvents        WorkAssignmentEvent[]      @relation("WorkAssignmentEventPreviousTechnician")
  newWorkAssignmentEvents             WorkAssignmentEvent[]      @relation("WorkAssignmentEventNewTechnician")
  createdBillingDocuments             BillingDocument[]          @relation("BillingDocumentCreatedBy")
  updatedBillingDocuments             BillingDocument[]          @relation("BillingDocumentUpdatedBy")
  issuedBillingDocuments              BillingDocument[]          @relation("BillingDocumentIssuedBy")
  cancelledBillingDocuments           BillingDocument[]          @relation("BillingDocumentCancelledBy")
  createdPayments                     Payment[]                  @relation("PaymentCreatedBy")
  cancelledPayments                   Payment[]                  @relation("PaymentCancelledBy")
  createdWorkFormTemplates            WorkFormTemplate[]         @relation("WorkFormTemplateCreatedBy")
  updatedWorkFormTemplates            WorkFormTemplate[]         @relation("WorkFormTemplateUpdatedBy")
  activatedWorkFormTemplates          WorkFormTemplate[]         @relation("WorkFormTemplateActivatedBy")
  archivedWorkFormTemplates           WorkFormTemplate[]         @relation("WorkFormTemplateArchivedBy")
  submittedWorkFormSubmissions        WorkFormSubmission[]       @relation("WorkFormSubmissionSubmittedBy")
  updatedWorkFormSubmissions          WorkFormSubmission[]       @relation("WorkFormSubmissionUpdatedBy")
  finalizedWorkFormSubmissions        WorkFormSubmission[]       @relation("WorkFormSubmissionFinalizedBy")
  createdWorkflowTemplates            WorkflowTemplate[]         @relation("WorkflowTemplateCreatedBy")
  updatedWorkflowTemplates            WorkflowTemplate[]         @relation("WorkflowTemplateUpdatedBy")
  activatedWorkflowTemplates          WorkflowTemplate[]         @relation("WorkflowTemplateActivatedBy")
  archivedWorkflowTemplates           WorkflowTemplate[]         @relation("WorkflowTemplateArchivedBy")
  startedWorkStages                   WorkStageExecution[]       @relation("WorkStageStartedBy")
  completedWorkStages                 WorkStageExecution[]       @relation("WorkStageCompletedBy")
  assignedWorkStages                  WorkStageExecution[]       @relation("WorkStageAssignedTo")
  assignedByWorkStages                WorkStageExecution[]       @relation("WorkStageAssignedBy")
  workflowStageEvents                 WorkStageEvent[]           @relation("WorkStageEventActor")
  blockedWorkLogisticsStates          WorkLogisticsState[]       @relation("WorkLogisticsBlockedBy")
  readyForPackingWorkLogisticsStates  WorkLogisticsState[]       @relation("WorkLogisticsReadyForPackingBy")
  packingStartedWorkLogisticsStates   WorkLogisticsState[]       @relation("WorkLogisticsPackingStartedBy")
  readyForDeliveryWorkLogisticsStates WorkLogisticsState[]       @relation("WorkLogisticsReadyForDeliveryBy")
  updatedWorkLogisticsStates          WorkLogisticsState[]       @relation("WorkLogisticsUpdatedBy")
  logisticsEvents                     LogisticsEvent[]           @relation("LogisticsEventActor")
  createdDeliveryPreparationGroups    DeliveryPreparationGroup[] @relation("DeliveryPreparationGroupCreatedBy")
  updatedDeliveryPreparationGroups    DeliveryPreparationGroup[] @relation("DeliveryPreparationGroupUpdatedBy")
  addedDeliveryPreparationItems       DeliveryPreparationItem[]  @relation("DeliveryPreparationItemAddedBy")
  removedDeliveryPreparationItems     DeliveryPreparationItem[]  @relation("DeliveryPreparationItemRemovedBy")
  courierDeliveries                   Delivery[]                 @relation("DeliveryCourier")
  assignedDeliveries                  Delivery[]                 @relation("DeliveryAssignedBy")
  pickedUpDeliveries                  Delivery[]                 @relation("DeliveryPickedUpBy")
  deliveredDeliveries                 Delivery[]                 @relation("DeliveryDeliveredBy")
  cancelledDeliveries                 Delivery[]                 @relation("DeliveryCancelledBy")
  createdDeliveries                   Delivery[]                 @relation("DeliveryCreatedBy")
  updatedDeliveries                   Delivery[]                 @relation("DeliveryUpdatedBy")
  deliveryEvents                      DeliveryEvent[]            @relation("DeliveryEventActor")
  confirmedDeliveryProofs             DeliveryProof[]            @relation("DeliveryProofConfirmedBy")
  createdPriceCatalogItems            PriceCatalogItem[]         @relation("PriceCatalogItemCreatedBy")
  updatedPriceCatalogItems            PriceCatalogItem[]         @relation("PriceCatalogItemUpdatedBy")
  archivedPriceCatalogItems           PriceCatalogItem[]         @relation("PriceCatalogItemArchivedBy")
  createdExecutionTimeRules           ExecutionTimeRule[]        @relation("ExecutionTimeRuleCreatedBy")
  updatedExecutionTimeRules           ExecutionTimeRule[]        @relation("ExecutionTimeRuleUpdatedBy")
  createdPricingAgreements            PricingAgreement[]         @relation("PricingAgreementCreatedBy")
  updatedPricingAgreements            PricingAgreement[]         @relation("PricingAgreementUpdatedBy")
  archivedPricingAgreements           PricingAgreement[]         @relation("PricingAgreementArchivedBy")

  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model LaboratorySettings {
  id                        String   @id @default(cuid())
  key                       String   @unique @default("default")
  laboratoryName            String   @map("laboratory_name") @db.VarChar(120)
  legalName                 String?  @map("legal_name") @db.VarChar(160)
  companyRegistrationNumber String?  @map("company_registration_number") @db.VarChar(80)
  taxId                     String?  @map("tax_id") @db.VarChar(80)
  email                     String?  @db.VarChar(254)
  phone                     String?  @db.VarChar(40)
  website                   String?  @db.VarChar(2048)
  addressLine1              String?  @map("address_line_1") @db.VarChar(160)
  addressLine2              String?  @map("address_line_2") @db.VarChar(160)
  city                      String?  @db.VarChar(100)
  countyOrRegion            String?  @map("county_or_region") @db.VarChar(100)
  postalCode                String?  @map("postal_code") @db.VarChar(20)
  countryCode               String   @default("RO") @map("country_code") @db.Char(2)
  timezone                  String   @default("Europe/Bucharest") @db.VarChar(64)
  locale                    String   @default("ro-RO") @db.VarChar(12)
  currency                  String   @default("RON") @db.Char(3)
  logoFileKey               String?  @map("logo_file_key") @db.VarChar(512)
  primaryColor              String   @default("#0f766e") @map("primary_color") @db.Char(7)
  documentFooter            String?  @map("document_footer") @db.VarChar(500)
  updatedByUserId           String?  @map("updated_by_user_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  updatedBy                 User?    @relation("LaboratorySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("laboratory_settings")
}

model LegalEntity {
  id                           String                  @id @default(cuid())
  code                         String                  @unique @db.VarChar(8)
  displayName                  String                  @map("display_name") @db.VarChar(120)
  isActive                     Boolean                 @default(true) @map("is_active")
  sortOrder                    Int                     @default(0) @map("sort_order")
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")
  sessions                     Session[]               @relation("SessionActiveLegalEntity")
  settings                     LegalEntitySettings?
  priceCatalogItems            PriceCatalogItem[]
  pricingAgreements            PricingAgreement[]
  executionWorkOrders          WorkOrder[]             @relation("WorkOrderExecutionLegalEntity")
  executionSnapshots           WorkExecutionSnapshot[]
  workCycles                   WorkCycle[]
  billingDocuments             BillingDocument[]
  payments                     Payment[]
  billingSeries                BillingSeries[]
  billingDocumentLines         BillingDocumentLine[]
  previousWorkAssignmentEvents WorkAssignmentEvent[]   @relation("WorkAssignmentEventPreviousLegalEntity")
  newWorkAssignmentEvents      WorkAssignmentEvent[]   @relation("WorkAssignmentEventNewLegalEntity")

  @@index([isActive, sortOrder, code])
  @@map("legal_entities")
}

model LegalEntitySettings {
  id                        String      @id @default(cuid())
  legalEntityId             String      @unique @map("legal_entity_id")
  legalName                 String      @map("legal_name") @db.VarChar(160)
  companyRegistrationNumber String?     @map("company_registration_number") @db.VarChar(80)
  taxId                     String?     @map("tax_id") @db.VarChar(80)
  email                     String?     @db.VarChar(254)
  phone                     String?     @db.VarChar(40)
  website                   String?     @db.VarChar(2048)
  addressLine1              String?     @map("address_line_1") @db.VarChar(160)
  addressLine2              String?     @map("address_line_2") @db.VarChar(160)
  city                      String?     @db.VarChar(100)
  countyOrRegion            String?     @map("county_or_region") @db.VarChar(100)
  postalCode                String?     @map("postal_code") @db.VarChar(20)
  countryCode               String      @default("RO") @map("country_code") @db.Char(2)
  timezone                  String      @default("Europe/Bucharest") @db.VarChar(64)
  locale                    String      @default("ro-RO") @db.VarChar(12)
  currency                  String      @default("RON") @db.Char(3)
  iban                      String?     @db.VarChar(34)
  bankName                  String?     @map("bank_name") @db.VarChar(120)
  primaryColor              String      @default("#0f766e") @map("primary_color") @db.Char(7)
  logoFileKey               String?     @map("logo_file_key") @db.VarChar(512)
  documentFooter            String?     @map("document_footer") @db.VarChar(500)
  updatedByUserId           String?     @map("updated_by_user_id")
  createdAt                 DateTime    @default(now()) @map("created_at")
  updatedAt                 DateTime    @default(now()) @updatedAt @map("updated_at")
  legalEntity               LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  updatedBy                 User?       @relation("LegalEntitySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("legal_entity_settings")
}

model Patient {
  id                  String      @id @default(cuid())
  firstName           String      @map("first_name") @db.VarChar(80)
  lastName            String      @map("last_name") @db.VarChar(80)
  normalizedFirstName String      @map("normalized_first_name") @db.VarChar(80)
  normalizedLastName  String      @map("normalized_last_name") @db.VarChar(80)
  birthDate           DateTime?   @map("birth_date") @db.Date
  sex                 PatientSex  @default(UNSPECIFIED)
  notes               String?     @db.VarChar(1000)
  isArchived          Boolean     @default(false) @map("is_archived")
  archivedAt          DateTime?   @map("archived_at")
  archivedByUserId    String?     @map("archived_by_user_id")
  createdByUserId     String?     @map("created_by_user_id")
  updatedByUserId     String?     @map("updated_by_user_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  version             Int         @default(1)
  archivedBy          User?       @relation("PatientArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  createdBy           User?       @relation("PatientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy           User?       @relation("PatientUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  workOrders          WorkOrder[]

  @@index([normalizedLastName, normalizedFirstName])
  @@index([isArchived])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("patients")
}

enum PatientSex {
  FEMALE
  MALE
  UNSPECIFIED
}

model Clinic {
  id                        String                     @id @default(cuid())
  code                      String                     @unique @db.VarChar(20)
  name                      String                     @db.VarChar(160)
  legalName                 String?                    @map("legal_name") @db.VarChar(160)
  taxId                     String?                    @map("tax_id") @db.VarChar(80)
  registrationNumber        String?                    @map("registration_number") @db.VarChar(80)
  email                     String?                    @db.VarChar(254)
  phone                     String?                    @db.VarChar(40)
  website                   String?                    @db.VarChar(2048)
  contactPersonName         String?                    @map("contact_person_name") @db.VarChar(120)
  contactPersonRole         String?                    @map("contact_person_role") @db.VarChar(80)
  contactPersonEmail        String?                    @map("contact_person_email") @db.VarChar(254)
  contactPersonPhone        String?                    @map("contact_person_phone") @db.VarChar(40)
  addressLine1              String?                    @map("address_line_1") @db.VarChar(160)
  addressLine2              String?                    @map("address_line_2") @db.VarChar(160)
  city                      String?                    @db.VarChar(100)
  countyOrRegion            String?                    @map("county_or_region") @db.VarChar(100)
  postalCode                String?                    @map("postal_code") @db.VarChar(20)
  countryCode               String                     @default("RO") @map("country_code") @db.Char(2)
  billingName               String?                    @map("billing_name") @db.VarChar(160)
  billingTaxId              String?                    @map("billing_tax_id") @db.VarChar(80)
  billingRegistrationNumber String?                    @map("billing_registration_number") @db.VarChar(80)
  billingAddressLine1       String?                    @map("billing_address_line_1") @db.VarChar(160)
  billingAddressLine2       String?                    @map("billing_address_line_2") @db.VarChar(160)
  billingCity               String?                    @map("billing_city") @db.VarChar(100)
  billingCountyOrRegion     String?                    @map("billing_county_or_region") @db.VarChar(100)
  billingPostalCode         String?                    @map("billing_postal_code") @db.VarChar(20)
  billingCountryCode        String                     @default("RO") @map("billing_country_code") @db.Char(2)
  internalNotes             String?                    @map("internal_notes") @db.VarChar(2000)
  isActive                  Boolean                    @default(true) @map("is_active")
  archivedAt                DateTime?                  @map("archived_at")
  createdByUserId           String?                    @map("created_by_user_id")
  updatedByUserId           String?                    @map("updated_by_user_id")
  archivedByUserId          String?                    @map("archived_by_user_id")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  version                   Int                        @default(1)
  doctors                   Doctor[]
  workOrders                WorkOrder[]
  workCycles                WorkCycle[]
  billingDocuments          BillingDocument[]
  payments                  Payment[]
  pricingAgreements         PricingAgreement[]
  createdBy                 User?                      @relation("ClinicCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                 User?                      @relation("ClinicUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy                User?                      @relation("ClinicArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  deliveryPreparationGroups DeliveryPreparationGroup[]
  deliveries                Delivery[]

  @@index([name])
  @@index([city])
  @@index([isActive])
  @@index([createdAt])
  @@index([taxId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("clinics")
}

model Doctor {
  id                String             @id @default(cuid())
  clinicId          String             @map("clinic_id")
  firstName         String             @map("first_name") @db.VarChar(80)
  lastName          String             @map("last_name") @db.VarChar(80)
  displayName       String             @map("display_name") @db.VarChar(180)
  email             String?            @db.VarChar(254)
  phone             String?            @db.VarChar(40)
  professionalCode  String?            @map("professional_code") @db.VarChar(80)
  internalNotes     String?            @map("internal_notes") @db.VarChar(2000)
  isActive          Boolean            @default(true) @map("is_active")
  archivedAt        DateTime?          @map("archived_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  version           Int                @default(1)
  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  workOrders        WorkOrder[]
  workCycles        WorkCycle[]
  billingDocuments  BillingDocument[]
  pricingAgreements PricingAgreement[]

  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("doctors")
}

model WorkType {
  id                String             @id @default(cuid())
  code              String             @unique @db.VarChar(20)
  name              String             @db.VarChar(160)
  description       String?            @db.VarChar(1000)
  basePriceMinor    Int                @map("base_price_minor")
  unit              WorkTypeUnit       @default(UNIT)
  isActive          Boolean            @default(true) @map("is_active")
  archivedAt        DateTime?          @map("archived_at")
  createdByUserId   String?            @map("created_by_user_id")
  updatedByUserId   String?            @map("updated_by_user_id")
  archivedByUserId  String?            @map("archived_by_user_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  version           Int                @default(1)
  createdBy         User?              @relation("WorkTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?              @relation("WorkTypeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy        User?              @relation("WorkTypeArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  workOrders        WorkOrder[]
  formTemplates     WorkFormTemplate[]
  workflowTemplates WorkflowTemplate[]
  priceCatalogItems PriceCatalogItem[]

  @@index([name])
  @@index([basePriceMinor])
  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("work_types")
}

enum WorkTypeUnit {
  ELEMENT
  UNIT
  ARCH
  CASE
  REPAIR
  OTHER
}

model PriceCatalogItem {
  id                 String                 @id @default(cuid())
  legalEntityId      String                 @map("legal_entity_id")
  workTypeId         String                 @map("work_type_id")
  category           String                 @db.VarChar(100)
  displayName        String                 @map("display_name") @db.VarChar(160)
  unit               WorkTypeUnit           @default(UNIT)
  standardPriceMinor Int                    @map("standard_price_minor")
  isActive           Boolean                @default(true) @map("is_active")
  sortOrder          Int                    @default(0) @map("sort_order")
  notes              String?                @db.VarChar(1000)
  createdByUserId    String?                @map("created_by_user_id")
  updatedByUserId    String?                @map("updated_by_user_id")
  archivedAt         DateTime?              @map("archived_at")
  archivedByUserId   String?                @map("archived_by_user_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at")
  legalEntity        LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  workType           WorkType               @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  createdBy          User?                  @relation("PriceCatalogItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy          User?                  @relation("PriceCatalogItemUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy         User?                  @relation("PriceCatalogItemArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  executionTimeRules ExecutionTimeRule[]
  agreementRules     PricingAgreementRule[]

  @@index([legalEntityId])
  @@index([workTypeId])
  @@index([isActive])
  @@index([legalEntityId, category, sortOrder, displayName])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("price_catalog_items")
}

model ExecutionTimeRule {
  id                    String           @id @default(cuid())
  priceCatalogItemId    String           @map("price_catalog_item_id")
  minQuantity           Int              @map("min_quantity")
  maxQuantity           Int?             @map("max_quantity")
  executionDays         Int?             @map("execution_days")
  requiresManualDueDate Boolean          @default(false) @map("requires_manual_due_date")
  priority              Int              @default(0)
  isActive              Boolean          @default(true) @map("is_active")
  createdByUserId       String?          @map("created_by_user_id")
  updatedByUserId       String?          @map("updated_by_user_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at")
  priceCatalogItem      PriceCatalogItem @relation(fields: [priceCatalogItemId], references: [id], onDelete: Cascade)
  createdBy             User?            @relation("ExecutionTimeRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy             User?            @relation("ExecutionTimeRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([priceCatalogItemId])
  @@index([priceCatalogItemId, isActive, minQuantity])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("execution_time_rules")
}

model PricingAgreement {
  id               String                      @id @default(cuid())
  legalEntityId    String                      @map("legal_entity_id")
  subjectType      PricingAgreementSubjectType @map("subject_type")
  clinicId         String?                     @map("clinic_id")
  doctorId         String?                     @map("doctor_id")
  name             String                      @db.VarChar(160)
  validFrom        DateTime                    @map("valid_from") @db.Date
  validUntil       DateTime?                   @map("valid_until") @db.Date
  isActive         Boolean                     @default(true) @map("is_active")
  notes            String?                     @db.VarChar(1000)
  createdByUserId  String?                     @map("created_by_user_id")
  updatedByUserId  String?                     @map("updated_by_user_id")
  archivedAt       DateTime?                   @map("archived_at")
  archivedByUserId String?                     @map("archived_by_user_id")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @default(now()) @updatedAt @map("updated_at")
  legalEntity      LegalEntity                 @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  clinic           Clinic?                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor           Doctor?                     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy        User?                       @relation("PricingAgreementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?                       @relation("PricingAgreementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedBy       User?                       @relation("PricingAgreementArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  rules            PricingAgreementRule[]

  @@index([legalEntityId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([subjectType])
  @@index([isActive])
  @@index([legalEntityId, subjectType, isActive, validFrom, validUntil])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
  @@map("pricing_agreements")
}

model PricingAgreementRule {
  id                              String                @id @default(cuid())
  pricingAgreementId              String                @map("pricing_agreement_id")
  scope                           PricingRuleScope
  priceCatalogItemId              String?               @map("price_catalog_item_id")
  category                        String?               @db.VarChar(100)
  adjustmentType                  PricingAdjustmentType @map("adjustment_type")
  adjustmentValueMinor            Int?                  @map("adjustment_value_minor")
  adjustmentPercentageBasisPoints Int?                  @map("adjustment_percentage_basis_points")
