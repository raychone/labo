{"type":"frame-snapshot","snapshot":{"callId":"call@363","snapshotName":"after@call@363","pageId":"page@b446bd4c84374faa2843c6c7527a96fc","frameId":"frame@8e5c89ccd17a21a5aa61475efe65a9d8","frameUrl":"http://127.0.0.1:3138/status","doctype":"html","html":["HTML",{"lang":"ro"},["HEAD",{},[[4,0]],[[4,1]],[[4,2]],[[4,3]],[[4,4]],[[4,5]],[[4,6]],[[4,7]],[[2,1]],[[4,10]],[[4,12]],[[4,14]],[[4,16]],["STYLE",{},".works-page {\n  min-height: 100vh;\n  background: var(--dl-color-background);\n}\n\n.works-page__layout,\n.works-page__table-card,\n.works-page__drawer,\n.works-page__form {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.works-page__drawer {\n  gap: var(--dl-space-5);\n  padding: var(--dl-space-2);\n}\n\n.works-page__work-details-drawer {\n  width: 100vw;\n  max-width: none;\n}\n\n.works-page__work-details-drawer .dl-overlay__content {\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n}\n\n.works-page__quick-clinic-modal {\n  min-height: min(26rem, calc(100dvh - 2rem));\n}\n\n.works-page__quick-clinic-modal .dl-overlay__content {\n  min-height: 0;\n  overflow-y: auto;\n}\n\n.works-page__detail-section {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-4);\n  padding: clamp(var(--dl-space-4), 3vw, var(--dl-space-6));\n}\n\n.works-page__detail-section-header h2 {\n  margin: 0;\n}\n\n.works-page__detail-section-header {\n  align-items: center;\n  display: flex;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__detail-section-grid {\n  display: grid;\n  gap: var(--dl-space-5);\n  grid-template-columns: 1fr;\n}\n\n.works-page__probe-accordion {\n  overflow: hidden;\n}\n\n.works-page__accordion-trigger {\n  align-items: center;\n  appearance: none;\n  background: transparent;\n  border: 0;\n  color: inherit;\n  cursor: pointer;\n  display: flex;\n  font: inherit;\n  gap: 1rem;\n  justify-content: space-between;\n  padding: 0;\n  text-align: left;\n  width: 100%;\n}\n\n.works-page__accordion-copy {\n  display: grid;\n  gap: 0.25rem;\n}\n\n.works-page__accordion-copy .dl-card__title,\n.works-page__accordion-copy .dl-card__description {\n  display: block;\n  margin: 0;\n  text-align: left;\n}\n\n.works-page__section-title {\n  color: var(--dl-color-text);\n  font-size: var(--dl-font-size-section-title);\n  font-weight: var(--dl-font-weight-bold);\n  line-height: var(--dl-line-height-title);\n}\n\n.works-page__accordion-trigger:focus-visible {\n  border-radius: 0.5rem;\n  outline: 3px solid color-mix(in srgb, var(--color-primary, #0f766e) 35%, transparent);\n  outline-offset: 4px;\n}\n\n.works-page__accordion-chevron {\n  align-items: center;\n  border: 1px solid currentColor;\n  border-radius: 999px;\n  background: transparent;\n  display: inline-flex;\n  flex: 0 0 auto;\n  font-size: 1.25rem;\n  height: 2rem;\n  justify-content: center;\n  line-height: 1;\n  width: 2rem;\n  transition: transform 160ms ease;\n}\n\n.works-page__accordion-chevron.is-expanded {\n  transform: rotate(180deg);\n}\n\n.works-page__inline-icon-button {\n  background: transparent;\n  border: 0;\n  color: var(--dl-color-primary);\n  cursor: pointer;\n  font: inherit;\n  margin-left: 0.35rem;\n  padding: 0 0.2rem;\n}\n\n.works-page__inline-deadline-editor {\n  align-items: end;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  margin-top: var(--dl-space-2);\n}\n\n.works-page__composition-groups {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.works-page__composition-groups > div {\n  align-items: center;\n  display: flex;\n  gap: var(--dl-space-3);\n}\n\n.works-page__composition-groups strong {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  padding: 0.2rem 0.55rem;\n}\n\n.works-page__detail-field {\n  display: grid;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.works-page__detail-field > span {\n  color: var(--dl-color-text-muted);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.works-page__attachment-list {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.works-page__attachment-list li {\n  align-items: center;\n  background: var(--dl-color-surface-muted);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: flex;\n  gap: var(--dl-space-2);\n  justify-content: space-between;\n  min-width: 0;\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.works-page__attachment-list button {\n  background: transparent;\n  border: 0;\n  color: var(--dl-color-primary);\n  cursor: pointer;\n  min-width: 0;\n  overflow-wrap: anywhere;\n  padding: 0;\n  text-align: left;\n}\n\n.works-page__attachment-preview-button {\n  align-items: center;\n  display: inline-flex;\n  gap: var(--dl-space-3);\n  min-width: 0;\n}\n\n.works-page__attachment-preview-button:disabled {\n  cursor: wait;\n  opacity: 0.7;\n}\n\n.works-page__attachment-thumb {\n  align-items: center;\n  background: var(--dl-color-surface-muted);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text-muted);\n  display: inline-flex;\n  flex: 0 0 52px;\n  height: 40px;\n  justify-content: center;\n  overflow: hidden;\n}\n\n.works-page__attachment-thumb img {\n  height: 100%;\n  object-fit: cover;\n  width: 100%;\n}\n\n.works-page__attachment-meta {\n  align-items: center;\n  display: inline-flex;\n  flex: 0 0 auto;\n  gap: var(--dl-space-3);\n}\n\n.works-page__attachment-download {\n  font-size: var(--dl-font-size-sm) !important;\n  font-weight: var(--dl-font-weight-semibold);\n  white-space: nowrap;\n}\n\n.works-page__image-preview {\n  align-items: center;\n  background: #101418;\n  border-radius: var(--dl-radius-md);\n  display: flex;\n  justify-content: center;\n  min-height: min(70vh, 720px);\n  overflow: auto;\n  padding: var(--dl-space-4);\n}\n\n.works-page__image-preview img {\n  display: block;\n  max-height: 75vh;\n  max-width: 100%;\n  object-fit: contain;\n}\n\n.works-page__attachment-list small {\n  color: var(--dl-color-text-muted);\n  flex: 0 0 auto;\n}\n\n.works-page__attachment-dropzone {\n  align-items: center;\n  border: 1px dashed var(--dl-color-primary);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-primary);\n  cursor: pointer;\n  display: grid;\n  gap: var(--dl-space-1);\n  justify-items: center;\n  padding: var(--dl-space-4);\n  text-align: center;\n}\n\n.works-page__attachment-dropzone small {\n  color: var(--dl-color-text-muted);\n}\n\n.works-page__pending-attachments {\n  background: var(--dl-color-surface-muted);\n  border: 1px solid var(--dl-color-primary);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.works-page__pending-attachments span {\n  overflow-wrap: anywhere;\n}\n\n.works-page__attachment-dropzone input {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  height: 1px;\n  width: 1px;\n  opacity: 0;\n}\n\n.works-page__layout {\n  padding-block: var(--dl-space-5);\n}\n\n.works-page__header,\n.works-page__actions,\n.works-page__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n}\n\n.works-page__header {\n  align-items: flex-start;\n  justify-content: space-between;\n}\n\n.works-page__card-header-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  align-items: flex-start;\n  justify-content: space-between;\n}\n\n.works-page__header h1 {\n  margin: 0;\n}\n\n.works-page__header p,\n.works-page__muted {\n  color: var(--dl-color-text-muted);\n  margin: var(--dl-space-1) 0 0;\n}\n\n.works-page__summary {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.works-page__execution-now {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__execution-now-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.works-page__inline-edit-section,\n.works-page__inline-composition-editor {\n  background: var(--dl-color-surface-muted, #f7faf9);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  margin-top: var(--dl-space-3);\n  padding: var(--dl-space-4);\n}\n\n.works-page__inline-edit-section .works-page__detail-section-header {\n  align-items: center;\n}\n\n.works-page__execution-now-grid > div,\n.works-page__patient-grid > div {\n  display: grid;\n  gap: var(--dl-space-1);\n  min-width: 0;\n}\n\n.works-page__metric {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  min-height: 4.5rem;\n  padding: var(--dl-space-3);\n}\n\n.works-page__metric span {\n  color: #111827;\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n}\n\n.works-page__metric strong {\n  font-size: var(--dl-font-size-section-title);\n}\n\n.works-page__quick-filters {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.works-page__filters-collapsed {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.works-page__filters,\n.works-page__form-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n/* The multi-item editor owns its own responsive layout. Keeping the slot in\n   one form-grid track prevents the generic two-column form breakpoint from\n   cutting the dental diagram to half width. */\n.works-page__multi-item-details-grid {\n  grid-template-columns: minmax(0, 1fr);\n  min-width: 0;\n  width: 100%;\n}\n\n.works-page__badge-stack,\n.works-page__row-actions {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__technician-badge {\n  border-radius: var(--dl-radius-sm);\n  box-shadow: inset 0 0 0 1px var(--dl-color-border);\n  display: inline-block;\n  height: 18px;\n  width: 64px;\n}\n\n.works-page__technician-badge--empty {\n  background: var(--dl-color-surface-muted);\n}\n\n.works-page__pill {\n  align-items: center;\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  min-height: 28px;\n  padding: var(--dl-space-1) var(--dl-space-2);\n  width: max-content;\n}\n\n.works-page__pill--neutral {\n  background: var(--dl-color-surface-muted);\n  color: var(--dl-color-text);\n}\n\n.works-page__pill--info {\n  background: var(--dl-color-info-background);\n  border-color: var(--dl-color-info-border);\n  color: var(--dl-color-info-foreground);\n}\n\n.works-page__pill--success {\n  background: var(--dl-color-success-background);\n  border-color: var(--dl-color-success-border);\n  color: var(--dl-color-success-foreground);\n}\n\n.works-page__pill--warning {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning-border);\n  color: var(--dl-color-warning-foreground);\n}\n\n.works-page__pill--danger {\n  background: var(--dl-color-danger-background);\n  border-color: var(--dl-color-danger-border);\n  color: var(--dl-color-danger-foreground);\n}\n\n.works-page__open-link {\n  align-items: center;\n  border: 1px solid var(--dl-color-primary);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-primary);\n  display: inline-flex;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: 36px;\n  padding: var(--dl-space-1) var(--dl-space-3);\n  text-decoration: none;\n  width: max-content;\n}\n\n.works-page__search-field {\n  display: grid;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.works-page__picker-with-action {\n  align-items: end;\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: minmax(0, 1fr) auto;\n  min-width: 0;\n}\n\n.works-page__picker-with-action > .dl-button {\n  margin-bottom: 0;\n  white-space: nowrap;\n  width: max-content;\n}\n\n.works-page__search-hint {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n  margin: 0;\n}\n\n.works-page__search-listbox {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  max-height: min(22rem, 45vh);\n  overflow: auto;\n  padding: var(--dl-space-2);\n}\n\n.works-page__search-option {\n  align-items: flex-start;\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-2) var(--dl-space-3);\n  text-align: left;\n  min-width: 0;\n  overflow-wrap: anywhere;\n  white-space: normal;\n  line-height: 1.35;\n  min-height: 3.75rem;\n  height: auto;\n  align-content: start;\n  overflow: hidden;\n}\n\n.works-page__restoration-toggle {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.works-page__restoration-label {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n}\n\n.works-page__restoration-options {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.works-page__restoration-option {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: 999px;\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: inline-flex;\n  gap: var(--dl-space-2);\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.works-page__restoration-option.is-selected {\n  background: var(--dl-color-primary);\n  border-color: var(--dl-color-primary);\n  color: var(--dl-color-primary-contrast, #fff);\n}\n\n.works-page__restoration-option:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.works-page__restoration-dot {\n  border: 2px solid currentColor;\n  border-radius: 50%;\n  height: 0.9rem;\n  width: 0.9rem;\n}\n\n.works-page__restoration-option.is-selected .works-page__restoration-dot {\n  background: currentColor;\n  box-shadow: inset 0 0 0 3px var(--dl-color-primary);\n}\n\n.works-page__deadline-date-picker,\n.works-page__deadline-time-picker {\n  min-width: 0;\n  padding-left: 2.25rem;\n  position: relative;\n}\n\n.works-page__deadline-date-picker:invalid::-webkit-datetime-edit,\n.works-page__deadline-time-picker:invalid::-webkit-datetime-edit {\n  color: transparent;\n}\n\n.works-page__deadline-date-picker:focus::-webkit-datetime-edit,\n.works-page__deadline-date-picker:not(:invalid)::-webkit-datetime-edit,\n.works-page__deadline-time-picker:focus::-webkit-datetime-edit,\n.works-page__deadline-time-picker:not(:invalid)::-webkit-datetime-edit {\n  color: inherit;\n}\n\n.works-page__deadline-date-picker::-webkit-calendar-picker-indicator,\n.works-page__deadline-time-picker::-webkit-calendar-picker-indicator {\n  cursor: pointer;\n  height: 1.1rem;\n  left: 0.75rem;\n  margin: 0;\n  position: absolute;\n  width: 1.1rem;\n}\n\n.works-page__search-option strong,\n.works-page__search-option span {\n  display: block;\n  min-width: 0;\n  overflow-wrap: anywhere;\n  white-space: normal;\n}\n\n.works-page__search-option span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__search-option[aria-selected=\"true\"] {\n  border-color: var(--dl-color-primary);\n  background: var(--dl-color-primary-soft);\n}\n\n.works-page__search-option--active {\n  border-color: var(--dl-color-primary);\n  background: var(--dl-color-primary-soft);\n  box-shadow: 0 0 0 1px var(--dl-color-primary-border);\n}\n\n.works-page__search-empty {\n  color: var(--dl-color-text-muted);\n  padding: var(--dl-space-2) var(--dl-space-1);\n}\n\n.works-page__fieldset {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  margin: 0;\n  padding: var(--dl-space-4);\n}\n\n.works-page__fieldset legend {\n  color: var(--dl-color-text);\n  font-size: var(--dl-font-size-sm);\n  font-weight: 700;\n  padding-inline: var(--dl-space-2);\n}\n\n.works-page__meta {\n  align-items: center;\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__price-preview,\n.works-page__deadline-preview,\n.works-page__choice-field p,\n.works-page__tooth-field p {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n  margin: 0;\n}\n\n.works-page__deadline-preview {\n  background: var(--dl-color-surface-muted);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-1);\n  margin-top: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.works-page__deadline-badge {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  padding: var(--dl-space-2) var(--dl-space-3);\n  width: max-content;\n}\n\n.works-page__deadline-badge--gray {\n  background: var(--dl-color-surface-muted);\n  color: var(--dl-color-text-muted);\n}\n\n.works-page__deadline-badge--dark-gray {\n  background: var(--dl-color-text-muted);\n  color: var(--dl-color-surface);\n}\n\n.works-page__deadline-badge--blue {\n  background: var(--dl-color-info-background);\n  border-color: var(--dl-color-info-border);\n  color: var(--dl-color-info-foreground);\n}\n\n.works-page__deadline-badge--green {\n  background: var(--dl-color-success-background);\n  border-color: var(--dl-color-success-border);\n  color: var(--dl-color-success-foreground);\n}\n\n.works-page__deadline-badge--yellow {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning-border);\n  color: var(--dl-color-warning-foreground);\n}\n\n.works-page__deadline-badge--strong-orange {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning);\n  color: var(--dl-color-warning-strong);\n}\n\n.works-page__deadline-badge--red {\n  background: var(--dl-color-danger-background);\n  border-color: var(--dl-color-danger-border);\n  color: var(--dl-color-danger-foreground);\n}\n\n.works-page__deadline-card {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__deadline-card > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__deadline-card-note {\n  grid-column: 1 / -1;\n}\n\n.works-page__deadline-card-note p {\n  margin: 0;\n}\n\n.works-page__deadline-preview strong {\n  color: var(--dl-color-text);\n}\n\n.works-page__choice-field,\n.works-page__tooth-field {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  margin: 0;\n  padding: var(--dl-space-3);\n}\n\n.works-page__choice-field legend,\n.works-page__tooth-field legend {\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  padding-inline: var(--dl-space-1);\n}\n\n.works-page__choice-grid {\n  display: grid;\n  gap: var(--dl-space-2);\n}\n\n.works-page__tooth-quadrants {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  position: relative;\n}\n\n.works-page__tooth-quadrant {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-2);\n  min-width: 0;\n  padding: var(--dl-space-2);\n}\n\n.works-page__tooth-quadrant--upper_right { grid-area: 1 / 1; }\n.works-page__tooth-quadrant--upper_left { grid-area: 1 / 2; }\n.works-page__tooth-quadrant--lower_left { grid-area: 2 / 2; }\n.works-page__tooth-quadrant--lower_right { grid-area: 2 / 1; }\n\n.works-page__tooth-center {\n  align-self: center;\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-lg);\n  font-weight: var(--dl-font-weight-bold);\n  justify-self: center;\n  line-height: 1;\n  pointer-events: none;\n  position: absolute;\n  inset: 50% auto auto 50%;\n  transform: translate(-50%, -50%);\n  z-index: 1;\n}\n\n.works-page__tooth-grid {\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: repeat(4, minmax(2.5rem, 1fr));\n}\n\n.works-page__tooth-button {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-weight: var(--dl-font-weight-semibold);\n  justify-content: center;\n  min-height: 2.75rem;\n  padding: var(--dl-space-2);\n}\n\n.works-page__tooth-button[aria-pressed=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n  color: var(--dl-color-accent-active);\n}\n\n.works-page__tooth-button:focus-visible {\n  outline: 3px solid var(--dl-color-accent);\n  outline-offset: 2px;\n}\n\n@media (max-width: 720px) {\n  .works-page__tooth-quadrants {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    min-width: 0;\n  }\n}\n\n.works-page__snapshot {\n  border-top: 1px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding-top: var(--dl-space-4);\n}\n\n.works-page__snapshot h3 {\n  font-size: var(--dl-font-size-card-title);\n  margin: 0;\n}\n\n.works-page__snapshot-list {\n  display: grid;\n  gap: var(--dl-space-2);\n  margin: 0;\n}\n\n.works-page__snapshot-list div {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.works-page__snapshot-list dt {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__snapshot-list dd {\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n.works-page__workflow {\n  border-top: 1px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-4);\n  padding-top: var(--dl-space-4);\n}\n\n.works-page__workflow h3,\n.works-page__timeline h4 {\n  margin: 0;\n}\n\n.works-page__workflow-header,\n.works-page__workflow-current {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__workflow-current {\n  background: var(--dl-color-background-secondary);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  padding: var(--dl-space-3);\n}\n\n.works-page__workflow-current > div,\n.works-page__assignment {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__assignment {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  padding: var(--dl-space-3);\n}\n\n.works-page__label {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-caption);\n  font-weight: var(--dl-font-weight-semibold);\n  text-transform: uppercase;\n}\n\n.works-page__stage-list,\n.works-page__timeline ol {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.works-page__stage-item {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-3);\n}\n\n.works-page__stage-item[data-current=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__stage-item > div:first-child,\n.works-page__timeline li {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  justify-content: space-between;\n}\n\n.works-page__timeline {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__responsibility {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__responsibility > div,\n.works-page__cycle-grid > div,\n.works-page__cycle-header > div,\n.works-page__return-summary > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-header,\n.works-page__return-summary {\n  align-items: start;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__cycle-list {\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.works-page__cycle-item {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.works-page__cycle-item[data-active=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__cycle-title {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n}\n\n.works-page__cycle-title > div {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.works-page__cycle-title span {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-sm);\n}\n\n.works-page__cycle-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__patient-grid {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: 1fr;\n}\n\n.works-page__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  margin-bottom: var(--dl-space-4);\n}\n\n.works-page__tab {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  min-height: 36px;\n  padding: 0 var(--dl-space-3);\n}\n\n.works-page__tab[aria-selected=\"true\"] {\n  background: var(--dl-color-accent-subtle);\n  border-color: var(--dl-color-accent);\n}\n\n.works-page__lab-sheet {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.works-page__form-full {\n  grid-column: 1 / -1;\n}\n\n.works-page__timeline > div {\n  border-left: 3px solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-1);\n  padding-left: var(--dl-space-3);\n}\n\n.works-page__timeline > div span,\n.works-page__timeline > div p {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.works-page__timeline li {\n  border-left: 3px solid var(--dl-color-border);\n  padding-left: var(--dl-space-3);\n}\n\n@media (min-width: 720px) {\n  .works-page__summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__filters,\n  .works-page__form-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__deadline-card {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__responsibility {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-header,\n  .works-page__return-summary {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__cycle-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .works-page__detail-section-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (min-width: 1100px) {\n  .works-page__summary {\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n\n  .works-page__execution-now-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__patient-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .works-page__form .works-page__work-selection-grid {\n    grid-template-columns: minmax(0, 2fr) minmax(5rem, 0.7fr) minmax(6rem, 0.75fr);\n  }\n}\n\n.works-page__probe-history {\n  display: grid;\n  gap: 0.3rem;\n  margin: 0 0 1rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--dl-border, #d5e1df);\n  border-radius: 0.75rem;\n  background: var(--dl-surface-muted, #f5faf9);\n}\n\n.works-page__probe-history span {\n  color: var(-