-3);\n  white-space: nowrap;\n}\n\n.logistics-page__date-modal-backdrop {\n  align-items: center;\n  background: rgb(15 23 42 / 32%);\n  display: flex;\n  inset: 0;\n  justify-content: center;\n  padding: var(--space-4);\n  position: fixed;\n  z-index: 20;\n}\n\n.logistics-page__date-modal {\n  background: #fff;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-lg);\n  max-width: 390px;\n  padding: var(--space-5);\n  width: min(100%, 390px);\n}\n\n.logistics-page__date-modal-header,\n.logistics-page__date-modal-actions {\n  align-items: center;\n  display: flex;\n  gap: var(--space-3);\n  justify-content: space-between;\n}\n\n.logistics-page__date-modal-header {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n}\n\n.logistics-page__date-modal-value { justify-self: center; text-align: center; }\n.logistics-page__date-modal-header button { justify-self: end; }\n\n.logistics-page__date-modal-header button,\n.logistics-page__date-modal-actions button {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  color: var(--color-foreground);\n  cursor: pointer;\n  font: inherit;\n  min-height: 40px;\n  min-width: 64px;\n  padding: 0 var(--space-3);\n}\n\n.logistics-page__date-modal-actions {\n  justify-content: flex-end;\n  margin-top: var(--space-4);\n}\n\n.logistics-page__date-modal-actions button:first-child {\n  color: var(--color-primary);\n}\n\n.logistics-page__date-wheel-column {\n  display: grid;\n  gap: var(--space-1);\n  min-width: 0;\n  position: relative;\n}\n\n.logistics-page__date-wheel-column > span:first-child {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-sm);\n  font-weight: 600;\n}\n\n.logistics-page__date-wheel-arrow {\n  color: var(--color-primary);\n  font-size: 1.5rem;\n  line-height: 1;\n  pointer-events: none;\n  position: absolute;\n  right: 0.35rem;\n  top: 4.45rem;\n  transform: rotate(180deg);\n  z-index: 1;\n}\n\n.logistics-page__date-wheel select {\n  background: #fff;\n  border: 1px solid var(--color-border);\n  border-radius: 8px;\n  color: var(--color-foreground);\n  height: 8.5rem;\n  max-width: none;\n  padding: var(--space-1);\n  width: 100%;\n}\n\n.logistics-page__date-wheel option:checked {\n  background: var(--color-primary);\n  color: #fff;\n}\n\n.logistics-page__print-route-header {\n  display: grid;\n  gap: var(--space-1);\n}\n\n.logistics-page__print-stops {\n  display: grid;\n  gap: var(--space-3);\n  margin: var(--space-3) 0 0;\n  padding-left: 1.5rem;\n}\n\n.logistics-page__print-stops li {\n  display: grid;\n  gap: var(--space-1);\n}\n\n.logistics-page__print-route-header,\n.logistics-page__print-stops,\n.logistics-page__screen-only {\n  grid-column: 1 / -1;\n}\n\n.logistics-page__screen-only {\n  color: var(--color-muted-foreground);\n}\n\n@media (min-width: 760px) {\n  .logistics-page__group {\n    grid-template-columns: minmax(0, 1fr) auto;\n  }\n\n  .logistics-page__group-actions {\n    align-self: start;\n    grid-column: 2;\n    grid-row: 1 / span 4;\n  }\n\n  .logistics-page__summary {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .logistics-page__table-header {\n    display: grid;\n  }\n\n  .logistics-page__row {\n    grid-template-columns: repeat(5, minmax(110px, 1fr)) repeat(5, minmax(105px, 1fr));\n  }\n\n  .logistics-page__row-main,\n  .logistics-page__row-place,\n  .logistics-page__row-type,\n  .logistics-page__row-value,\n  .logistics-page__row-state,\n  .logistics-page__row-alerts,\n  .logistics-page__row-meta,\n  .logistics-page__row-requirements,\n  .logistics-page__row-actions {\n    grid-column: auto;\n  }\n}\n\n@media (min-width: 1180px) {\n  .logistics-page__summary {\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n  }\n\n  .logistics-page__table-header,\n  .logistics-page__row {\n    grid-template-columns: minmax(145px, 1.1fr) minmax(155px, 1.15fr) minmax(120px, 1fr) minmax(75px, 0.55fr) minmax(120px, 0.9fr) minmax(85px, 0.65fr) minmax(105px, 0.75fr) minmax(145px, 1fr) minmax(115px, 0.8fr) minmax(145px, 1.1fr);\n  }\n\n  .logistics-page__row-state {\n    padding-left: var(--space-2);\n  }\n}\n\n@media print {\n  .logistics-page__print-hide,\n  .logistics-page__header,\n  .logistics-page__print-controls,\n  .logistics-page__group button,\n  .logistics-page__screen-only {\n    display: none !important;\n  }\n\n  .logistics-page,\n  .logistics-page__layout,\n  .logistics-page__groups {\n    background: #fff !important;\n    box-shadow: none !important;\n    max-width: none !important;\n    padding: 0 !important;\n  }\n\n  .logistics-page__group {\n    break-inside: avoid;\n    border-bottom: 1px solid #b8c2bd;\n    margin-bottom: 18px;\n    padding: 0 0 14px;\n  }\n}\n.logistics-page__route-history {\n  border-top: 1px solid var(--dl-color-border);\n  margin-top: var(--dl-space-5);\n  padding-top: var(--dl-space-4);\n}\n\n.logistics-page__route-history > summary {\n  color: var(--dl-color-text);\n  cursor: pointer;\n  font-weight: var(--dl-font-weight-semibold);\n  padding: var(--dl-space-2) 0;\n}\n\n.logistics-page__route-history > p {\n  color: var(--dl-color-text-muted);\n  margin: 0 0 var(--dl-space-3);\n}\n\n/* Route builder: one operational workspace instead of three cramped columns. */\n.logistics-page__route-builder-card {\n  overflow: visible;\n}\n\n.logistics-page__route-builder-card .dl-card__header {\n  border-bottom: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);\n}\n\n.logistics-page__route-settings {\n  align-items: end;\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: minmax(15rem, 1.2fr) minmax(11rem, .8fr) minmax(12rem, .8fr);\n}\n\n.logistics-page__route-settings .dl-field {\n  min-width: 0;\n}\n\n.logistics-page__route-workspace {\n  align-items: start;\n  display: grid;\n  gap: var(--space-5);\n  grid-template-columns: minmax(0, .84fr) minmax(0, 1.16fr);\n}\n\n.logistics-page__available-stops-panel,\n.logistics-page__route-preparation-panel {\n  background: color-mix(in srgb, var(--color-surface) 97%, var(--color-primary-soft));\n  border: 1px solid var(--color-border);\n  border-radius: calc(var(--radius-md) + .15rem);\n  min-width: 0;\n  padding: var(--space-4);\n}\n\n.logistics-page__route-preparation-panel {\n  background: var(--color-surface);\n  border-color: color-mix(in srgb, var(--color-primary) 28%, var(--color-border));\n  box-shadow: 0 10px 24px color-mix(in srgb, var(--color-primary) 7%, transparent);\n}\n\n.logistics-page__workspace-panel-heading {\n  align-items: start;\n  display: flex;\n  gap: var(--space-3);\n  justify-content: space-between;\n}\n\n.logistics-page__workspace-panel-heading h2 {\n  color: var(--color-foreground);\n  font-size: var(--font-size-lg);\n  line-height: 1.2;\n  margin: 0;\n}\n\n.logistics-page__workspace-panel-heading p {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-sm);\n  margin: var(--space-1) 0 0;\n}\n\n.logistics-page__route-preparation-count {\n  align-items: center;\n  background: var(--color-primary-soft);\n  border-radius: 999px;\n  color: var(--color-primary);\n  display: inline-flex;\n  font-size: var(--font-size-sm);\n  font-weight: 800;\n  height: 2rem;\n  justify-content: center;\n  min-width: 2rem;\n}\n\n.logistics-page__available-stop-tabs {\n  border-bottom: 1px solid var(--color-border);\n  display: flex;\n  gap: var(--space-1);\n  margin-top: var(--space-4);\n  overflow-x: auto;\n}\n\n.logistics-page__available-stop-tabs button {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  color: var(--color-muted-foreground);\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: var(--font-size-sm);\n  font-weight: 700;\n  gap: var(--space-2);\n  min-height: 42px;\n  padding: 0 var(--space-2);\n  white-space: nowrap;\n}\n\n.logistics-page__available-stop-tabs button[aria-pressed=\"true\"] {\n  border-bottom-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.logistics-page__available-stop-tabs button span {\n  align-items: center;\n  background: color-mix(in srgb, currentColor 10%, transparent);\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: .76rem;\n  justify-content: center;\n  min-width: 1.45rem;\n  padding: .1rem .38rem;\n}\n\n.logistics-page__available-stop-list,\n.logistics-page__selected-stop-list {\n  align-content: start;\n  display: grid;\n  gap: var(--space-3);\n  list-style: none;\n  margin: var(--space-4) 0 0;\n  padding: 0;\n}\n\n.logistics-page__available-stop-list {\n  max-height: 37rem;\n  overflow: auto;\n  padding-right: .25rem;\n}\n\n.logistics-page__candidate-card {\n  background: var(--color-surface);\n  border: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: .3rem;\n  padding: var(--space-3);\n}\n\n.logistics-page__candidate-card:hover {\n  border-color: color-mix(in srgb, var(--color-primary) 42%, var(--color-border));\n  box-shadow: 0 5px 14px color-mix(in srgb, var(--color-primary) 8%, transparent);\n}\n\n.logistics-page__candidate-card-heading {\n  align-items: center;\n  display: flex;\n  gap: var(--space-2);\n  justify-content: space-between;\n  margin-bottom: var(--space-1);\n}\n\n.logistics-page__candidate-card > strong {\n  color: var(--color-foreground);\n  font-size: var(--font-size-md);\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__candidate-secondary,\n.logistics-page__candidate-clinic {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-sm);\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__candidate-clinic {\n  color: var(--color-foreground);\n  font-weight: 700;\n  margin-top: var(--space-1);\n}\n\n.logistics-page__candidate-contacts {\n  border-top: 1px solid color-mix(in srgb, var(--color-border) 74%, transparent);\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin: var(--space-2) 0 0;\n  padding-top: var(--space-2);\n}\n\n.logistics-page__candidate-contacts div {\n  min-width: 0;\n}\n\n.logistics-page__candidate-contacts dt {\n  color: var(--color-muted-foreground);\n  font-size: .72rem;\n}\n\n.logistics-page__candidate-contacts dd {\n  color: var(--color-foreground);\n  font-size: .78rem;\n  margin: .15rem 0 0;\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__candidate-alert,\n.logistics-page__compact-contact-alert {\n  align-items: center;\n  color: var(--color-danger, #b42318);\n  display: flex;\n  font-size: .78rem;\n  font-weight: 700;\n  gap: .4rem;\n  margin: var(--space-1) 0 0;\n}\n\n.logistics-page__candidate-alert > span,\n.logistics-page__compact-contact-alert > span {\n  align-items: center;\n  border: 1px solid currentColor;\n  border-radius: 50%;\n  display: inline-flex;\n  flex: 0 0 1rem;\n  font-size: .68rem;\n  height: 1rem;\n  justify-content: center;\n  line-height: 1;\n}\n\n.logistics-page__available-empty,\n.logistics-page__route-preparation-empty {\n  align-content: center;\n  background: color-mix(in srgb, var(--color-surface-muted) 78%, transparent);\n  border: 1px dashed var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-muted-foreground);\n  display: grid;\n  gap: var(--space-2);\n  margin: var(--space-4) 0 0;\n  min-height: 11rem;\n  padding: var(--space-4);\n  text-align: center;\n}\n\n.logistics-page__route-preparation-empty strong {\n  color: var(--color-foreground);\n}\n\n.logistics-page__selected-stop-list {\n  max-height: 37rem;\n  overflow: auto;\n  padding-right: .25rem;\n}\n\n.logistics-page__selected-stop {\n  align-items: start;\n  background: color-mix(in srgb, var(--color-primary) 3%, var(--color-surface));\n  border: 1px solid color-mix(in srgb, var(--color-primary) 23%, var(--color-border));\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: 2.1rem minmax(0, 1fr) auto;\n  padding: var(--space-3);\n}\n\n.logistics-page__stop-order {\n  align-items: center;\n  background: var(--color-primary);\n  border-radius: 50%;\n  color: var(--color-primary-foreground);\n  display: inline-flex;\n  font-size: .88rem;\n  font-weight: 800;\n  height: 2rem;\n  justify-content: center;\n  width: 2rem;\n}\n\n.logistics-page__selected-stop-main {\n  display: grid;\n  gap: .3rem;\n  min-width: 0;\n}\n\n.logistics-page__selected-stop-heading {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n}\n\n.logistics-page__selected-stop-heading strong {\n  color: var(--color-foreground);\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__selected-stop-clinic {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-sm);\n  font-weight: 700;\n}\n\n.logistics-page__selected-stop-contacts {\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: minmax(0, 1fr) minmax(8rem, .55fr);\n  margin-top: var(--space-2);\n}\n\n.logistics-page__selected-stop-contacts label {\n  color: var(--color-muted-foreground);\n  display: grid;\n  font-size: .72rem;\n  gap: .25rem;\n}\n\n.logistics-page__selected-stop-contacts input {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  color: var(--color-foreground);\n  font: inherit;\n  min-height: 2.35rem;\n  min-width: 0;\n  padding: 0 var(--space-2);\n}\n\n.logistics-page__selected-stop-actions {\n  align-items: center;\n  display: flex;\n  gap: .4rem;\n}\n\n.logistics-page__selected-stop-actions .dl-icon-button {\n  height: 2.25rem;\n  min-width: 2.25rem;\n  padding: 0;\n  width: 2.25rem;\n}\n\n.logistics-page__remove-stop {\n  color: var(--color-danger, #b42318);\n}\n\n.logistics-page__route-builder-actions {\n  align-items: center;\n  border-top: 1px solid var(--color-border);\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  justify-content: flex-end;\n  margin-top: var(--space-4);\n  padding-top: var(--space-4);\n}\n\n.logistics-page__route-builder-actions {\n  align-items: start;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  justify-content: stretch;\n}\n\n.logistics-page__route-create-action {\n  display: grid;\n  gap: .35rem;\n  min-width: 0;\n}\n\n.logistics-page__route-create-action .dl-button { min-height: 2.6rem; width: 100%; }\n.logistics-page__route-create-action p { color: var(--color-muted-foreground); font-size: .75rem; line-height: 1.25; margin: 0; text-align: center; }\n\n.logistics-page__preparation-lists {\n  display: grid;\n  gap: .35rem;\n}\n\n.logistics-page__preparation-list,\n.logistics-page__preparation-empty {\n  align-items: center;\n  background: color-mix(in srgb, var(--color-surface-muted) 62%, transparent);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  display: flex;\n  gap: var(--space-2);\n  justify-content: space-between;\n  padding: .6rem .75rem;\n}\n\n.logistics-page__preparation-list > div { display: grid; gap: .15rem; }\n.logistics-page__preparation-list span,\n.logistics-page__preparation-list small,\n.logistics-page__preparation-empty span { color: var(--color-muted-foreground); font-size: .8125rem; }\n.logistics-page__preparation-empty { align-items: start; display: grid; gap: .2rem; }\n\n.logistics-page__route-action-helper {\n  grid-column: 1 / -1;\n  margin: 0;\n  color: var(--dl-text-muted);\n  font-size: 0.8125rem;\n}\n\n.logistics-page__courier-validation {\n  color: var(--color-danger, #b42318);\n  font-size: .8125rem;\n  grid-column: 3;\n  margin: calc(var(--space-2) * -1) 0 0;\n}\n\n.logistics-page__group {\n  align-content: start;\n}\n\n.logistics-page__route-stops-toggle {\n  justify-self: start;\n}\n\n/* Compact operational route summaries: identity stays left, action hierarchy\n   stays right, and stop details expand only on demand. */\n.logistics-page__groups > .logistics-page__group,\n.logistics-page__route-history .logistics-page__group,\n.logistics-page__in-progress-routes .logistics-page__group {\n  display: grid;\n  gap: .35rem var(--space-3);\n  grid-template-columns: minmax(0, 1fr) auto;\n  padding: .7rem .9rem;\n}\n\n.logistics-page__route-summary {\n  align-content: start;\n  display: grid;\n  gap: .16rem;\n  min-width: 0;\n}\n\n.logistics-page__print-route-header {\n  display: grid;\n  gap: .1rem;\n  margin: 0;\n}\n\n.logistics-page__print-route-header strong { font-size: .9375rem; overflow-wrap: anywhere; }\n.logistics-page__print-route-header span,\n.logistics-page__screen-only { font-size: .8125rem; }\n\n.logistics-page__group-actions {\n  align-items: center;\n  align-self: center;\n  flex-wrap: wrap;\n  gap: .35rem;\n  justify-content: flex-end;\n  margin: 0;\n}\n\n.logistics-page__group-actions .dl-button,\n.logistics-page__group-actions .dl-icon-button {\n  min-height: 2rem;\n}\n\n.logistics-page__action-icon { display: block; height: 1.25rem; width: 1.25rem; }\n.logistics-page__route-action-icon-button .dl-button__content { line-height: 0; }\n\n.logistics-page__group-actions .dl-icon-button {\n  height: 2rem;\n  width: 2rem;\n}\n\n.logistics-page__route-cancel-action {\n  color: var(--dl-color-danger);\n}\n\n.logistics-page__route-cancel-action:hover:not(:disabled) {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-strong);\n}\n\n.logistics-page__route-stops-toggle {\n  font-size: .8125rem;\n  min-height: 1.85rem;\n  padding: 0;\n}\n\n.logistics-page__group-actions + .logistics-page__assign-controls {\n  grid-column: 1 / -1;\n  justify-self: end;\n  width: min(100%, 30rem);\n}\n\n.logistics-page__print-stops {\n  border-top: 1px solid var(--color-border);\n  display: grid;\n  gap: 0;\n  grid-column: 1 / -1;\n  margin: .15rem 0 0;\n  padding: .35rem 0 0;\n}\n\n.logistics-page__print-stops li {\n  align-items: center;\n  display: grid;\n  gap: .1rem .5rem;\n  grid-template-columns: auto minmax(10rem, 1fr) auto;\n  padding: .32rem 0;\n}\n\n.logistics-page__print-stops li > span:nth-last-child(-n + 2) {\n  color: var(--color-muted-foreground);\n  font-size: .75rem;\n}\n\n.logistics-page__route-builder-actions .dl-button:first-child {\n  min-width: min(100%, 15rem);\n}\n\n.logistics-page__route-overview {\n  gap: var(--space-3);\n}\n\n.logistics-page__route-overview > div {\n  background: var(--color-surface);\n  border-color: color-mix(in srgb, var(--color-primary) 16%, var(--color-border));\n  box-shadow: none;\n  min-height: 5.75rem;\n}\n\n.logistics-page__route-overview strong {\n  font-size: clamp(1.2rem, 2vw, 1.65rem);\n}\n\n.logistics-page__groups > .logistics-page__group {\n  border-color: color-mix(in srgb, var(--color-border) 86%, transparent);\n  box-shadow: 0 2px 6px color-mix(in srgb, var(--color-foreground) 3%, transparent);\n}\n\n.logistics-page__route-history .logistics-page__group--history {\n  box-shadow: none;\n  padding: .5rem .7rem;\n}\n\n.logistics-page__route-history .logistics-page__group--history .logistics-page__group-actions {\n  align-self: start;\n}\n\n.logistics-page__route-history {\n  background: color-mix(in srgb, var(--color-surface-muted) 68%, transparent);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  margin-top: var(--space-4);\n  padding: var(--space-3) var(--space-4);\n}\n\n.logistics-page__in-progress-routes {\n  background: color-mix(in srgb, var(--color-primary) 7%, var(--color-surface));\n  border: 1px solid color-mix(in srgb, var(--color-primary) 30%, var(--color-border));\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: var(--space-2);\n  margin-bottom: var(--space-3);\n  padding: var(--space-3);\n}\n\n.logistics-page__in-progress-routes h2,\n.logistics-page__in-progress-routes p {\n  margin: 0;\n}\n\n.logistics-page__in-progress-routes h2 { font-size: .9375rem; }\n\n.logistics-page__in-progress-routes p {\n  color: var(--color-muted-foreground);\n  font-size: .8125rem;\n}\n\n.logistics-page__in-progress-routes .logistics-page__group {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n}\n\n.logistics-page__registry-tabs {\n  border-bottom: 1px solid var(--color-border);\n  display: flex;\n  gap: var(--space-1);\n  overflow-x: auto;\n}\n\n.logistics-page__registry-tabs button {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  color: var(--color-muted-foreground);\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: .875rem;\n  font-weight: 700;\n  gap: .4rem;\n  min-height: 2.5rem;\n  padding: .45rem .7rem;\n  white-space: nowrap;\n}\n\n.logistics-page__registry-tabs button[aria-selected=\"true\"] {\n  border-bottom-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.logistics-page__registry-tabs button:focus-visible {\n  outline: 2px solid var(--color-primary);\n  outline-offset: -2px;\n}\n\n.logistics-page__registry-tabs span {\n  align-items: center;\n  background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface-muted));\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: .75rem;\n  justify-content: center;\n  min-width: 1.45rem;\n  padding: .08rem .32rem;\n}\n\n.logistics-page__preparation-panel {\n  display: grid;\n  gap: var(--space-3);\n}\n\n.logistics-page__preparation-panel h2,\n.logistics-page__preparation-panel p { margin: 0; }\n.logistics-page__preparation-panel h2 { font-size: 1rem; }\n.logistics-page__preparation-panel p { color: var(--color-muted-foreground); font-size: .875rem; margin-top: .2rem; }\n\n/* Execution belongs to the active route, rather than looking like another\n   nested card. Keep stop actions compact and directly scannable. */\n.logistics-page__route-execution {\n  border: 0;\n  border-top: 1px solid var(--color-border);\n  gap: var(--space-2);\n  margin-top: var(--space-2);\n  padding: var(--space-3) 0 0;\n}\n\n.logistics-page__route-execution-heading {\n  align-items: baseline;\n  display: flex;\n  flex-wrap: wrap;\n  gap: .35rem .65rem;\n}\n\n.logistics-page__route-execution-heading span {\n  color: var(--color-muted-foreground);\n  font-size: .8125rem;\n}\n\n.logistics-page__route-execution .logistics-page__route-stop {\n  gap: .5rem;\n  padding: .65rem .75rem;\n}\n\n.logistics-page__route-execution .dl-textarea,\n.logistics-page__route-execution textarea { min-height: 3.25rem; }\n\n@media (max-width: 61rem) {\n  .logistics-page__route-settings,\n  .logistics-page__route-workspace {\n    grid-template-columns: 1fr;\n  }\n\n  .logistics-page__available-stop-list,\n  .logistics-page__selected-stop-list {\n    max-height: none;\n    overflow: visible;\n    padding-right: 0;\n  }\n}\n\n@media (max-width: 50rem) {\n  .logistics-page__available-stops-panel,\n  .logistics-page__route-preparation-panel {\n    padding: var(--space-3);\n  }\n\n  .logistics-page__candidate-contacts,\n  .logistics-page__selected-stop-contacts {\n    grid-template-columns: 1fr;\n  }\n\n  .logistics-page__selected-stop {\n    grid-template-columns: 2rem minmax(0, 1fr);\n  }\n\n  .logistics-page__selected-stop-actions {\n    grid-column: 1 / -1;\n    justify-content: flex-end;\n  }\n\n  .logistics-page__route-builder-actions {\n    align-items: stretch;\n    display: grid;\n    grid-template-columns: 1fr;\n  }\n\n  .logistics-page__route-create-action { width: 100%; }\n  .logistics-page__preparation-list { align-items: stretch; display: grid; }\n\n  .logistics-page__route-builder-actions .dl-button:first-child {\n    min-width: 0;\n  }\n\n  .logistics-page__courier-validation { grid-column: 1; }\n\n  .logistics-page__groups > .logistics-page__group,\n  .logistics-page__route-history .logistics-page__group {\n    grid-template-columns: 1fr;\n    padding: var(--space-3);\n  }\n\n  .logistics-page__group-actions { justify-content: flex-start; }\n\n  .logistics-page__route-action-icon-button { min-width: 2rem; }\n  .logistics-page__group-actions + .logistics-page__assign-controls {\n    justify-self: stretch;\n    width: 100%;\n  }\n\n  .logistics-page__print-stops li { grid-template-columns: auto minmax(0, 1fr); }\n  .logistics-page__print-stops li > .dl-status-badge,\n  .logistics-page__print-stops li > span:nth-last-child(-n + 2) { grid-column: 2; }\n}\n"],["STYLE",{},".status-page {\n  min-height: 100vh;\n  background: var(--dl-color-background);\n}\n\n.status-page__layout,\n.status-page__content {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.status-page__layout {\n  gap: var(--dl-space-3);\n  padding-block: var(--dl-space-4);\n}\n\n.status-page__header {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  align-items: center;\n  justify-content: space-between;\n}\n\n.status-page__header-actions {\n  margin-left: auto;\n}\n\n.status-page__header h1 {\n  margin: 0;\n}\n\n.status-page__header p,\n.status-page__muted,\n.status-page__bounded-note {\n  color: var(--dl-color-text-muted);\n  margin: var(--dl-space-1) 0 0;\n}\n\n.status-page__tabs {\n  display: flex;\n  flex-wrap: nowrap;\n  gap: var(--dl-space-2);\n  overflow-x: auto;\n  padding-bottom: var(--dl-space-1);\n}\n\n.status-page__kpi-card {\n  --tab-accent: var(--dl-color-primary);\n  --tab-accent-border: color-mix(in srgb, var(--tab-accent) 42%, var(--dl-color-border));\n  --tab-accent-surface: color-mix(in srgb, var(--tab-accent) 12%, var(--dl-color-surface));\n  --tab-accent-text: color-mix(in srgb, var(--tab-accent) 82%, var(--dl-color-text));\n  min-width: 144px;\n  min-height: 72px;\n  border: 1px solid var(--tab-accent-border);\n  border-radius: var(--dl-radius-md);\n  background: linear-gradient(180deg, color-mix(in srgb, var(--tab-accent) 16%, var(--dl-color-surface)) 0%, var(--tab-accent-surface) 100%);\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tab-accent) 8%, transparent);\n  color: var(--tab-accent-text);\n  padding: var(--dl-space-2) var(--dl-space-3) calc(var(--dl-space-2) - 0.1rem);\n  text-align: center;\n  transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease, background 140ms ease;\n}\n\n.status-page__kpi-card:nth-child(7n + 1) {\n  --tab-accent: var(--dl-color-primary);\n}\n\n.status-page__kpi-card:nth-child(7n + 2) {\n  --tab-accent: #2563eb;\n}\n\n.status-page__kpi-card:nth-child(7n + 3) {\n  --tab-accent: #059669;\n}\n\n.status-page__kpi-card:nth-child(7n + 4) {\n  --tab-accent: #d97706;\n}\n\n.status-page__kpi-card:nth-child(7n + 5) {\n  --tab-accent: #e11d48;\n}\n\n.status-page__kpi-card:nth-child(7n + 6) {\n  --tab-accent: #7c3aed;\n}\n\n.status-page__kpi-card:nth-child(7n) {\n  --tab-accent: #0891b2;\n}\n\n.status-page__kpi-card.is-selected {\n  --tab-accent-surface: color-mix(in srgb, var(--tab-accent) 18%, var(--dl-color-surface));\n  transform: translateY(-1px);\n}\n\n/* Total and Finalizate mark the bounds of the register: keep their cards as\n   visually explicit as the semantic states between them. */\n.status-page__kpi-card--all,\n.status-page__kpi-card--completed {\n  background: linear-gradient(180deg, color-mix(in srgb, var(--tab-accent) 16%, var(--dl-color-surface)) 0%, var(--tab-accent-surface) 100%);\n}\n\n.status-page__kpi-card--boundary {\n  border: 2px solid var(--tab-accent) !important;\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tab-accent) 16%, transparent), 0 0 0 1px color-mix(in srgb, var(--tab-accent) 32%, transparent) !important;\n  outline: 1px solid color-mix(in srgb, var(--tab-accent) 62%, transparent);\n  outline-offset: 0;\n}\n\n.status-page__kpi-tab {\n  background: transparent;\n  border: 0;\n  color: inherit;\n  cursor: pointer;\n  display: grid;\n  font: inherit;\n  gap: var(--dl-space-1);\n  height: 100%;\n  justify-items: center;\n  padding: 0;\n  width: 100%;\n}\n\n.status-page__kpi-tab strong {\n  color: var(--dl-color-text);\n  font-size: clamp(1.45rem, 2vw, 2.1rem);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n  white-space: nowrap;\n  transform: translateY(0.15rem);\n}\n\n.status-page__kpi-tab > span:first-child {\n  color: var(--dl-color-text);\n  font-size: 1.15rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.status-page__card-header-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  align-items: flex-start;\n  justify-content: space-between;\n}\n\n.status-page__card-header-row .dl-card__description {\n  max-width: 48rem;\n}\n\n.status-page__test-actions,\n.status-page__test-deadline {\n  align-items: center;\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-1);\n}\n\n.status-page__test-deadline {\n  flex-wrap: nowrap;\n  gap: .35rem;\n}\n\n.status-page__test-actions { position: relative; }\n\n.status-page__test-deadline input {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  color: var(--dl-color-text);\n  font: inherit;\n  min-height: 2.15rem;\n  min-width: 10.35rem;\n  padding: .3rem .4rem;\n}\n\n.status-page__deadline-attention {\n  align-items: center;\n  animation: status-page-deadline-pulse 1.2s ease-in-out infinite;\n  background: var(--dl-color-danger);\n  border-radius: 50%;\n  color: var(--dl-color-danger);\n  display: inline-flex;\n  color: #fff;\n  flex: 0 0 auto;\n  font-size: 1rem;\n  font-weight: 800;\n  justify-content: center;\n  line-height: 1;\n  min-height: 1.25rem;\n  min-width: 1.25rem;\n}\n\n@keyframes status-page-deadline-pulse {\n  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--dl-color-danger) 45%, transparent); transform: scale(1); }\n  50% { box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--dl-color-danger) 0%, transparent); transform: scale(1.12); }\n}\n\n.status-page__alert-dot {\n  align-items: center;\n  background: transparent;\n  border: 2px solid var(--dl-color-border);\n  border-radius: 50%;\n  color: transparent;\n  cursor: pointer;\n  display: inline-flex;\n  height: 1.35rem;\n  justify-content: center;\n  min-height: 0;\n  min-width: 1.35rem;\n  width: 1.35rem;\n}\n\n.status-page__alert-dot--marker_1 { background: #f4b942; border-color: #64748b; }\n.status-page__alert-dot--marker_2 { background: #60a5fa; border-color: #2563eb; }\n.status-page__alert-dot--marker_3 { background: #f87171; border-color: #dc2626; }\n.status-page__alert-dot--marker_4 { background: #a78bfa; border-color: #7c3aed; }\n.status-page__alert-dot--marker_5 { background: #34d399; border-color: #059669; }\n\n.status-page__alert-picker {\n  background: var(--dl-color-surface);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: inline-flex;\n  gap: 0.2rem;\n  left: 1.8rem;\n  padding: 0.25rem;\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 5;\n}\n\n.status-page__alert-choice {\n  border: 1px solid var(--dl-color-border);\n  border-radius: 50%;\n  cursor: pointer;\n  height: 0.85rem;\n  min-height: 0;\n  min-width: 0;\n  padding: 0;\n  width: 0.85rem;\n}\n\n.status-page__alert-choice.is-selected { box-shadow: 0 0 0 2px var(--dl-color-surface), 0 0 0 3px var(--dl-color-primary); }\n.status-page__alert-choice--none { background: var(--dl-color-surface); position: relative; }\n.status-page__alert-choice--none::after { color: var(--dl-color-text-muted); content: \"×\"; font-size: 0.7rem; left: 50%; line-height: 1; position: absolute; top: 50%; transform: translate(-50%, -50%); }\n.status-page__alert-choice--marker_1 { background: #f4b942; }\n.status-page__alert-choice--marker_2 { background: #60a5fa; }\n.status-page__alert-choice--marker_3 { background: #f87171; }\n.status-page__alert-choice--marker_4 { background: #a78bfa; }\n.status-page__alert-choice--marker_5 { background: #34d399; }\n\n.status-page__test-deadline small {\n  color: var(--dl-color-danger);\n  display: block;\n  width: 100%;\n}\n\n.status-page__work-link {\n  color: inherit;\n  text-decoration: none;\n}\n\n.status-page__work-link:hover {\n  color: var(--dl-color-primary);\n  text-decoration: underline;\n}\n\n.status-page__filters {\n  background: color-mix(in srgb, var(--dl-color-surface-muted) 58%, transparent);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: 1fr;\n  padding: var(--dl-space-3);\n}\n\n.status-page__filters .dl-field__label {\n  color: var(--dl-color-text-muted);\n  font-size: .75rem;\n  font-weight: 700;\n}\n\n.status-page__filters .dl-control { min-height: 2.35rem; }\n\n\n.status-page__pill {\n  align-items: center;\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: inline-flex;\n  font-size: var(--dl-font-size-sm);\n  font-weight: var(--dl-font-weight-semibold);\n  line-height: 1;\n  min-height: 28px;\n  padding: var(--dl-space-1) var(--dl-space-2);\n  width: max-content;\n}\n\n.status-page__pill--neutral {\n  background: var(--dl-color-surface-muted);\n  color: var(--dl-color-text);\n}\n\n.status-page__pill--info {\n  background: var(--dl-color-info-background);\n  border-color: var(--dl-color-info-border);\n  color: var(--dl-color-info-foreground);\n}\n\n.status-page__pill--success {\n  background: var(--dl-color-success-background);\n  border-color: var(--dl-color-success-border);\n  color: var(--dl-color-success-foreground);\n}\n\n.status-page__pill--warning {\n  background: var(--dl-color-warning-background);\n  border-color: var(--dl-color-warning-border);\n  color: var(--dl-color-warning-foreground);\n}\n\n.status-page__pill--danger {\n  background: var(--dl-color-danger-background);\n  border-color: var(--dl-color-danger-border);\n  color: var(--dl-color-danger-foreground);\n}\n\n.status-page__badge-stack,\n.status-page__technician,\n.status-page__owner {\n  display: grid;\n  gap: var(--dl-space-1);\n  min-width: 0;\n}\n\n.status-page__technician-badge {\n  border-radius: var(--dl-radius-sm);\n  box-shadow: inset 0 0 0 1px var(--dl-color-border);\n  display: inli