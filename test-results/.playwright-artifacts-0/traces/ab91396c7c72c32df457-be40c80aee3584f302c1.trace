_content {\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr);\n  min-width: 0;\n  min-height: 100dvh;\n}\n\n.app-shell__topbar {\n  align-items: center;\n  background: color-mix(in srgb, var(--dl-color-surface) 96%, var(--app-brand-primary));\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  min-height: 4rem;\n  padding: var(--dl-space-2) var(--dl-space-3);\n  position: sticky;\n  top: 0;\n  z-index: 40;\n}\n\n.app-shell__menu-button {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text);\n  cursor: pointer;\n  display: inline-grid;\n  font: inherit;\n  font-size: 1.25rem;\n  min-height: var(--dl-size-touch-target);\n  min-width: var(--dl-size-touch-target);\n  place-items: center;\n}\n\n.app-shell__topbar-title {\n  display: grid;\n  min-width: 0;\n}\n\n.app-shell__topbar-title--manager-home span {\n  font-size: var(--dl-font-size-card-title);\n  font-weight: var(--dl-font-weight-semibold);\n}\n\n.app-shell__notification-button { align-items: center; background: var(--dl-color-surface); border: 2px solid var(--app-brand-primary); border-radius: var(--dl-radius-md); color: inherit; cursor: pointer; display: inline-grid; font-size: 1.65rem; min-height: 3rem; min-width: 3.25rem; padding: .35rem .7rem; place-items: center; position: relative; }\n.app-shell__notification-button:hover, .app-shell__notification-button:focus-visible { background: var(--dl-color-accent-subtle); transform: scale(1.03); }\n.app-shell__notification-button--attention { animation: app-shell-notification-pulse 1.4s ease-in-out infinite; }\n.app-shell__notification-badge { align-items: center; background: #b91c1c; border: 2px solid var(--dl-color-surface); border-radius: 999px; color: #fff; display: inline-grid; font-siz