ot-allowed; opacity: 0.55; }\n.pricing-page__choice-grid > button span { color: var(--dl-color-muted); font-size: var(--dl-font-size-small); }\n.pricing-page__ordered-list { display: grid; gap: var(--dl-space-2); list-style: none; margin: 0; padding: 0; }\n.pricing-page__ordered-list li { align-items: center; background: var(--dl-color-surface); border: 1px solid var(--dl-color-border); border-radius: var(--dl-radius-sm); display: flex; gap: var(--dl-space-3); justify-content: space-between; padding: var(--dl-space-2) var(--dl-space-3); }\n.pricing-page__ordered-list li > div { display: flex; gap: var(--dl-space-1); }\n.pricing-page__field-error { color: var(--dl-color-danger); margin: 0; }\n.pricing-page__calculation-help { background: var(--dl-color-surface); border-left: 3px solid var(--dl-color-accent); color: var(--dl-color-muted); margin: 0; padding: var(--dl-space-3); }\n.pricing-page__calculation-help strong { color: var(--dl-color-text); }\n\n.pricing-page__modal-actions {\n  background: color-mix(in srgb, var(--dl-color-surface) 94%, transparent);\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n  bottom: calc(var(--dl-space-3) * -1);\n  margin: 0 calc(var(--dl-space-3) * -1) calc(var(--dl-space-3) * -1);\n  padding: var(--dl-space-3);\n  position: sticky;\n  z-index: 2;\n}\n\n.pricing-page__summary-grid {\n  grid-template-columns: 1fr;\n}\n\n.pricing-page__metric {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  padding: var(--dl-space-3);\n}\n\n.pricing-page__metric span {\n  color: var(--dl-color-muted);\n  display: block;\n  font-size: var(--dl-font-size-sm);\n}\n\n.pricing-page__metric strong {\n  display: block;\n  font-size: var(--dl-font-size-lg);\n  margin-top: var(--dl-space-1);\n}\n\n.pricing-page__drawer-section {\n  background: var(--dl-color-background-secondary);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-4);\n}\n\n.pricing-page__rule-editor {\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-sm);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.pricing-page__json {\n  font-family: var(--dl-font-family-mono);\n  min-height: 220px;\n}\n\n.pricing-page__chip-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.pricing-page__chip {\n  background: var(--dl-color-surface-muted);\n  border: 1px solid var(--dl-color-border);\n  border-radius: var(--dl-radius-pill);\n  color: var(--dl-color-text);\n  padding: var(--dl-space-1) var(--dl-space-2);\n}\n\n.pricing-page__catalog-print-view {\n  display: none;\n}\n\n@media print {\n  .pricing-page__catalog-print {\n    display: none !important;\n  }\n\n  .pricing-page__catalog-print-view {\n    display: block;\n    font-family: Arial, sans-serif;\n    padding-top: 1.25rem;\n  }\n\n  .pricing-page__catalog-print-view h1 {\n    border-bottom: 2px solid #0f766e;\n    color: #153b39;\n    font-size: 25px;\n    margin: 0;\n    padding-bottom: 10px;\n    text-align: center;\n  }\n\n  .pricing-page__catalog-print-view > p {\n    color: #61736f;\n    margin: 8px 0 24px;\n  }\n\n  .pricing-page__catalog-print-row {\n    align-items: center;\n    border-bottom: 1px solid #d5dfdc;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 14px;\n    min-height: 34px;\n    padding: 7px 0;\n  }\n\n  .pricing-page__catalog-print-symbol {\n    align-items: center;\n    background: #e7f1ef;\n    border: 1px solid #9bbdb7;\n    border-radius: 5px;\n    color: #0f766e;\n    display: inline-flex;\n    font-weight: 700;\n    justify-content: center;\n    min-height: 28px;\n  }\n\n  .pricing-page__catalog-print-row > span:last-child {\n    font-weight: 700;\n    text-align: right;\n  }\n}\n\n@media (min-width: 760px) {\n  .pricing-page__header {\n    align-items: start;\n    grid-template-columns: 1fr auto;\n  }\n\n  .pricing-page__filters,\n  .pricing-page__preview-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .pricing-page__filters--compact {\n    grid-template-columns: repeat(2, minmax(12rem, 18rem));\n  }\n\n  .pricing-page__filters--catalog {\n    grid-template-columns: minmax(16rem, 2fr) minmax(12rem, 1fr) minmax(10rem, 1fr);\n  }\n\n  .pricing-page__summary-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 759px) {\n  .pricing-page__header {\n    align-items: stretch;\n  }\n\n  .pricing-page__actions {\n    justify-content: stretch;\n  }\n\n  .pricing-page__actions .dl-button,\n  .pricing-page__toolbar > .dl-button {\n    flex: 1 1 auto;\n  }\n\n  .pricing-page__workspace-tabs > .dl-tabs__list {\n    border-radius: var(--dl-radius-sm);\n  }\n}\n\n@media print {\n  .app-shell__sidebar,\n  .app-shell__topbar,\n  .app-shell__header,\n  .pricing-page__header,\n  .pricing-page__readonly,\n  .pricing-page .dl-tabs__list,\n  .pricing-page__actions,\n  .pricing-page__filters,\n  .pricing-page__catalog-print .dl-card__header button,\n  .pricing-page__catalog-print .dl-data-table__pagination,\n  .pricing-page__catalog-print .dl-data-table__actions {\n    display: none !important;\n  }\n\n  .app-shell__main,\n  .pricing-page,\n  .pricing-page__layout,\n  .pricing-page__catalog-print,\n  .pricing-page__catalog-print .dl-card,\n  .pricing-page__catalog-print .dl-card__content {\n    background: #fff;\n    display: block;\n    max-width: none;\n    padding: 0;\n  }\n\n  .pricing-page__catalog-print .dl-card {\n    border: 0;\n    box-shadow: none;\n  }\n\n  .pricing-page__catalog-print .dl-card__header {\n    border-bottom: 2px solid #0f766e;\n    display: block;\n    margin-bottom: 18px;\n    padding: 0 0 12px;\n  }\n\n  .pricing-page__catalog-print .dl-card__header h2 {\n    color: #102a2a;\n    font-size: 24px;\n  }\n\n  .pricing-page__catalog-print .dl-data-table,\n  .pricing-page__catalog-print .dl-