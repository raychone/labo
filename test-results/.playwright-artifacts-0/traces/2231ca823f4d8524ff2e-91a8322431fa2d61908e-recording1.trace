ground: var(--dl-status-closed-background);\n  border-color: var(--dl-status-closed-border);\n  color: var(--dl-status-closed-foreground);\n}\n\n.dl-priority-badge--low {\n  background: var(--dl-color-neutral-background);\n  color: var(--dl-color-neutral-foreground);\n}\n\n.dl-priority-badge--normal {\n  background: var(--dl-color-info-background);\n  color: var(--dl-color-info-foreground);\n}\n\n.dl-priority-badge--high {\n  background: var(--dl-color-warning-background);\n  color: var(--dl-color-warning-foreground);\n}\n\n.dl-priority-badge--urgent {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dl-overlay {\n  align-items: center;\n  background: rgb(23 32 27 / 48%);\n  display: flex;\n  inset: 0;\n  justify-content: center;\n  padding: 0;\n  position: fixed;\n  z-index: var(--dl-z-modal);\n}\n\n.dl-modal,\n.dl-drawer {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  box-shadow: var(--dl-shadow-md);\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  max-height: calc(100dvh - 2rem);\n  overflow: hidden;\n}\n\n.dl-modal {\n  border-radius: var(--dl-radius-lg);\n  height: auto;\n  max-height: calc(100dvh - 2rem);\n  width: min(calc(100vw - 2rem), var(--dl-modal-width, 48rem));\n}\n\n.dl-modal--sm {\n  --dl-modal-width: 28rem;\n}\n\n.logout-confirm-modal {\n  text-align: center;\n  width: min(calc(100vw - 2rem), 28rem);\n}\n\n.logout-confirm-modal .dl-overlay__header {\n  align-items: center;\n}\n\n.logout-confirm-modal .dl-overlay__header > div {\n  flex: 1;\n}\n\n.logout-confirm-modal .dl-overlay__content {\n  display: grid;\n  place-items: center;\n}\n\n.logout-confirm-modal .dl-overlay__footer {\n  justify-content: center;\n}\n\n.dl-modal--md {\n  --dl-modal-width: 48rem;\n}\n\n.dl-modal--lg {\n  --dl-modal-width: 64rem;\n}\n\n.dl-modal--xl {\n  --dl-modal-width: 80rem;\n}\n\n.dl-modal--full {\n  --dl-modal-width: 100vw;\n  box-sizing: border-box;\n  height: min(100dvh, 100%);\n  max-height: 100%;\n}\n\n.dl-drawer {\n  border-radius: 0;\n  height: 100dvh;\n  max-height: 100dvh;\n  position: fixed;\n  width: 100vw;\n}\n\n.dl-drawer--right {\n  bottom: 0;\n  right: 0;\n  top: 0;\n}\n\n.dl-drawer--bottom {\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.dl-overlay__header,\n.dl-overlay__footer {\n  align-items: flex-start;\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  display: flex;\n  gap: var(--dl-space-4);\n  justify-content: space-between;\n  padding: max(var(--dl-space-3), env(safe-area-inset-top)) max(var(--dl-space-3), env(safe-area-inset-right)) max(var(--dl-space-3), env(safe-area-inset-bottom)) max(var(--dl-space-3), env(safe-area-inset-left));\n}\n\n.dl-overlay__footer {\n  border-bottom: 0;\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n  justify-content: flex-end;\n  padding-bottom: max(var(--dl-space-3), env(safe-area-inset-bottom));\n}\n\n.dl-overlay__content {\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  padding: var(--dl-space-3) max(var(--dl-space-3), env(safe-area-inset-right)) var(--dl-space-3) max(var(--dl-space-3), env(safe-area-inset-left));\n  -webkit-overflow-scrolling: touch;\n}\n\n.dl-overlay__close {\n  background: transparent;\n  border: 0;\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text-secondary);\n  min-height: var(--dl-size-touch-target);\n  min-width: var(--dl-size-touch-target);\n}\n\n@media (max-width: 47.99rem) {\n  .dl-overlay {\n    padding: var(--dl-space-3);\n  }\n\n  .dl-modal {\n    max-height: calc(100dvh - 2rem);\n    width: 100%;\n  }\n\n  .dl-modal--full {\n    height: 100%;\n    max-height: 100%;\n  }\n\n  .logout-confirm-modal {\n    width: min(calc(100vw - 2rem), 28rem);\n  }\n}\n\n.dl-toast-region {\n  display: grid;\n  gap: var(--dl-space-3);\n  position: fixed;\n  right: var(--dl-space-4);\n  top: var(--dl-space-4);\n  width: min(calc(100vw - var(--dl-space-8)), 24rem);\n  z-index: var(--dl-z-toast);\n}\n\n.dl-toast {\n  align-items: flex-start;\n  background: var(--dl-color-surface-elevated);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-left-width: 4px;\n  border-radius: var(--dl-radius-lg);\n  box-shadow: var(--dl-shadow-md);\n  display: flex;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n  padding: var(--dl-space-3);\n}\n\n.dl-toast--success {\n  border-left-color: var(--dl-color-success);\n}\n\n.dl-toast--info {\n  border-left-color: var(--dl-color-info);\n}\n\n.dl-toast--warning {\n  border-left-color: var(--dl-color-warning);\n}\n\n.dl-toast--error {\n  border-left-color: var(--dl-color-danger);\n}\n\n.dl-toast__content {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-tooltip {\n  display: inline-flex;\n  position: relative;\n}\n\n.dl-tooltip__content {\n  background: #ffffff;\n  border: 1px solid var(--dl-color-border);\n  box-shadow: var(--dl-shadow-md);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-foreground);\n  font-size: var(--dl-font-size-small);\n  max-width: 18rem;\n  padding: var(--dl-space-2) var(--dl-space-3);\n  position: absolute;\n  width: max-content;\n  z-index: var(--dl-z-dropdown);\n}\n\n.dl-tooltip__content--top {\n  bottom: calc(100% + var(--dl-space-2));\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.dl-tooltip__content--bottom {\n  left: 50%;\n  top: calc(100% + var(--dl-space-2));\n  transform: translateX(-50%);\n}\n\n.dl-state {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: center;\n  padding: var(--dl-space-6);\n  text-align: center;\n}\n\n.dl-loading-state {\n  align-items: center;\n  display: inline-flex;\n  justify-content: center;\n}\n\n.dl-loading-state--small {\n  padding: var(--dl-space-3);\n}\n\n.dl-loading-state--large {\n  padding: var(--dl-space-10);\n}\n\n.dl-error-state {\n  border-color: var(--dl-color-danger-border);\n}\n\n.dl-accordion {\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  overflow: hidden;\n}\n\n.dl-accordion__item + .dl-accordion__item {\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n}\n\n.dl-accordion__trigger {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: 0;\n  color: var(--dl-color-text);\n  display: flex;\n  justify-content: space-between;\n  padding: var(--dl-space-4);\n  width: 100%;\n}\n\n.dl-accordion__panel {\n  background: var(--dl-color-background-secondary);\n  padding: var(--dl-space-4);\n}\n\n.dl-tabs {\n  display: grid;\n  gap: var(--dl-space-4);\n}\n\n.dl-tabs__list {\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  display: flex;\n  gap: var(--dl-space-2);\n  overflow-x: auto;\n}\n\n.dl-tabs__tab {\n  background: transparent;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  color: var(--dl-color-text-secondary);\n  min-height: var(--dl-size-touch-target);\n  padding-inline: var(--dl-space-3);\n}\n\n.dl-tabs__tab[aria-selected=\"true\"] {\n  border-bottom-color: var(--dl-color-accent);\n  color: var(--dl-color-accent);\n}\n\n.dl-search-input {\n  display: grid;\n  gap: var(--dl-space-2);\n  position: relative;\n}\n\n.dl-search-input__icon {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-caption);\n  left: var(--dl-space-3);\n  pointer-events: none;\n  position: absolute;\n  top: 2.55rem;\n  z-index: 1;\n}\n\n.dl-search-input__control {\n  padding-left: var(--dl-space-10);\n}\n\n.dl-search-input__clear,\n.dl-search-input__loading {\n  position: absolute;\n  right: var(--dl-space-2);\n  top: 2.2rem;\n}\n\n.dl-filter-bar {\n  align-items: end;\n  display: grid;\n  gap: var(--dl-space-3);\n}\n\n.dl-filter-bar__actions,\n.dl-filter-bar__filters {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.dl-timeline,\n.dl-stepper {\n  display: grid;\n  gap: var(--dl-space-4);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.dl-timeline__item,\n.dl-stepper__item {\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: auto 1fr;\n}\n\n.dl-timeline__marker,\n.dl-stepper__marker {\n  align-items: center;\n  background: var(--dl-color-accent-subtle);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-full);\n  color: var(--dl-color-accent);\n  display: inline-flex;\n  font-weight: var(--dl-font-weight-semibold);\n  height: 2rem;\n  justify-content: center;\n  width: 2rem;\n}\n\n.dl-timeline__content,\n.dl-stepper__text {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-stepper--horizontal {\n  grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));\n}\n\n.dl-stepper__item--completed .dl-stepper__marker {\n  background: var(--dl-color-success-background);\n  color: var(--dl-color-success-foreground);\n}\n\n.dl-stepper__item--current .dl-stepper__marker {\n  background: var(--dl-color-accent);\n  color: #ffffff;\n}\n\n.dl-stepper__item--error .dl-stepper__marker {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dl-file-upload {\n  align-items: center;\n  background: var(--dl-color-background-secondary);\n  border: 1px dashed var(--dl-color-border-strong);\n  border-radius: var(--dl-radius-lg);\n  cursor: pointer;\n  display: flex;\n  justify-content: center;\n  min-height: 7rem;\n  padding: var(--dl-space-4);\n  text-align: center;\n}\n\n.dl-file-upload input {\n  height: 1px;\n  opacity: 0;\n  position: absolute;\n  width: 1px;\n}\n\n.dl-file-upload--disabled {\n  cursor: not-allowed;\n  opacity: 0.62;\n}\n\n.dl-file-upload__list {\n  display: grid;\n  gap: var(--dl-space-2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.dl-file-upload__list li {\n  align-items