{"type":"frame-snapshot","snapshot":{"callId":"call@465","snapshotName":"after@call@465","pageId":"page@b446bd4c84374faa2843c6c7527a96fc","frameId":"frame@8e5c89ccd17a21a5aa61475efe65a9d8","frameUrl":"http://127.0.0.1:3138/billing","doctype":"html","html":["HTML",{"lang":"ro"},["HEAD",{},[[4,0]],[[4,1]],[[4,2]],[[4,3]],[[4,4]],[[4,5]],[[4,6]],[[4,7]],[[2,1]],[[4,10]],[[4,12]],[[4,14]],[[4,16]],["STYLE",{},".billing-page {\n  display: grid;\n  gap: var(--dl-space-4);\n  padding: var(--dl-layout-page-padding);\n}\n\n.billing-page__header,\n.billing-page__toolbar {\n  align-items: flex-start;\n  display: flex;\n  flex-direction: column;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__header h1 {\n  font-size: var(--dl-font-size-page-title);\n}\n\n.billing-page__eyebrow,\n.billing-page__readonly {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-page__quick-actions,\n.billing-page__toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n}\n\n.billing-page__period-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n}\n\n.billing-page__period-selector {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  display: grid;\n  gap: var(--dl-space-2);\n  grid-template-columns: auto minmax(10rem, 1fr) auto;\n  padding: var(--dl-space-1);\n  text-align: center;\n}\n\n.billing-page__period-selector strong {\n  text-transform: capitalize;\n}\n\n.billing-page__archive-indicator {\n  background: color-mix(in srgb, var(--dl-color-success) 12%, var(--dl-color-surface));\n  border: 1px solid color-mix(in srgb, var(--dl-color-success) 35%, var(--dl-color-border));\n  border-radius: 999px;\n  color: var(--dl-color-success);\n  font-size: var(--dl-font-size-small);\n  font-weight: var(--dl-font-weight-semibold);\n  padding: var(--dl-space-2) var(--dl-space-3);\n}\n\n.billing-page__actions-menu {\n  position: relative;\n}\n\n.billing-page__actions-trigger {\n  min-height: var(--dl-size-touch-target);\n}\n\n.billing-page__actions-menu > div {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  box-shadow: var(--dl-shadow-lg, 0 0.75rem 2rem rgb(15 23 42 / 14%));\n  display: grid;\n  gap: var(--dl-space-2);\n  min-inline-size: 15rem;\n  padding: var(--dl-space-2);\n  position: absolute;\n  right: 0;\n  top: calc(100% + var(--dl-space-2));\n  z-index: 20;\n}\n\n.billing-page__actions-menu .dl-button {\n  justify-content: flex-start;\n  width: 100%;\n}\n\n.billing-page__filters,\n.billing-page__cards,\n.billing-page__registry-summary,\n.billing-page__month-close {\n  display: grid;\n  gap: var(--dl-space-4);\n  grid-template-columns: 1fr;\n}\n\n.billing-page__cards > *,\n.billing-month-registry__summary > * {\n  --kpi-accent: var(--app-brand-primary);\n  --kpi-accent-border: color-mix(in srgb, var(--kpi-accent) 28%, var(--dl-color-border));\n  --kpi-accent-surface: color-mix(in srgb, var(--kpi-accent) 8%, var(--dl-color-surface));\n  --kpi-accent-text: color-mix(in srgb, var(--kpi-accent) 82%, var(--dl-color-text));\n}\n\n.billing-page__cards > *:nth-child(6n + 1),\n.billing-month-registry__summary > *:nth-child(6n + 1) {\n  --kpi-accent: var(--app-brand-primary);\n}\n\n.billing-page__cards > *:nth-child(6n + 2),\n.billing-month-registry__summary > *:nth-child(6n + 2) {\n  --kpi-accent: #2563eb;\n}\n\n.billing-page__cards > *:nth-child(6n + 3),\n.billing-month-registry__summary > *:nth-child(6n + 3) {\n  --kpi-accent: #059669;\n}\n\n.billing-page__cards > *:nth-child(6n + 4),\n.billing-month-registry__summary > *:nth-child(6n + 4) {\n  --kpi-accent: #d97706;\n}\n\n.billing-page__cards > *:nth-child(6n + 5),\n.billing-month-registry__summary > *:nth-child(6n + 5) {\n  --kpi-accent: #e11d48;\n}\n\n.billing-page__cards > *:nth-child(6n),\n.billing-month-registry__summary > *:nth-child(6n) {\n  --kpi-accent: #7c3aed;\n}\n\n.billing-page__filters-shell {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  padding: var(--dl-space-3);\n}\n\n.billing-page__quick-filters {\n  align-items: end;\n  display: grid;\n  gap: var(--dl-space-3);\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.billing-page__toolbar--filters {\n  align-items: center;\n}\n\n.billing-page__cards strong {\n  font-size: var(--dl-font-size-section-title);\n}\n\n.billing-page__kpi-card {\n  align-content: center;\n  background: var(--kpi-accent-surface);\n  border: var(--dl-border-width) solid var(--kpi-accent-border);\n  border-radius: var(--dl-radius-md);\n  color: inherit;\n  cursor: pointer;\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: center;\n  min-height: 5.5rem;\n  overflow: hidden;\n  padding: calc(var(--dl-space-4) + 0.15rem) var(--dl-space-4) var(--dl-space-4);\n  text-align: center;\n  position: relative;\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list {\n  background: var(--dl-color-background-secondary);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-md);\n  gap: var(--dl-space-1);\n  padding: var(--dl-space-1);\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list > .dl-tabs__tab {\n  border: 1px solid transparent;\n  border-radius: calc(var(--dl-radius-md) - 0.15rem);\n  flex: 0 0 auto;\n  font-weight: var(--dl-font-weight-semibold);\n  min-height: 2.6rem;\n  padding-inline: var(--dl-space-4);\n}\n\n.billing-page__workspace-tabs > .dl-tabs__list > .dl-tabs__tab[aria-selected=\"true\"] {\n  background: var(--dl-color-surface);\n  border-color: color-mix(in srgb, var(--dl-color-accent) 38%, var(--dl-color-border));\n  box-shadow: var(--dl-shadow-sm);\n  color: var(--dl-color-accent);\n}\n\n.billing-page__kpi-card::before {\n  background: var(--kpi-accent);\n  content: \"\";\n  inset: 0 auto auto 0;\n  height: 0.35rem;\n  position: absolute;\n  width: 100%;\n}\n\n.billing-page__kpi-card:hover {\n  border-color: color-mix(in srgb, var(--app-brand-primary) 28%, var(--dl-color-border));\n  box-shadow: 0 2px 12px color-mix(in srgb, var(--app-brand-primary) 8%, transparent);\n}\n\n.billing-page__kpi-card:focus-visible {\n  outline: 2px solid var(--app-brand-primary);\n  outline-offset: 2px;\n}\n\n.billing-page__kpi-label,\n.billing-page__kpi-meta {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-page__kpi-value {\n  color: var(--kpi-accent-text);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.billing-page__kpi-label {\n  color: var(--dl-color-text-muted);\n  font-size: var(--dl-font-size-small);\n}\n\n.billing-page__kpi-value {\n  color: var(--kpi-accent-text);\n  font-size: var(--dl-font-size-section-title);\n  line-height: 1.05;\n}\n\n.billing-page__kpi-meta {\n  color: var(--dl-color-text-muted);\n}\n\n.billing-page__tab {\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: stretch;\n  min-width: 0;\n  padding-block: var(--dl-space-4);\n}\n\n.billing-page__tab-toolbar {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n  min-width: 0;\n  width: 100%;\n}\n\n.billing-page__tab-toolbar-context,\n.billing-page__tab-toolbar-actions {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--dl-space-2);\n  min-width: 0;\n}\n\n.billing-page__tab-toolbar-context p {\n  color: var(--dl-color-text-muted);\n  margin: 0;\n}\n\n.billing-page__tab-toolbar-actions {\n  justify-content: flex-end;\n  margin-inline-start: auto;\n}\n\n.billing-page__tab-toolbar-actions .dl-button {\n  flex: 0 0 auto;\n  min-height: var(--dl-size-touch-target);\n  white-space: nowrap;\n}\n\n.billing-page__row-selection-control {\n  align-items: center;\n  display: inl