e--draft {\n  background: var(--dl-status-draft-background);\n  border-color: var(--dl-status-draft-border);\n  color: var(--dl-status-draft-foreground);\n}\n\n.dl-status-badge--registered {\n  background: var(--dl-status-registered-background);\n  border-color: var(--dl-status-registered-border);\n  color: var(--dl-status-registered-foreground);\n}\n\n.dl-status-badge--awaiting,\n.dl-status-badge--payment {\n  background: var(--dl-status-awaiting-background);\n  border-color: var(--dl-status-awaiting-border);\n  color: var(--dl-status-awaiting-foreground);\n}\n\n.dl-status-badge--planned {\n  background: var(--dl-status-planned-background);\n  border-color: var(--dl-status-planned-border);\n  color: var(--dl-status-planned-foreground);\n}\n\n.dl-status-badge--production {\n  background: var(--dl-status-production-background);\n  border-color: var(--dl-status-production-border);\n  color: var(--dl-status-production-foreground);\n}\n\n.dl-status-badge--quality {\n  background: var(--dl-status-quality-background);\n  border-color: var(--dl-status-quality-border);\n  color: var(--dl-status-quality-foreground);\n}\n\n.dl-status-badge--rejected,\n.dl-status-badge--cancelled {\n  background: var(--dl-status-rejected-background);\n  border-color: var(--dl-status-rejected-border);\n  color: var(--dl-status-rejected-foreground);\n}\n\n.dl-status-badge--approved,\n.dl-status-badge--delivered,\n.dl-status-badge--paid {\n  background: var(--dl-status-approved-background);\n  border-color: var(--dl-status-approved-border);\n  color: var(--dl-status-approved-foreground);\n}\n\n.dl-status-badge--delivery {\n  background: var(--dl-status-delivery-background);\n  border-color: var(--dl-status-delivery-border);\n  color: var(--dl-status-delivery-foreground);\n}\n\n.dl-status-badge--invoiced {\n  background: var(--dl-status-invoiced-background);\n  border-color: var(--dl-status-invoiced-border);\n  color: var(--dl-status-invoiced-foreground);\n}\n\n.dl-status-badge--closed {\n  background: var(--dl-status-closed-background);\n  border-color: var(--dl-status-closed-border);\n  color: var(--dl-status-closed-foreground);\n}\n\n.dl-priority-badge--low {\n  background: var(--dl-color-neutral-background);\n  color: var(--dl-color-neutral-foreground);\n}\n\n.dl-priority-badge--normal {\n  background: var(--dl-color-info-background);\n  color: var(--dl-color-info-foreground);\n}\n\n.dl-priority-badge--high {\n  background: var(--dl-color-warning-background);\n  color: var(--dl-color-warning-foreground);\n}\n\n.dl-priority-badge--urgent {\n  background: var(--dl-color-danger-background);\n  color: var(--dl-color-danger-foreground);\n}\n\n.dl-overlay {\n  align-items: center;\n  background: rgb(23 32 27 / 48%);\n  display: flex;\n  inset: 0;\n  justify-content: center;\n  padding: 0;\n  position: fixed;\n  z-index: var(--dl-z-modal);\n}\n\n.dl-modal,\n.dl-drawer {\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  box-shadow: var(--dl-shadow-md);\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  max-height: calc(100dvh - 2rem);\n  overflow: hidden;\n}\n\n.dl-modal {\n  border-radius: var(--dl-radius-lg);\n  height: auto;\n  max-height: calc(100dvh - 2rem);\n  width: min(calc(100vw - 2rem), var(--dl-modal-width, 48rem));\n}\n\n.dl-modal--sm {\n  --dl-modal-width: 28rem;\n}\n\n.logout-confirm-modal {\n  text-align: center;\n  width: min(calc(100vw - 2rem), 28rem);\n}\n\n.logout-confirm-modal .dl-overlay__header {\n  align-items: center;\n}\n\n.logout-confirm-modal .dl-overlay__header > div {\n  flex: 1;\n}\n\n.logout-confirm-modal .dl-overlay__content {\n  display: grid;\n  place-items: center;\n}\n\n.logout-confirm-modal .dl-overlay__footer {\n  justify-content: center;\n}\n\n.dl-modal--md {\n  --dl-modal-width: 48rem;\n}\n\n.dl-modal--lg {\n  --dl-modal-width: 64rem;\n}\n\n.dl-modal--xl {\n  --dl-modal-width: 80rem;\n}\n\n.dl-modal--full {\n  --dl-modal-width: 100vw;\n  box-sizing: border-box;\n  height: min(100dvh, 100%);\n  max-height: 100%;\n}\n\n.dl-drawer {\n  border-radius: 0;\n  height: 100dvh;\n  max-height: 100dvh;\n  position: fixed;\n  width: 100vw;\n}\n\n.dl-drawer--right {\n  bottom: 0;\n  right: 0;\n  top: 0;\n}\n\n.dl-drawer--bottom {\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.dl-overlay__header,\n.dl-overlay__footer {\n  align-items: flex-start;\n  border-bottom: var(--dl-border-width) solid var(--dl-color-border);\n  display: flex;\n  gap: var(--dl-space-4);\n  justify-content: space-between;\n  padding: max(var(--dl-space-3), env(safe-area-inset-top)) max(var(--dl-space-3), env(safe-area-inset-right)) max(var(--dl-space-3), env(safe-area-inset-bottom)) max(var(--dl-space-3), env(safe-area-inset-left));\n}\n\n.dl-overlay__footer {\n  border-bottom: 0;\n  border-top: var(--dl-border-width) solid var(--dl-color-border);\n  justify-content: flex-end;\n  padding-bottom: max(var(--dl-space-3), env(safe-area-inset-bottom));\n}\n\n.dl-overlay__content {\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  padding: var(--dl-space-3) max(var(--dl-space-3), env(safe-area-inset-right)) var(--dl-space-3) max(var(--dl-space-3), env(safe-area-inset-left));\n  -webkit-overflow-scrolling: touch;\n}\n\n.dl-overlay__close {\n  background: transparent;\n  border: 0;\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-text-secondary);\n  min-height: var(--dl-size-touch-target);\n  min-width: var(--dl-size-touch-target);\n}\n\n@media (max-width: 47.99rem) {\n  .dl-overlay {\n    padding: var(--dl-space-3);\n  }\n\n  .dl-modal {\n    max-height: calc(100dvh - 2rem);\n    width: 100%;\n  }\n\n  .dl-modal--full {\n    height: 100%;\n    max-height: 100%;\n  }\n\n  .logout-confirm-modal {\n    width: min(calc(100vw - 2rem), 28rem);\n  }\n}\n\n.dl-toast-region {\n  display: grid;\n  gap: var(--dl-space-3);\n  position: fixed;\n  right: var(--dl-space-4);\n  top: var(--dl-space-4);\n  width: min(calc(100vw - var(--dl-space-8)), 24rem);\n  z-index: var(--dl-z-toast);\n}\n\n.dl-toast {\n  align-items: flex-start;\n  background: var(--dl-color-surface-elevated);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-left-width: 4px;\n  border-radius: var(--dl-radius-lg);\n  box-shadow: var(--dl-shadow-md);\n  display: flex;\n  gap: var(--dl-space-3);\n  justify-content: space-between;\n  padding: var(--dl-space-3);\n}\n\n.dl-toast--success {\n  border-left-color: var(--dl-color-success);\n}\n\n.dl-toast--info {\n  border-left-color: var(--dl-color-info);\n}\n\n.dl-toast--warning {\n  border-left-color: var(--dl-color-warning);\n}\n\n.dl-toast--error {\n  border-left-color: var(--dl-color-danger);\n}\n\n.dl-toast__content {\n  display: grid;\n  gap: var(--dl-space-1);\n}\n\n.dl-tooltip {\n  display: inline-flex;\n  position: relative;\n}\n\n.dl-tooltip__content {\n  background: #ffffff;\n  border: 1px solid var(--dl-color-border);\n  box-shadow: var(--dl-shadow-md);\n  border-radius: var(--dl-radius-md);\n  color: var(--dl-color-foreground);\n  font-size: var(--dl-font-size-small);\n  max-width: 18rem;\n  padding: var(--dl-space-2) var(--dl-space-3);\n  position: absolute;\n  width: max-content;\n  z-index: var(--dl-z-dropdown);\n}\n\n.dl-tooltip__content--top {\n  bottom: calc(100% + var(--dl-space-2));\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.dl-tooltip__content--bottom {\n  left: 50%;\n  top: calc(100% + var(--dl-space-2));\n  transform: translateX(-50%);\n}\n\n.dl-state {\n  align-items: center;\n  background: var(--dl-color-surface);\n  border: var(--dl-border-width) solid var(--dl-color-border);\n  border-radius: var(--dl-radius-lg);\n  display: grid;\n  gap: var(--dl-space-3);\n  justify-items: center;\n  padding: var(--dl-space-6);\n  text-align: center;\n}\n\n.dl-loading-state {\n  align-items: center;\n  display: inline-flex;\n  justify-content: center;\n}\n\n.dl-loading-state--small {\n  padding: var(--dl-space-3);\n}\n\n.dl-loading-state