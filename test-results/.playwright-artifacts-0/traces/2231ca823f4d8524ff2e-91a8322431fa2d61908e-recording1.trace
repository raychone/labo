ge__row-main strong,\n.logistics-page__code {\n  color: var(--color-foreground);\n  font-weight: 800;\n}\n\n.logistics-page__row-main span,\n.logistics-page__row-meta,\n.logistics-page__group > .logistics-page__print-route-header > span,\n.logistics-page__group > .logistics-page__screen-only,\n.logistics-page__group .logistics-page__print-stops > li > span,\n.logistics-page__drawer p {\n  color: var(--color-muted-foreground);\n}\n\n.logistics-page__row-meta {\n  display: grid;\n  gap: var(--space-3);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  font-size: var(--font-size-sm);\n}\n\n.logistics-page__row-state,\n.logistics-page__row-alerts {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  min-width: 0;\n}\n\n.logistics-page__row-alerts {\n  position: relative;\n}\n\n.logistics-page__row-requirements {\n  align-items: start;\n  display: grid;\n  gap: var(--space-2);\n}\n\n.logistics-page__requirement {\n  align-items: center;\n  display: flex;\n  gap: var(--space-2);\n  white-space: nowrap;\n}\n\n.logistics-page__row-state .dl-field {\n  margin: 0;\n  min-width: 148px;\n}\n\n.logistics-page__row-state .dl-control {\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  min-height: 40px;\n}\n\n.logistics-page__state-picker {\n  min-width: 148px;\n  position: relative;\n}\n\n.logistics-page__state-picker-trigger {\n  align-items: center;\n  background: var(--color-surface, #ffffff);\n  border: 1px solid var(--color-border, #d5dedb);\n  border-radius: var(--radius-sm);\n  color: var(--color-text, #1b2522);\n  display: flex;\n  font-weight: 600;\n  justify-content: space-between;\n  min-height: 40px;\n  padding: 0 var(--space-3);\n  width: 100%;\n}\n\n.logistics-page__state-picker-trigger:hover,\n.logistics-page__state-picker-trigger[aria-expanded=\"true\"] {\n  border-color: var(--color-primary, #0f766e);\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary, #0f766e) 14%, transparent);\n}\n\n.logistics-page__state-picker-chevron {\n  border-bottom: 2px solid currentColor;\n  border-right: 2px solid currentColor;\n  height: 8px;\n  transform: rotate(45deg) translateY(-2px);\n  width: 8px;\n}\n\n.logistics-page__state-picker-menu {\n  background: var(--color-surface, #ffffff);\n  border: 1px solid var(--color-border, #d5dedb);\n  border-radius: var(--radius-sm);\n  box-shadow: var(--shadow-md, 0 12px 28px rgb(16 34 29 / 18%));\n  display: grid;\n  gap: 3px;\n  left: 0;\n  min-width: 100%;\n  padding: var(--space-1);\n  position: absolute;\n  top: calc(100% + 5px);\n  z-index: 10;\n}\n\n.logistics-page__state-picker-option {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  border-radius: calc(var(--radius-sm) - 2px);\n  color: var(--color-text, #1b2522);\n  display: grid;\n  gap: var(--space-2);\n  grid-template-columns: 1rem 1fr;\n  min-height: 38px;\n  padding: 0 var(--space-2);\n  text-align: left;\n  white-space: nowrap;\n}\n\n.logistics-page__state-picker-option:hover,\n.logistics-page__state-picker-option.is-selected {\n  background: var(--color-surface-muted, #edf4f2);\n  color: var(--color-primary, #0f766e);\n}\n\n.logistics-page__row-alerts .logistics-page__marker,\n.logistics-page__marker-menu .logistics-page__marker {\n  align-self: center;\n  aspect-ratio: 1 / 1;\n  border-radius: 50%;\n  flex: 0 0 24px;\n  height: 24px;\n  max-height: 24px;\n  max-width: 24px;\n  min-height: 24px;\n  min-width: 24px;\n  width: 24px;\n}\n\n.logistics-page__requirement input {\n  accent-color: var(--color-primary, #0f766e);\n  height: 16px;\n  margin: 0;\n  width: 16px;\n}\n\n.logistics-page__row-meta > div {\n  display: grid;\n  gap: var(--space-1);\n  min-width: 0;\n}\n\n.logistics-page__row-meta > div > span {\n  color: var(--color-muted-foreground);\n  font-size: var(--font-size-xs);\n}\n\n.logistics-page__row-meta strong {\n  color: var(--color-foreground);\n  overflow-wrap: anywhere;\n}\n\n.logistics-page__row-actions {\n  align-items: center;\n  justify-content: flex-end;\n}\n\n.logistics-page__note-editor {\n  display: grid;\n  gap: var(--space-4);\n}\n\n.logistics-page__note-actions {\n  display: flex;\n  gap: var(--space-2);\n  justify-content: flex-end;\n}\n\n.logistics-page__drawer section {\n  display: grid;\n  gap: var(--space-2);\n  border-bottom: 1px solid var(--color-border);\n  padding-bottom: var(--space-4);\n}\n\n.logistics-page__drawer h3 {\n  margin: 0;\n  color: var(--color-foreground);\n  font-size: var(--font-size-lg);\n}\n\n@media (min-width: 760px) {\n  .logistics-page__header {\n    grid-template-columns: 1fr auto;\n    align-items: end;\n  }\n\n  .logistics-page__summary {\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 759px) {\n  .logistics-page__layout {\n    gap: var(--space-4);\n    padding-inline: var(--space-3);\n    padding-block: var(--space-3);\n  }\n\n  .logistics-page .dl-card {\n    border-radius: var(--radius-md, 8px);\n  }\n\n  .logistics-page .dl-card--standard {\n    padding: var(--space-3);\n  }\n\n  .logistics-page__route-stop {\n    align-items: start;\n    grid-template-columns: auto auto minmax(0, 1fr);\n    padding: var(--space-3);\n  }\n\n  .logistics-page__route-location {\n    min-width: 0;\n    overflow-wrap: anywhere;\n  }\n\n  .logistics-page__route-stop p {\n    grid-column: 1 / -1;\n    overflow-wrap: anywhere;\n  }\n\n  .logistics-page__route-stop-contact {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .logistics-page__group {\n    gap: var(--space-3);\n    padding: var(--space-3);\n  }\n\n  .logistics-page__group-actions {\n    align-items: stretch;\n    display: grid;\n    gap: var(--space-2);\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .logistics-page__group-actions > .dl-button,\n  .logistics-page__group-actions > .dl-icon-button,\n  .logistics-page__assign-controls,\n  .logistics-page__assign-controls > .dl-button {\n    min-width: 0;\n    width: 100%;\n  }\n\n  .logistics-page__assign-