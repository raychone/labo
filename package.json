{
  "name": "dental-lab-management",
  "version": "0.0.0",
  "private": true,
  "description": "Custom dental laboratory management application monorepo.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @dental-lab/web dev",
    "dev:api": "pnpm --filter @dental-lab/api start:dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
